# Writes build_info.h (OUTPUT) with the build's identity: the git commit, whether the working tree had uncommitted changes
# of tracked files, and the build configuration passed in by CMakeLists.txt (BUILD_TYPE, COMPILER, CXX_FLAGS,
# COMPILE_DEFINITIONS). Run at every build (cmake -P); the file is rewritten only when its content changes, so an
# unchanged identity recompiles nothing. The results JSON carries these values, so a result can be traced to its code.

find_package(Git QUIET)
set(commit "unknown")
set(dirty "unknown")
if(GIT_FOUND)
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD WORKING_DIRECTORY "${SOURCE_DIR}"
                    OUTPUT_VARIABLE out RESULT_VARIABLE rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(rc EQUAL 0)
        set(commit "${out}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no WORKING_DIRECTORY "${SOURCE_DIR}"
                        OUTPUT_VARIABLE status RESULT_VARIABLE rc2 ERROR_QUIET)
        if(rc2 EQUAL 0)
            if(status STREQUAL "")
                set(dirty "false")
            else()
                set(dirty "true")
            endif()
        endif()
    endif()
endif()

function(c_string out value)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(STRIP "${value}" value)
    set(${out} "${value}" PARENT_SCOPE)
endfunction()
c_string(flags "${CXX_FLAGS}")
c_string(definitions "${COMPILE_DEFINITIONS}")
c_string(compiler "${COMPILER}")

set(content "#pragma once
// generated by cmake/build_info.cmake at build time; do not edit
#define DMAPPER_GIT_COMMIT \"${commit}\"
#define DMAPPER_GIT_UNCOMMITTED_CHANGES \"${dirty}\"
#define DMAPPER_BUILD_TYPE \"${BUILD_TYPE}\"
#define DMAPPER_COMPILER \"${compiler}\"
#define DMAPPER_CXX_FLAGS \"${flags}\"
#define DMAPPER_COMPILE_DEFINITIONS \"${definitions}\"
")
set(old "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
