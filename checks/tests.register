  number: make_chain() :: c.windows.push_back(motion_window(t2, nodes, v1 * tau2 + 0.5 * a * tau2 * tau2, v1 + a * tau2, a))
  number: make_chain() :: c.t_previous_last = t1 + (nodes - 1) * dt
  number: make_chain() :: c.v_previous_end = v1 + a * (nodes - 1) * dt
