  loop: for (size_t k = 0; k < segments.size(); k++)
  assert: REQUIRE(steps.runs.empty())
  assert: REQUIRE(steps.information.size() + 1 == s.initial.size())
  assert: REQUIRE(solved.size() == reference.size())
  value: double largest = 0.0
  loop: for (size_t k = 0; k < solved.size(); k++)
  assert: CHECK(largest < 1e-9)
  assert: CHECK(loop_pose_graph_cost(s.initial, solved, loops, c, &steps.information) == doctest::Approx(loop_pose_graph_cost(s.initial, reference, loops, c)).epsilon(1e-9))

[case] tests/loop_closure_test.cpp :: loop closure match check: the chi-square quantile
  markers: -
  value: const double expected[6] = {10.828, 13.816, 16.266, 18.467, 20.515, 22.458}
  loop: for (int dof = 1; dof <= 6; dof++)
  assert: CHECK(chi_square_quantile(0.999, dof) == doctest::Approx(expected[dof - 1]).epsilon(5e-5))
  assert: CHECK(chi_square_quantile(0.5, 2) == doctest::Approx(2.0 * std::log(2.0)))
  assert: CHECK(chi_square_quantile(0.95, 1) == doctest::Approx(3.841459).epsilon(1e-6))
  assert: CHECK(std::isnan(chi_square_quantile(1.0, 6)))
  assert: CHECK(std::isnan(chi_square_quantile(0.999, 0)))

[case] tests/loop_closure_test.cpp :: loop closure match check: edges share scans in either role, the degrees of freedom are the information's rank
  markers: -
  number: e.i = 10
  number: e.j = 40
  assert: CHECK(loop_edges_share_scans(e, with(20, 40)))
  assert: CHECK(loop_edges_share_scans(e, with(12, 30)))
  assert: CHECK(loop_edges_share_scans(e, with(25, 11)))
  assert: CHECK(loop_edges_share_scans(e, with(39, 60)))
  assert: CHECK_FALSE(loop_edges_share_scans(e, with(13, 30)))
  assert: CHECK_FALSE(loop_edges_share_scans(e, with(38, 60)))
  assert: CHECK(loop_edge_dof(e) == 6)
  number: e.omega = Eigen::Matrix<double, 6, 6>::Identity() * 400.0
  assert: CHECK(loop_edge_dof(e) == 6)
  number: e.omega(2, 2) = 0.0
  assert: CHECK(loop_edge_dof(e) == 5)

[case] tests/loop_closure_test.cpp :: loop closure match check: an influential false edge inside the pruning limit is dropped, the true ones stay
  markers: -
  value: const OutAndBack g(40)
  loop: for (int i : {3, 13, 23, 33})
  number: loops.push_back(g.edge(i, 79 - i))
  number: loops.push_back(g.edge(8, 71, 2.0, 0.01))
  assert: REQUIRE(solve_and_prune_loop_pose_graph(g.initial, kept, c, &steps, logger, rep, optimized, residuals))
  assert: REQUIRE(kept.size() == 5)
  number: MESSAGE("false edge weighted residual ", residuals[4].weighted * c.loop_closure_edge_sigma_m, " m")
  assert: CHECK(loop_edge_drop_ratio(kept[4], residuals[4], c) < 1.0)
  assert: REQUIRE(solve_and_prune_loop_pose_graph(g.initial, kept, c, &steps, logger, rep, optimized, residuals))
  assert: REQUIRE(rep.dropped.size() == 1)
  assert: CHECK(rep.dropped[0].i == 8)
  assert: REQUIRE(rep.dropped_match_tests[0].has_value())
  value: const LoopMatchTest &t = *rep.dropped_match_tests[0]
  assert: CHECK(t.t > t.limit)
  assert: CHECK(t.dof == 6)
  assert: CHECK(t.held_out == 0)
  assert: CHECK(t.innovation_m == doctest::Approx(2.0).epsilon(0.05))
  assert: CHECK(kept.size() == 4)
  assert: REQUIRE(rep.kept_match_tests.size() == 4)
  assert: CHECK(k.t < 1.0)
  value: double largest = 0.0
  loop: for (size_t k = 0; k < optimized.size(); k++)
  assert: CHECK(largest < 1e-6)

