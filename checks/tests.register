[case] tests/window_capture_test.cpp :: window term csv: the prepared and handed-on state, every field written, absent ones empty
  markers: -
  call: features_lines_of(record)
  assert: REQUIRE(lines.size() == 2)
  value: const std::vector<std::string> names = csv_fields(lines[0]), values = csv_fields(lines[1])
  assert: REQUIRE(values.size() == names.size())
  assert: REQUIRE_MESSAGE(it != names.end(), name)
  value: const auto near = [&](const std::string &name, double expected) {...}
  assert: REQUIRE_FALSE(v.empty())
  assert: CHECK(std::stod(v) == doctest::Approx(expected).epsilon(1e-8))
  value: const auto retired = [](const std::string &name) {...}
  assert: CHECK(values[k].empty() == retired(names[k]))
  assert: CHECK(at("handoff") == "done")
  assert: CHECK(at("move_start_velocity_reason") == "measured")
  assert: CHECK(at("move_joint_reason") == "absent")
  value: const std::vector<std::string> c = csv_fields(features_lines_of(cancelled)[1])
  call: features_lines_of(cancelled)
  assert: REQUIRE(c.size() == names.size())
  assert: CHECK(c[k] == "cancelled")
  assert: CHECK(c[k].empty())
  assert: CHECK(c[k] == values[k])
  value: const std::vector<std::string> p = csv_fields(features_lines_of(partial)[1])
  call: features_lines_of(partial)
  assert: REQUIRE(p.size() == names.size())
  value: const bool gone = retired(names[k]) || names[k].rfind("prepared_offset_prior_sigma_", 0) == 0 || names[k].rfind("prepared_velocity_offset_cov_", 0) == 0 || names[k] == "handed_to_mps2_before_fold" || names[k] == "handed_last_time_s" || names[k].rfind("handed_last_", 0) == 0 && names[k].rfind("handed_last_solved", 0) != 0 || names[k] == "rotation_rate_mean_deg_s"
  assert: CHECK(p[k].empty() == gone)

