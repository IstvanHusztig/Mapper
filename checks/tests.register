[case] tests/loop_closure_test.cpp :: loop closure revisits: the tries are the nearest and the longest-path ones, each with a second one at least 3 segments away
  markers: -
  number: c.loop_closure_min_path_m = 8.0
  number: c.loop_closure_radius_per_path = 0.5
  number: c.loop_closure_search_radius_m = 8.0
  number: c.loop_closure_max_vertical_offset_m = 1.5
  number: c.loop_closure_candidates = 4
  value: const std::vector<double> distance = {3.0, 2.9, 2.0, 1.0, 1.5, 0.5, 0.4, 0.6}
  loop: for (size_t k = 0; k < distance.size(); k++)
  number: segments.push_back(segment_at(distance[k], 0.0, 10.0 * static_cast<double>(k), 10.0 * static_cast<double>(k)))
  number: segments.push_back(segment_at(0.0, 0.0, 100.0, 104.0))
  value: const std::vector<RevisitTry> tries = revisit_tries(segments, 8, c)
  assert: REQUIRE(tries.size() == 3)
  assert: CHECK((tries[0].i == 6 && tries[0].near && !tries[0].far))
  assert: CHECK((tries[1].i == 0 && !tries[1].near && tries[1].far))
  assert: CHECK((tries[2].i == 3 && tries[2].near && tries[2].far))
  number: c.loop_closure_candidates = 2
  value: const std::vector<RevisitTry> two = revisit_tries(segments, 8, c)
  assert: REQUIRE(two.size() == 2)
  assert: CHECK(two[0].i == 6)
  assert: CHECK(two[1].i == 0)

[case] tests/loop_closure_test.cpp :: loop closure revisits: two slots keep the best near and the best far edge when their sources are apart, else the best one
  markers: -
  number: [accepted] a.edge.j = 8
  value: const std::vector<AcceptedRevisit> three = {accepted(6, 0.8, true, false), accepted(3, 0.7, true, true), accepted(0, 0.6, false, true)}
  assert: CHECK(sources(revisit_slots(three, 1)) == std::vector<int>{6})
  assert: CHECK(sources(revisit_slots(three, 2)) == std::vector<int>{6, 3})
  value: const std::vector<AcceptedRevisit> one_best = {accepted(6, 0.6, true, false), accepted(3, 0.9, true, true), accepted(0, 0.5, false, true)}
  assert: CHECK(sources(revisit_slots(one_best, 2)) == std::vector<int>{3})
  value: const std::vector<AcceptedRevisit> close = {accepted(5, 0.7, true, false), accepted(3, 0.8, false, true)}
  assert: CHECK(sources(revisit_slots(close, 2)) == std::vector<int>{3})
  assert: CHECK(sources(revisit_slots({accepted(0, 0.6, false, true)}, 2)) == std::vector<int>{0})
  assert: CHECK(revisit_slots({}, 2).empty())

[case] tests/loop_closure_test.cpp :: loop closure drop order: leave one out drops the false edge, not the strained right one
  markers: -
  number: c.loop_closure_odometry_sigma_m = 0.1
  number: c.loop_closure_odometry_sigma_deg = 0.5
  number: c.loop_closure_edge_sigma_m = 0.05
  number: c.loop_closure_edge_sigma_deg = 0.3
  number: c.loop_closure_max_residual_m = 0.15
  number: c.loop_closure_max_residual_deg = 2.0
  loop: for (int k = 0; k < 14; k++)
  number: truth.push_back(pose(Eigen::Vector3d(6.0 * k, 0.0, 0.0), 0.0))
  number: initial.push_back(k <= 6 ? truth[k] : truth[6] * pose(Eigen::Vector3d::Zero(), 1.5 * deg) * pose(Eigen::Vector3d(6.0 * (k - 6), 0.0, 0.0), 0.0))
  value: const std::vector<LoopClosureEdge> loops = {edge(0, 6, 0.0), edge(7, 13, 0.0), edge(5, 9, 0.0), edge(4, 9, 0.0), edge(0, 13, 4.0)}
  value: double largest = 1.0
  loop: for (size_t e = 0; e < loops.size(); e++)
  value: int beyond = 0
  loop: for (size_t e = 0; e < loops.size(); e++)
  number: beyond += loop_edge_drop_ratio(loops[e], r[e], c) > 1.0 ? 1 : 0
  assert: REQUIRE(beyond >= 2)
  assert: CHECK(worst_ratio != 4)
  assert: CHECK(left_out == 4)

[case] tests/loop_closure_test.cpp :: loop closure pose graph: a loop edge removes the drift and the result is plausible
  markers: -
  loop: for (int k = 0; k < 8; k++)
  value: const double x = k < 4 ? k * 2.0 : (7 - k) * 2.0
  value: const double y = k < 4 ? 0.0 : 3.0
  number: truth.push_back(segment_pose(x, y, k < 4 ? 0.0 : 180.0))
  number: initial.push_back(segment_pose(x, y + 0.05 * k, k < 4 ? 0.0 : 180.0))
  number: e.i = 0
  number: e.j = 7
  number: e.correction = (initial[0] * truth[0].inverse() * truth[7]) * initial[7].inverse()
  assert: REQUIRE(optimized.size() == initial.size())
  value: const double before = (initial[7].translation() - truth[7].translation()).norm()
  value: const double after = (optimized[7].translation() - truth[7].translation()).norm()
  assert: CHECK(after < 0.2 * before)
  value: double max_shift = 0.0
  assert: CHECK(loop_pose_graph_plausible(initial, optimized, loops, c, max_shift))
  assert: CHECK(max_shift < 0.5)

[case] tests/loop_closure_test.cpp :: loop closure pose graph: a result that ran away or is not finite is refused
  markers: -
  number: c.loop_closure_max_correction_m = 6.0
  value: const std::vector<Eigen::Affine3d> initial{segment_pose(0, 0, 0), segment_pose(2, 0, 0), segment_pose(4, 0, 0)}
  number: e.i = 0
  number: e.j = 2
  number: e.correction = segment_pose(0.5, 0, 0)
  value: double max_shift = 0.0
  number: moved[2].translation().x() += 1.0
  assert: CHECK(loop_pose_graph_plausible(initial, moved, loops, c, max_shift))
  assert: CHECK(max_shift == doctest::Approx(1.0))
  number: ran_away[2].translation().x() += 2.2e6
  assert: CHECK_FALSE(loop_pose_graph_plausible(initial, ran_away, loops, c, max_shift))
  number: broken[1].translation().y() = std::numeric_limits<double>::quiet_NaN()
  assert: CHECK_FALSE(loop_pose_graph_plausible(initial, broken, loops, c, max_shift))

