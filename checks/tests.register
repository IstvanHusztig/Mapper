  number: brute_profile() :: d = np.r_[0.0, grid[list(path)], 0.0]
  number: brute_profile() :: cost = sum((E[w, k] for w, k in enumerate(path))) + coupling * float(np.sum(np.diff(d) ** 2))
  number: brute_profile() :: if cost < best - 1e-12
  number: profile_cost() :: d = np.r_[0.0, grid[path], 0.0]
  number: profile_cost() :: return sum((E[w, k] for w, k in enumerate(path))) + coupling * float(np.sum(np.diff(d) ** 2))
  default: corridor() :: defaults of corridor(jambs=(3.0, 6.5, 9.0, 13.0, 17.0), error=None, folder=None, run=(13, 27))
  number: corridor() :: g = np.arange(0.0, 2.4, 0.06)
  number: corridor() :: xs = np.arange(-2.0, 22.0, 0.06)
  number: corridor() :: scene = [np.column_stack([xx.ravel(), np.full(xx.size, s), zz.ravel()]) for s in (-1.0, 1.0)]
  loop: corridor() :: for y0 in (-1.0, 0.4)
  number: corridor() :: yy, z2 = np.meshgrid(np.arange(y0, y0 + 0.6001, 0.06), g)
  number: corridor() :: W, per = (100, 4)
  number: corridor() :: node_t = np.array([(w * 0.4 if w < 50 else 40.0 + (w - 50) * 0.4) + m * 0.1 for w in range(W) for m in range(per)])
  number: corridor() :: truth = np.zeros((W * per, 3))
  number: corridor() :: truth[:, 0] = np.where(node_t <= 20.0, node_t, 20.0 - (node_t - 40.0))
  number: corridor() :: truth[:, 2] = 1.2
  number: corridor() :: first = np.arange(0, W * per + 1, per)
  number: corridor() :: P0 = np.tile(np.eye(4), (W * per, 1, 1))
  number: corridor() :: P0[:, :3, 3] = truth
  number: corridor() :: P1[:, 0, 3] += np.array([error(t) for t in node_t])
  number: corridor() :: n = first[w] + 1
  number: corridor() :: vis = scene[np.abs(scene[:, 0] - truth[n, 0]) <= 4.0]
  number: corridor() :: arr['node'] = 1
  loop: corridor() :: for k in range(0, W, 6)
  number: corridor() :: last = min(W, k + 6) - 1
  number: corridor() :: segs.append(dict(first=k, last=last, pose=P0[first[k]].copy(), center=truth[first[k]], path_begin=0.0, path_end=0.0, t_begin=node_t[first[k]], t_end=node_t[first[last + 1] - 1]))
  number: corridor() :: rd = dict(W=W, present=np.ones(W, bool), dur=np.full(W, 0.4), ratio=np.full(W, 0.5), rest=np.zeros(W, bool), weak=np.tile(X, (W, 1)), move=np.tile(0.4 * X, (W, 1)), t=node_t[first[:-1]])
  number: corridor() :: rd['ratio'][run[0]:run[1] + 1] = 0.01
  number: corridor() :: rd['move'][run[0]:run[1] + 1] = 0.2 * X
  number: corridor() :: tr = wp.Trajectory('after', np.rint(node_t * 1000000000.0).astype(np.int64), P1[:, :3, :3], P1[:, :3, 3])
  number: bump() :: return 1.2 * max(0.0, 1.0 - abs(t - 8.2) / 3.0)
  number: straight_corridor() :: data.P0[:, 0, 3] += np.array([odometry_error(t) for t in data.cap.node_t])
  default: gap_error() :: defaults of gap_error(total, first_half=True)
  number: gap_error() :: lo = T_A if first_half else (T_A + T_B) / 2
  number: gap_error() :: return total * float(np.clip((t - lo) / (T_B - lo), 0.0, 1.0))
  default: seen_windows_off() :: defaults of seen_windows_off(bump_total=0.0)
  number: seen_windows_off() :: if 2.8 <= t < 7.2 or 13.2 <= t < 13.6
  number: seen_windows_off() :: return 0.5
  number: seen_windows_off() :: if 7.2 <= t < 13.1
  number: seen_windows_off() :: return bump_total * max(0.0, 1.0 - abs(t - (T_A + T_B) / 2) / 3.0)
  number: seen_windows_off() :: return 0.0
  number: moved_correction() :: P[:, :3, 3] += shift

