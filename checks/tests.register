[case] tests/accelerometer_noise_test.cpp :: accelerometer noise: (a) the sample-aligned fixture, disjoint supports, unit variance and no covariance
  markers: -
  value: constexpr double span = 0.0115
  value: const double tau0 = 0.012
  value: const double D = std::sqrt(0.0013 * 0.0013 + 0.1 * 0.1 * tau0)
  value: const auto nw = make_noise_windows(D, span, 60.0, 11)
  assert: REQUIRE(nw->windows.size() > 100)
  value: const TermWindow &tw = *nw->windows[0]
  assert: REQUIRE(tw.noise.unknowns.anchors[j] - tw.noise.unknowns.anchors[j - 1] == 6)
  assert: CHECK(overlaps == 0)
  assert: CHECK(fractional == 0)
  assert: CHECK(noise_covariance(tw, 0, 0, D) == doctest::Approx(1.0).epsilon(1e-9))
  value: const double alpha = 0.01 / 3.0
  value: const double df = 3.0 * k.terms
  assert: CHECK(inside(k.sum_z2_over_e, df, alpha))
  assert: CHECK(std::abs(k.sum_z / df) <= 3.3 * std::sqrt(k.analytic / k.terms / 3.0) / std::sqrt(df))
  assert: CHECK(inside(triple.sum_z2, 3.0 * triple.terms, alpha))
  assert: CHECK(std::abs(p.rho_analytic()) < 1e-12)
  assert: CHECK(std::abs(p.rho()) <= 3.3 / std::sqrt(static_cast<double>(p.n)))

[case] tests/accelerometer_noise_test.cpp :: accelerometer noise: (b) the Livox timing, the size of the approximation (measurement)
  markers: -
  value: const auto nw = make_noise_windows(0.01056, 0.01, 60.0, 12)
  assert: REQUIRE(nw->windows.size() > 100)
  value: const double alpha = 0.01 / 3.0
  assert: CHECK(inside(k.sum_z2_over_e, 3.0 * k.terms, alpha))
  assert: CHECK(std::abs(p.rho() - p.rho_analytic()) <= 3.3 / std::sqrt(static_cast<double>(p.n)))

