[case] tests/gui_view_model_test.cpp :: gui view-model: default settings, and their source
  markers: -
  assert: CHECK(model.active_parameters() == "built-in defaults")
  assert: [a missing default file keeps the built-in defaults] CHECK(model.active_parameters() == "built-in defaults")
  assert: [a missing default file keeps the built-in defaults] CHECK_FALSE(model.config().use_loop_closure)
  assert: [a default file is loaded and named] CHECK(model.active_parameters() == file.string())
  assert: [a default file is loaded and named] CHECK(model.config().use_loop_closure)
  assert: [a default file is loaded and named] CHECK(model.config().threshold_nr_poses == 360)

[case] tests/gui_view_model_test.cpp :: gui view-model: Load parameters
  markers: -
  assert: REQUIRE(model.load_parameters(file))
  assert: CHECK(model.active_parameters() == file)
  assert: CHECK(model.config().use_consistency)
  assert: CHECK_FALSE(model.load_parameters((repo_dir / "tests" / "data" / "no_such_settings.toml").string()))
