[case] tests/test_verification_tools.py :: RunHealthLimitsTests.test_the_rows_follow_the_limits_of_the_logs_line
  markers: -
  number: plants = dict(bends={20: 2.5, 77: -7.0}, speeds={120: 1.8}, biases={150: 0.35}, chi2=chi2_values(4.6, 16.0))
  assert: self.assertEqual(rows['limits'][0], "from the run's log")
  assert: self.assertEqual(r['limits'], {'bend_deg': 2.0, 'severe_bend_deg': 6.0, 'speed_mps': 1.5, 'bias_deg_s': 0.3, 'bent_share': 0.05, 'chi2_median': 4.0, 'chi2_p95': 15.0, 'weak_ratio': 0.5})
  assert: self.assertEqual(rows['windows bent > 2 deg against the gyro'], ('2 (1.0 %)', '<= 5 %', 'CLEAR'))
  assert: self.assertEqual(rows['windows bent > 6 deg'], ('1', '0', 'TRIGGER'))
  assert: self.assertEqual(rows['windows faster than 1.5 m/s'], ('1 (max 1.80 m/s)', '0', 'TRIGGER'))
  assert: self.assertEqual(rows['largest gyro bias estimate x / y / z'], ('0.35 / 0.05 / 0.02 deg/s', '<= 0.3', 'TRIGGER'))
  assert: self.assertEqual(rows['chi2 of the velocity jump, median / p95'], ('5 / 16 (41 windows)', '<= 4 / 15', 'TRIGGER'))
  assert: self.assertNotIn('windows bent > 3 deg against the gyro', rows)
  assert: self.assertEqual(r['uncertainty_missing'], [5])
  assert: self.assertEqual(r['uncertainty_missing'], [])

[case] tests/test_verification_tools.py :: RunHealthLimitsTests.test_a_command_line_option_beats_the_logs_line_and_is_named
  markers: -
  number: _, rows = self.rows(LIMITS_LINE_OTHER + known_log(speeds={120: 1.8}), '--max-speed', '2.0')
  assert: self.assertEqual(rows['limits'][0], 'command line: --max-speed')
  assert: self.assertIn("the others from the run's log", rows['limits'][1])
  assert: self.assertIn('speed 2 m/s', rows['limits'][1])
  assert: self.assertEqual(rows['windows faster than 2 m/s'], ('0 (max 1.80 m/s)', '0', 'CLEAR'))
  assert: self.assertEqual(rows['largest gyro bias estimate x / y / z'][1], '<= 0.3')
  number: _, rows = self.rows(LIMITS_LINE_OTHER + known_log(speeds={120: 1.8}), '--max-speed', '2.5')
  assert: self.assertEqual(rows['limits'][0], 'command line: --max-speed')
  assert: self.assertEqual(rows['windows faster than 2.5 m/s'][2], 'CLEAR')
  assert: self.assertEqual(rows['limits'][0], 'command line: --max-bias, --max-chi2')
  assert: self.assertIn('the others defaults (the log has no limits line)', rows['limits'][1])

