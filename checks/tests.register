[case] tests/disk_point_store_test.cpp :: DiskPointStore keeps each point set under today's cache file names
  markers: -
  assert: CHECK(store.location() == folder.string())
  assert: REQUIRE(store.save(sets[k], 7, sample_points(k + 1)))
  assert: CHECK(fs::is_regular_file(folder / "original_points_7.cache"))
  assert: CHECK(fs::is_regular_file(folder / "intermediate_points_7.cache"))
  assert: CHECK(fs::is_regular_file(folder / "session_chunk_7.cache"))
  assert: REQUIRE(store.load(sets[k], 7, loaded))
  assert: CHECK(same(loaded, sample_points(k + 1)))
  assert: CHECK_FALSE(store.load(PointSet::WindowOriginal, 8, missing))
  assert: CHECK_FALSE(fs::exists(folder))

