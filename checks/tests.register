[case] tests/loop_closure_test.cpp :: loop closure capture file: written and read back bit for bit; another file is refused
  markers: -
  assert: REQUIRE(write_loop_closure_capture(file, c, config, why))
  assert: REQUIRE(read_loop_closure_capture(file, back, settings, why))
  assert: CHECK(settings == settings_as_text(config))
  assert: REQUIRE(back.windows.size() == c.windows.size())
  assert: CHECK(same_bits(back.windows[w].poses, c.windows[w].poses))
  assert: REQUIRE(back.segments.size() == c.segments.size())
  assert: CHECK(back.segments[k].pose.matrix() == c.segments[k].pose.matrix())
  assert: CHECK(back.segments[k].center == c.segments[k].center)
  assert: CHECK(back.segments[k].t_end == c.segments[k].t_end)
  assert: CHECK(back.segments[k].path_end == c.segments[k].path_end)
  assert: CHECK(back.segments[k].last_window == c.segments[k].last_window)
  assert: REQUIRE(back.tries.size() == 2)
  value: const LoopClosureTry &b = back.tries[0].registration
  assert: CHECK(b.i == 2)
  assert: CHECK(b.j == 9)
  assert: CHECK(b.cross_floor)
  assert: CHECK(b.registered)
  assert: CHECK(b.overlap_before == t.registration.overlap_before)
  assert: CHECK(b.correction.matrix() == t.registration.correction.matrix())
  assert: CHECK(b.information == t.registration.information)
  assert: CHECK(b.information_ratio == t.registration.information_ratio)
  assert: CHECK(b.centre == t.registration.centre)
  assert: REQUIRE(b.window_information.size() == 3)
  assert: CHECK(b.window_information[w] == t.registration.window_information[w])
  assert: CHECK(back.tries[1].registration.window_information.empty())
  assert: CHECK(back.tries[0].accepted)
  assert: CHECK(!back.tries[0].requested_by_run)
  assert: CHECK(!back.tries[1].registration.registered)
  assert: REQUIRE(back.result_poses.size() == c.result_poses.size())
  assert: CHECK(same_bits(back.result_poses.back(), c.result_poses.back()))
  assert: CHECK(back.loops == 3)
  assert: REQUIRE(a.has_value() == r.has_value())
  assert: CHECK(r->information_ratio == a->information_ratio)
  assert: CHECK(r->weak_axis == a->weak_axis)
  assert: CHECK(r->at_rest == a->at_rest)
  assert: CHECK(r->placed_move == a->placed_move)
  assert: CHECK(r->duration_s == a->duration_s)
  value: const size_t blocks_bytes = 8 + (8 + 3 * 9 * 8) + 8
  value: const auto older = [&](size_t cut, std::uint32_t version) {...}
  assert: REQUIRE(bytes.size() > cut + 12)
  assert: REQUIRE(read_loop_closure_capture(file, back, settings, why))
  assert: CHECK(back.loops == 3)
  assert: REQUIRE(back.tries.size() == 2)
  assert: CHECK(back.tries[0].registration.information == t.registration.information)
  assert: CHECK(back.tries[0].registration.window_information.empty())
  assert: CHECK(back.windows[w].readings.has_value() == c.windows[w].readings.has_value())
  assert: REQUIRE(read_loop_closure_capture(file, back, settings, why))
  assert: CHECK(back.loops == 3)
  assert: CHECK_FALSE(w.readings.has_value())
  assert: REQUIRE(write_loop_closure_capture(file, c, config, why))
  value: const std::uint64_t wrong = 3
  assert: CHECK(!read_loop_closure_capture(file, back, settings, why))
  assert: CHECK(!read_loop_closure_capture(file, back, settings, why))

