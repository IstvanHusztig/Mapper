[case] tests/test_verification_tools.py :: VerificationTests.test_strict_seams
  markers: -
  number: ref = [(t, 0.0, 0.0, 0.0), (t + 1, 1.0, 0.0, 0.0)]
  loop: for bad in (ref[:1], [(t + 1, 0.0, 0.0, 0.0), (t + 2, 1.0, 0.0, 0.0)], [ref[0], ref[0]], [(t, math.nan, 0.0, 0.0), ref[1]])
  assert: self.assertRaises(ValueError)
  guarded: seams.compare(ref, bad, [0.05])
  number: res = [(r[0], r[1] + 0.2, r[2], r[3]) for r in ref]
  number: result = seams.compare(ref, res, [0.05])
  assert: self.assertAlmostEqual(result['max_diff_m'], 0.2)
  assert: self.assertAlmostEqual(result['seconds_above_005'], 1e-09)

