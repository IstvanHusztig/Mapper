[case] tests/unit_cases_ndt_test.cpp :: unit case K7: the fractional projection's own step along the weak axis
  markers: -
  value: const double k = 50.0
  value: const double g = 0.2
  value: const double step = e.rhs(2, 0) / e.matrix(2, 2)
  assert: CHECK(e.matrix(0, 0) == doctest::Approx(100.0 * k).epsilon(1e-12))
  assert: CHECK(e.matrix(3, 3) == doctest::Approx(10.0 * k).epsilon(1e-12))
  assert: CHECK(e.matrix(2, 2) == doctest::Approx(s * s * k).epsilon(1e-9))
  assert: CHECK(e.rhs(2, 0) == doctest::Approx(s * g).epsilon(1e-9))
  assert: CHECK(step == doctest::Approx(unprojected / s).epsilon(1e-9))
  assert: CHECK(step_at_half / (g / k) == doctest::Approx(2.0).epsilon(1e-9))

