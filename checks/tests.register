  number: initial[1].translation() = Eigen::Vector3d(offset + 5.0, 0.0, 0.0)
  number: turn.translate(initial[1].translation())
  number: turn.rotate(Eigen::AngleAxisd(2.0 * M_PI / 180.0, Eigen::Vector3d::UnitZ()))
  number: turn.translate(-initial[1].translation())
  number: e.i = 0
  number: e.j = 1
  number: optimized[1] = turn * initial[1]
  value: double max_shift_m = -1.0
  assert: CHECK(loop_pose_graph_plausible(initial, optimized, {e}, params, max_shift_m))
  assert: CHECK(max_shift_m < 1e-9)

[case] tests/loop_closure_test.cpp :: loop closure replay settings: odometry and registration settings are refused by name, rules are changes, diagnostics don't count
