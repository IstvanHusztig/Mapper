[case] tests/scan_to_map_test.cpp :: scan-to-map fixtures: scene points on the faces, maps filled, points per node in range
  markers: -
  value: double farthest = 0.0
  value: double nearest = 1e9
  assert: CHECK(farthest <= 0.01)
  assert: CHECK(maps.indoor.size() > 1000)
  assert: CHECK(maps.outdoor.size() > 100)
  value: std::vector<int> in_range(n_nodes, 0)
  assert: CHECK(*std::min_element(in_range.begin(), in_range.end()) >= 40)
  assert: CHECK(*std::max_element(in_range.begin(), in_range.end()) <= 80)

[case] tests/scan_to_map_test.cpp :: scan-to-map: a perfect guess stays at the truth
  markers: -
  value: const double delta = run_iterations(points, w, maps, o, 5.0, 30, logger)
  number: MESSAGE("perfect guess after 30 iterations: position ", e.position * 1000.0, " mm, rotation ", e.rotation / deg, " deg, delta ", delta)
  assert: CHECK(e.position < 0.001)
  assert: CHECK(e.rotation < 0.1 * deg)
  assert: CHECK(delta < 1e-6)

[case] tests/scan_to_map_test.cpp :: scan-to-map: where a plane lies in its cell
  markers: -
  value: const Case cases[] = { {"at grid_offset (no face on a boundary)", grid_offset, 0.001}, {"floor and ceiling on 0.15 m boundaries", {g, g, 0.0}, 0.001}, {"x walls on 0.4 m boundaries", {0.0, g, g}, 0.002}, {"at the world origin (both)", Eigen::Vector3d::Zero(), 0.003}, }
  number: run_iterations(points, w, maps, o, 5.0, 30, logger)
  number: MESSAGE("perfect guess, room ", c.name, ": position ", e.position * 1000.0, " mm, rotation ", e.rotation / deg, " deg")
  assert: CHECK(e.position < c.limit_m)
  assert: CHECK(e.rotation < 0.1 * deg)

[case] tests/scan_to_map_test.cpp :: scan-to-map: a node 1 m or more from its guess is a big jump, counted before anything is applied
  markers: -
  value: std::vector<double> step(w.poses.size() * 6 + 3, 0.0)
  number: step[0] = 0.2
  value: const SteppedPoses small = stepped_poses(w, step, 1.0, logger)
  assert: CHECK(small.big_jump_nodes == 0)
  assert: REQUIRE(small.poses.size() == w.poses.size())
  assert: CHECK(std::abs(small.poses[0].px - (pose_tait_bryan_from_affine_matrix(w.poses[0]).px + 0.2)) < 1e-12)
  number: step[6 * (w.poses.size() - 1) + 1] = 1.2
  value: const SteppedPoses big = stepped_poses(w, step, 1.0, logger)
  assert: CHECK(big.big_jump_nodes == 1)

[case] tests/scan_to_map_test.cpp :: scan-to-map: the damping grows every 10 iterations and at once after a step that was not applied
  markers: -
  assert: CHECK(next_lm_factor(5.0, 0, true) == 5.0)
  assert: CHECK(next_lm_factor(5.0, 3, true) == 5.0)
  assert: CHECK(next_lm_factor(5.0, 10, true) == 50.0)
  assert: CHECK(next_lm_factor(5.0, 3, false) == 50.0)
  assert: CHECK(next_lm_factor(5.0, 10, false) == 500.0)

[case] tests/scan_to_map_test.cpp :: scan-to-map: a yaw drift is corrected
  markers: -
  value: const double bias = 0.5 * deg
  number: run_iterations(points, w, maps, o, 5.0, 30, logger)
  number: MESSAGE("yaw drift: end heading error ", heading_before / deg, " -> ", heading_after / deg, " deg; largest position error ", before.position * 1000.0, " -> ", after.position * 1000.0, " mm; largest rotation error ", before.rotation / deg, " -> ", after.rotation / deg, " deg")
  assert: CHECK(std::abs(heading_after) <= 0.1 * std::abs(heading_before))
  assert: CHECK(after.position < 0.0015)

[case] tests/scan_to_map_test.cpp :: scan-to-map: the gyro bias is estimated
  markers: -
  value: const double bias = 0.5 * deg
  number: run_iterations(points, w, maps, o, 5.0, 30, logger)
  number: MESSAGE("estimated bias ", b.x(), " ", b.y(), " ", b.z(), " deg/s (injected 0 0 0.5); end heading error ", end_heading_error(w.poses, truth) / deg, " deg; largest position error ", after.position * 1000.0, " mm")
  assert: CHECK(std::abs(b.z() - 0.5) < 0.075)
  assert: CHECK(std::abs(b.x()) < 0.05)
  assert: CHECK(std::abs(b.y()) < 0.05)

[case] tests/scan_to_map_test.cpp :: scan-to-map: a gyro bias carried from window to window is removed once
  markers: -
  number: c.gyro_bias_rw_deg_s_sqrt_s = 0.005
  value: const double bias = 2.0 * deg
  value: constexpr int n_windows = 6
  loop: for (int j = 0; j < n_windows; j++)
  loop: for (int k = 0; k < n_nodes; k++)
  number: truth.push_back(pose(Eigen::Vector3d(-1.0 + 1.0 * t, 0.0, 1.5) + grid_offset, 20.0 * deg * t))
  number: run_iterations(points, w, maps, o, 5.0, 30, logger)
  number: MESSAGE("chained bias estimates (z, deg/s, injected 2.0): ", estimates[0], " ", estimates[1], " ", estimates[2], " ", estimates[3], " ", estimates[4], " ", estimates[5], "; last window x ", b.x(), " y ", b.y())
  assert: CHECK(std::abs(b.z() - 2.0) < 0.1)
  assert: CHECK(std::abs(b.x()) < 0.05)
  assert: CHECK(std::abs(b.y()) < 0.05)

[case] tests/scan_to_map_test.cpp :: scan-to-map: iterations needed
  markers: -
  loop: for (const bool estimate_bias : {false, true})
  value: Window w = make_window(drifting_guess(truth, 0.5 * deg))
  value: constexpr int iterations = 100
  number: run_iterations(points, w, maps, o, 5.0, iterations, logger, nullptr, [&](const IterationResult &r, const Window &window) {...})
  loop: for (int i = iterations - 1; i >= 0; i--)
  number: if (e.position > 1e-4 || e.rotation > 0.001 * deg)
  number: n_final = i + 1
  value: int n_fast = 0
  loop: for (int i = 0; i < iterations; i++)
  number: if (deltas[i] < 1e-2)
  number: n_fast = i + 1
  value: const PoseError at_fast = n_fast > 0 ? max_error(poses_after[n_fast - 1], truth) : PoseError{}
  number: MESSAGE(std::string(estimate_bias ? "with" : "without"), " bias estimation: N_final ", n_final, ", N_fast ", n_fast, "; error vs truth at N_fast ", at_fast.position * 1000.0, " mm / ", at_fast.rotation / deg, " deg, after ", iterations, " ", at_final.position * 1000.0, " mm / ", at_final.rotation / deg, " deg; ", ms_per_iteration, " ms per iteration")
  assert: CHECK(n_final < iterations)

