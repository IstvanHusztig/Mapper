  assert: self.assertEqual(c['lag-1 autocorr d_y'], '- (5 pairs)')
  assert: self.assertEqual(c['lag-1 autocorr |d|'], f'{188 / 364:.4g} (5 pairs)')
  assert: self.assertEqual(c['median |d| at rest'], '1 (n 2)')
  assert: self.assertEqual(c['median |d| moving'], '3 (n 5)')
