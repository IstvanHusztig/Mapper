[case] tests/window_capture_test.cpp :: window capture: the capture leaves the run unchanged, and a replay with the same settings repeats it bit for bit
  markers: -
  value: const Recording r = loop_recording(1)
  call: run(r, c, nullptr)
  number: c.capture_windows_from_s = 5.0
  number: c.capture_windows_to_s = 12.0
  call: run(r, c, &sink)
  assert: REQUIRE(sink.written)
  number: MESSAGE("windows ", capture.first + 1, " to ", capture.last + 1, " of ", capture.n_windows, " captured")
  assert: CHECK(capture.first == 5)
  assert: CHECK(capture.last == 12)
  assert: REQUIRE(capture.outcomes.size() == capture.last - capture.first + 1)
  loop: for (size_t i = 0; i < plain.size(); i++)
  assert: CHECK(same_poses(plain[i].poses, captured_run[i].poses))
  loop: for (size_t k = 0; k < capture.outcomes.size(); k++)
  assert: CHECK(same_poses(capture.outcomes[k].poses, captured_run[capture.first + k].poses))
  assert: REQUIRE(write_window_capture(file, capture, c, why))
  value: std::uint64_t hash = 0
  assert: REQUIRE(read_window_capture(file, read, hash, why))
  assert: CHECK(hash == odometry_settings_hash(c))
  assert: CHECK_FALSE(same.cancelled)
  assert: CHECK(same.identical == capture.outcomes.size())
  assert: CHECK(same.largest_position_difference_m == 0.0)
  number: fewer.nr_iter = 1
  assert: CHECK_FALSE(other.cancelled)
  assert: CHECK(other.outcomes.size() == capture.outcomes.size())
  assert: CHECK(other.identical < capture.outcomes.size())
  number: MESSAGE("replay with 1 iteration instead of 5: largest difference ", other.largest_position_difference_m * 1000.0, " mm")

[case] tests/window_capture_test.cpp :: window capture: the range is the windows that start within it
  markers: -
  value: std::vector<Window> windows(5)
  loop: for (size_t i = 0; i < windows.size(); i++)
  number: windows[i].timestamps = {{100.0 + 2.0 * i, 0.0}}
  value: std::size_t first = 0, last = 0
  assert: CHECK(capture_range(windows, 1.0, 5.0, first, last))
  assert: CHECK(first == 1)
  assert: CHECK(last == 2)
  assert: CHECK(capture_range(windows, 0.0, 100.0, first, last))
  assert: CHECK((first == 0 && last == 4))
  assert: CHECK_FALSE(capture_range(windows, 4.5, 5.5, first, last))
  assert: CHECK_FALSE(capture_range(windows, -1.0, -1.0, first, last))
  assert: CHECK_FALSE(capture_range(windows, 3.0, 2.0, first, last))

[case] tests/window_capture_test.cpp :: window term table: the run is the same with log_window_terms on, every window gets its tables, and the files hold them
  markers: -
  value: const Recording r = loop_recording(1)
  call: run(r, c, nullptr)
  assert: CHECK(odometry_settings_hash(with_terms) == odometry_settings_hash(c))
  call: run(r, with_terms, nullptr, &sink)
  loop: for (size_t i = 0; i < plain.size(); i++)
  assert: CHECK(same_poses(plain[i].poses, logged[i].poses))
  assert: REQUIRE(sink.records.size() == plain.size())
  value: size_t rows = 0
  assert: CHECK(record.guess.failure.empty())
  assert: CHECK(record.result.failure.empty())
  assert: CHECK_FALSE(record.result.rows.empty())
  assert: CHECK(record.result.rows.back().name == "damping")
  loop: for (size_t i = 0; i < sink.records.size(); i++)
  assert: CHECK(record.window == static_cast<int>(i) + 1)
  assert: CHECK(record.handoff == WindowHandOff::done)
  assert: REQUIRE(record.prepared.first_pose.has_value())
  assert: REQUIRE(record.handed_on.last_node_solved.has_value())
  assert: REQUIRE(record.handed_on.last_node_handed_on.has_value())
  assert: CHECK(record.handed_on.last_node_handed_on->time_s == record.handed_on.last_node_solved->time_s)
  assert: CHECK(record.handed_on.last_node_handed_on->pose.matrix() == logged[i].poses.back().matrix())
  assert: CHECK(record.rotation_rate_rad_s.has_value())
  assert: CHECK_FALSE(record.prepared.velocity_prior_mean.has_value())
  assert: CHECK_FALSE(record.handed_on.velocity_end.has_value())
  number: if (i > 0)
  value: const Eigen::Affine3d expected = sink.records[i - 1].handed_on.last_node_handed_on->pose * r.windows[i].imu_motion_from_previous
  assert: CHECK((record.prepared.first_pose->translation() - expected.translation()).norm() < 1.0)
  assert: CHECK(files.ok())
  number: [columns] return std::count(line.begin(), line.end(), ',') + 1
  assert: REQUIRE(terms.size() == 1 + rows)
  assert: REQUIRE(features.size() == 1 + sink.records.size())
  assert: CHECK(terms[0].rfind("window,time_s,state,term,in_total,cost,residuals,weight_shift_along", 0) == 0)
  assert: CHECK(columns(terms[0]) == 7 + 2 * 12)
  assert: CHECK(columns(terms[1]) == columns(terms[0]))
  assert: CHECK(columns(features[1]) == columns(features[0]))
  assert: CHECK(features[0].find("change_turn_vertical") != std::string::npos)

