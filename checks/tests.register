  assert: CHECK(plain[i].gyro.z() == static_cast<float>(gyro[i][2]))
  assert: CHECK(scaled[i].gyro.x() == plain[i].gyro.x())
  assert: CHECK(scaled[i].gyro.y() == plain[i].gyro.y())
  assert: CHECK(scaled[i].gyro.z() == static_cast<float>(gyro[i][2] * 1.004))
  assert: CHECK(scaled[i].acc == plain[i].acc)
  assert: CHECK(scaled[i].timestamps == plain[i].timestamps)

