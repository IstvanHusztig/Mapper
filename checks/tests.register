[case] tests/loop_closure_test.cpp :: loop closure information edges: a shaft ties the floors horizontally and in tilt, not in height or the turn about its axis
  markers: -
  value: const std::vector<Eigen::Affine3d> truth{segment_pose(0, 0, 0), segment_pose(2, 0, 0), segment_pose(4, 0, 0)}
  value: const std::vector<SurfacePoint> shaft = cylinder(4.0, 3.0, 1.5, -1.0, 1.5)
  value: const Eigen::Vector3d axis_point(4.0, 3.0, 0.0)
  value: const Eigen::Affine3d about_axis = Eigen::Translation3d(axis_point) * Eigen::AngleAxisd(5.0 * DEG_TO_RAD, Eigen::Vector3d::UnitZ()) * Eigen::Translation3d(-axis_point)
  assert: REQUIRE(ok)
  value: const Eigen::Matrix<double, 6, 1> sig = loop_edge_region_sigmas(initial[0], initial[2], e, axis_point)
  assert: CHECK(sig(0) < 0.1)
  assert: CHECK(sig(1) < 0.1)
  assert: CHECK(sig(2) > 10.0)
  assert: CHECK(sig(5) > 90.0)
  assert: CHECK(sig(3) < 10.0)
  assert: CHECK(sig(4) < 10.0)
  assert: REQUIRE(p.size() == 3)
  value: const Eigen::Vector3d axis_in_2 = initial[2] * (truth[2].inverse() * axis_point)
  value: const double gap_before = (axis_in_2 - axis_point).head<2>().norm()
  value: const double gap_after = ((p[2] * (initial[2].inverse() * axis_in_2)) - p[0] * (initial[0].inverse() * axis_point)).head<2>().norm()
  value: const double pitch_before = relative_angle_about(initial[0], initial[2], Eigen::Vector3d::UnitY())
  value: const double pitch_after = relative_angle_about(p[0], p[2], Eigen::Vector3d::UnitY())
  value: const double yaw_change = relative_angle_about(initial[1].inverse() * initial[2], p[1].inverse() * p[2], Eigen::Vector3d::UnitZ())
  assert: CHECK(gap_after < 0.5 * gap_before)
  assert: CHECK(std::abs(pitch_after) < std::abs(pitch_before))
  assert: CHECK(std::abs((p[2].translation() - initial[2].translation()).z()) < 0.02)
  assert: CHECK(std::abs(yaw_change) < 0.3)
  assert: REQUIRE(r.size() == 1)
  assert: CHECK(loop_edge_drop_ratio(loops[0], r[0], c) < 1.0)
  assert: CHECK(loop_edge_drop_ratio(off, r_off[0], c) > 1.0)

