[case] tests/loop_closure_test.cpp :: loop closure information edges: a cross-floor edge carries no height
  markers: -
  value: const Eigen::Affine3d pose_i = tilted_pose(0, 0, 0, 0, 0), pose_j = tilted_pose(1, 3, -2.9, 30, 0.5)
  value: const Eigen::Affine3d correction = Eigen::Affine3d(Eigen::Translation3d(0.1, 0.05, 0.3))
  value: const Eigen::Matrix<double, 6, 6> H = registration_information(box(Eigen::Vector3d(1, 4, -1.6)), correction)
  value: const Eigen::Matrix<double, 6, 6> omega = loop_edge_information(pose_i, pose_j, correction, H, true, 0.05, ok)
  assert: REQUIRE(ok)
  value: const auto measurement = [&](const Eigen::Affine3d &C) {...}
  value: const Eigen::Matrix<double, 6, 1> up = measurement(Eigen::Translation3d(0, 0, 0.01) * correction) - measurement(correction)
  value: const Eigen::Matrix<double, 6, 1> side = measurement(Eigen::Translation3d(0.01, 0, 0) * correction) - measurement(correction)
  assert: CHECK(up.dot(omega * up) < 1e-6 * side.dot(omega * side))
  assert: CHECK(side.dot(omega * side) > 0.01)

