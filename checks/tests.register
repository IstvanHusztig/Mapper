  assert: [damaged] CHECK_MESSAGE(!read, what)
  value: std::uint64_t stored = 0
  assert: REQUIRE(stored == 2)
  assert: REQUIRE(stored == 3)
  assert: REQUIRE(stored == 6)
  call: damaged(windows_count, 50000000ULL, "a curve's window count of 5e7")
  call: damaged(windows_count, capture.windows.size() + 1, "more curve windows than the capture has")
  call: damaged(grid_count, 1000000000ULL, "a grid of 1e9 offsets")
  call: damaged(grid_count, 200, "a grid longer than the rule makes")
  call: damaged(try_blocks, 7, "7 blocks for a 6-window segment")
  call: damaged(try_blocks, 50000000ULL, "5e7 blocks of a try")

