[case] tests/scan_to_map_test.cpp :: window term table: in a corridor NDT holds the window across, far less along
  markers: -
  assert: REQUIRE(t.failure.empty())
  assert: REQUIRE(raw != nullptr)
  number: MESSAGE("corridor NDT shift weight along ", raw->weight[0][0], ", sideways ", raw->weight[0][1])
  assert: CHECK(raw->weight[0][0] < 0.05 * raw->weight[0][1])

[case] tests/scan_to_map_test.cpp :: window term table: in a corridor the cells' in-plane information carries the weight along, and the parts add up
  markers: -
  loop: for (int k = 0; k < n_nodes; k++)
  number: guess[k].translation() += Eigen::Vector3d(0.02 * k / double(n_nodes - 1), 0.01, 0.0)
  assert: REQUIRE(t.failure.empty())
  assert: REQUIRE(raw != nullptr)
  assert: REQUIRE(normal != nullptr)
  assert: REQUIRE(in_plane != nullptr)
  assert: CHECK_FALSE(normal->in_total)
  assert: CHECK_FALSE(in_plane->in_total)
  assert: CHECK(normal->residuals == raw->residuals)
  assert: CHECK(in_plane->residuals == raw->residuals)
  number: MESSAGE("corridor shift weight along: unprojected ", raw->weight[0][0], ", normal ", normal->weight[0][0], ", in-plane ", in_plane->weight[0][0])
  number: MESSAGE("corridor shift weight sideways: unprojected ", raw->weight[0][1], ", normal ", normal->weight[0][1], ", in-plane ", in_plane->weight[0][1])
  assert: CHECK(normal->weight[0][0] < 0.05 * in_plane->weight[0][0])
  assert: CHECK(normal->weight[1][0] < 0.05 * in_plane->weight[1][0])
  loop: for (int a = 0; a < kTermMotions; a++)
  loop: for (int d = 0; d < kTermDirections; d++)
  assert: CHECK(std::abs(normal->weight[a][d] + in_plane->weight[a][d] - w) <= 1e-9 * std::abs(w))
  value: const double pn = std::isfinite(normal->pull[a][d]) ? normal->pull[a][d] * normal->weight[a][d] : 0.0
  value: const double pi = std::isfinite(in_plane->pull[a][d]) ? in_plane->pull[a][d] * in_plane->weight[a][d] : 0.0
  assert: CHECK(std::abs(pn + pi - whole) <= 1e-6 * std::max(std::abs(whole), 1e-9 * std::abs(w)))

[case] tests/scan_to_map_test.cpp :: scan-to-map: the covariances of end velocity and offset are the dense inverse's blocks
  markers: -
  assert: REQUIRE(u.acc_term)
  assert: REQUIRE(u.estimate_bias)
  value: double delta = 0.0
  number: lm_iteration(problem, 5.0, false, false, false, delta, LmWorkspace{f.workspace.covariance, f.workspace.damped})
  value: const Eigen::Matrix3d v_end = inverse.block<3, 3>(u.ie, u.ie)
  value: const Eigen::Matrix3d offset = inverse.block<3, 3>(u.io, u.io)
  assert: CHECK((f.w.velocity.end_covariance - v_end).cwiseAbs().maxCoeff() <= 1e-6 * scale)
  assert: CHECK((f.acc_offset_cov - offset).cwiseAbs().maxCoeff() <= 1e-6 * scale)
  assert: REQUIRE(h.covariance_valid)
  value: const Eigen::Matrix3d v_start = inverse.block<3, 3>(u.iv, u.iv)
  value: const Eigen::Matrix3d bias = inverse.block<3, 3>(u.ib, u.ib)
  assert: CHECK((h.start_velocity_posterior - v_start).cwiseAbs().maxCoeff() <= 1e-6 * v_start.cwiseAbs().maxCoeff())
  assert: CHECK((h.bias_posterior - bias).cwiseAbs().maxCoeff() <= 1e-6 * bias.cwiseAbs().maxCoeff())
  assert: CHECK(h.start_velocity_step == Eigen::Vector3d::Zero())
  assert: CHECK(h.bias_step == Eigen::Vector3d::Zero())

[case] tests/scan_to_map_test.cpp :: scan-to-map, honesty readings: an informative window with a non-zero last step has a finite reading
  markers: -
  value: const HonestyInputs h = honesty_after_iterations(f, 30, noise)
  assert: REQUIRE(h.covariance_valid)
  assert: CHECK(h.start_velocity_step.norm() > 0.0)
  number: MESSAGE("start velocity ", move_text(r.start_velocity), " (reduction ", r.start_velocity.reduction.value_or(-1.0), ", last step ", h.start_velocity_step.cwiseAbs().maxCoeff(), " m/s), gyro bias ", move_text(r.gyro_bias))
  assert: REQUIRE(r.start_velocity.value)
  assert: CHECK(std::isfinite(*r.start_velocity.value))
  assert: CHECK(r.joint.reason == MoveNotMeasured::absent)

[case] tests/scan_to_map_test.cpp :: scan-to-map, honesty readings: a step taken back restores the covariance's validity, its blocks and the step since it
  markers: -
  value: double delta = 0.0
  assert: REQUIRE(lm_iteration(problem, 5.0, true, false, false, delta, ws).applied)
  number: lm_iteration(problem, 5.0, false, false, false, delta, ws)
  assert: REQUIRE(problem.honesty_inputs().covariance_valid)
  assert: CHECK_FALSE(problem.honesty_inputs().covariance_valid)
  assert: CHECK(back.start_velocity.reason == MoveNotMeasured::absent)
  assert: CHECK(back.gyro_bias.reason == MoveNotMeasured::absent)
  number: lm_iteration(problem, 5.0, false, false, true, delta, ws)
  assert: REQUIRE(lm_iteration(problem, 5.0, true, false, false, delta, ws).applied)
  assert: CHECK(stepped.start_velocity_step.norm() > 0.0)
  number: lm_iteration(problem, 5.0, false, false, false, delta, ws)
  assert: REQUIRE(problem.honesty_inputs().start_velocity_posterior != accepted.start_velocity_posterior)
  assert: CHECK(restored.covariance_valid)
  assert: CHECK(restored.start_velocity_posterior == accepted.start_velocity_posterior)
  assert: CHECK(restored.start_velocity == accepted.start_velocity)
  assert: CHECK(restored.start_velocity_step == Eigen::Vector3d::Zero())
  assert: CHECK(restored.bias_step == Eigen::Vector3d::Zero())

