[case] tests/imu_kinematics_test.cpp :: exp_so3 turns about the vector by its length
  markers: -
  assert: CHECK(exp_so3(Eigen::Vector3d::Zero()).isApprox(Eigen::Matrix3d::Identity()))
  value: const Eigen::Vector3d x = exp_so3(Eigen::Vector3d(0.0, 0.0, pi / 2)) * Eigen::Vector3d::UnitX()
  assert: CHECK(x.isApprox(Eigen::Vector3d::UnitY(), 1e-12))

[case] tests/imu_kinematics_test.cpp :: remove_gyro_bias_from_rotations removes a constant rotation rate
  markers: -
  value: const int n = 50
  value: const double bias = 0.1
  value: const auto original = trajectory(n, bias, 1.0)
  number: remove_gyro_bias_from_rotations(tr, ts, Eigen::Vector3d(0.0, 0.0, bias))
  loop: for (int k = 0; k < n; k++)
  assert: CHECK(tr[k].linear().isApprox(Eigen::Matrix3d::Identity(), 1e-12))
  assert: CHECK(tr[k].translation() == original[k].translation())
  assert: CHECK(tr[0].matrix() == original[0].matrix())
  loop: for (int k = 0; k < n; k++)
  assert: CHECK(unchanged[k].matrix() == original[k].matrix())

[case] tests/imu_kinematics_test.cpp :: world_acceleration removes gravity and converts to m/s^2
  markers: -
  value: const int n = 11
  value: const auto tr = trajectory(n, 0.0, 0.0)
  value: const double gravity_norm = 1.0
  value: const double g = 9.80665
  loop: for (const auto &a : world_acceleration(tr, ts, at_rest, level, gravity_norm, 0.0))
  assert: CHECK(a.norm() < 1e-12)
  loop: for (int k = 0; k < n; k++)
  number: expected[k] = Eigen::Vector3d(0.5 * k, -1.0, 2.0)
  value: const auto a = world_acceleration(tr, ts, acc, level, gravity_norm, 0.0)
  loop: for (int k = 0; k < n; k++)
  assert: CHECK(a[k].isApprox(expected[k], 1e-12))
  value: const auto smoothed = world_acceleration(tr, ts, acc, level, gravity_norm, 0.0151)
  assert: CHECK(smoothed[5].isApprox((expected[4] + expected[5] + expected[6]) / 3.0, 1e-12))

[case] tests/imu_kinematics_test.cpp :: is_window_stationary detects rest
  markers: -
  value: const int n = 30
  value: const double acc_threshold = 0.3
  value: const double gyro_threshold = 0.05
  assert: CHECK(is_window_stationary(trajectory(n, 0.0, 0.0), ts, acc, acc_threshold, gyro_threshold))
  number: one_spike[10] = Eigen::Vector3d(0.0, 0.4, 0.0)
  assert: CHECK_FALSE(is_window_stationary(trajectory(n, 0.0, 0.0), ts, one_spike, acc_threshold, gyro_threshold))
  assert: CHECK_FALSE(is_window_stationary(trajectory(n, 0.1, 0.0), ts, acc, acc_threshold, gyro_threshold))

[file] tests/lidar_claim_test.cpp
  value: constexpr double sigma = 0.01
  value: constexpr double scan_density = 444.0
  value: constexpr int n_nodes = 50
  value: constexpr double node_dt = 0.01
