  number: run_third_window() :: r.carried_velocity = Eigen::Vector3d(chain.v_previous_end, 0.0, 0.0)
  number: run_third_window() :: loop.carry.velocity_cov = Eigen::Matrix3d::Identity() * 1e-4
  number: run_third_window() :: r.ok = process_windows(loop, chain.windows, 2, 2, c, state, ts_failure, false, store, preview, logger, progress, range)
  number: run_third_window() :: if (r.ok && sink.records.size() == 1)
  number: run_third_window() :: r.record = sink.records[0]
