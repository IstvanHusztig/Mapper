  value: ROOT = Path(__file__).resolve().parents[1]
  number: sys.path.insert(0, str(ROOT / 'tools'))
  value: W_LOOP = np.diag([400.0] * 3 + [1 / np.deg2rad(0.3) ** 2] * 3)
  default: translation() :: defaults of translation(x, y=0.0, z=0.0)
  number: translation() :: m = np.eye(4)
  number: translation() :: m[:3, 3] = (x, y, z)
  default: chain_capture() :: defaults of chain_capture(n=5, spacing=1.0, tries=None, settings=None, nodes_per_segment=3)
  number: chain_capture() :: offsets = [0]
  number: chain_capture() :: t0 = k * 1.0
  number: chain_capture() :: segs.append(dict(first=k, last=k, pose=translation(k * spacing), center=np.zeros(3), path_begin=k * spacing, path_end=(k + 1) * spacing, t_begin=t0, t_end=t0 + 1.0))
  number: chain_capture() :: times.append(t0 + m * 0.3)
  number: chain_capture() :: offsets.append(offsets[-1] + nodes_per_segment)
  number: chain_capture() :: return lg.Capture(cfg, segs, np.array(offsets), np.array(poses), t, 1700000000.0 + t, tries or {})
  default: try_of() :: defaults of try_of(correction, H=None)
  number: try_of() :: return dict(C=correction, H=np.eye(6) if H is None else H, center=np.zeros(3), overlap_before=0.5, overlap_after=0.8, shift=0.1, angle=0.0, information_ratio=0.0, accepted=True, asked=True, registered=True)
  default: capture_bytes() :: defaults of capture_bytes(version, readings=None, blocks=None, fine_time=False)
  number: capture_bytes() :: out += q(1) + q(4) + b'name' + q(1) + b'1'
  number: capture_bytes() :: out += q(2)
  loop: capture_bytes() :: for w in range(2)
  number: capture_bytes() :: out += q(2) + d(*np.eye(4).T.ravel()) + d(*translation(0.5 + w).T.ravel())
  number: capture_bytes() :: out += q(2) + d(*np.eye(4).T.ravel()) * 2
  number: capture_bytes() :: out += q(2) + d(w * 1.0, 1700000000.0, w * 1.0 + 0.4, 1700000000.0 + 0.4)
  number: capture_bytes() :: out += q(0) + q(0)
  number: capture_bytes() :: out += d(*[0.0] * 27)
  number: capture_bytes() :: out += q(1) + struct.pack('<ii', 0, 1) + d(*np.eye(4).T.ravel()) + d(0, 0, 0) + d(0, 1, 0, 1.4)
  loop: capture_bytes() :: for (k, b) in enumerate(blocks or [], start=1)
  number: capture_bytes() :: out += struct.pack('<iiBB', 0, k, 0, int(len(b) > 0)) + d(0.5, 0.8) + d(*translation(0.1 * k).T.ravel())
  number: capture_bytes() :: out += d(*np.arange(36.0)) + d(0.1, 0.2, 0.3) + d(0, 0, 0) + struct.pack('<BB', 1, 1)
  number: capture_bytes() :: out += q(2) + (q(2) + d(*np.eye(4).T.ravel()) * 2) * 2
  number: capture_bytes() :: out += struct.pack('<i', 0)
  number: capture_bytes() :: if version >= 2
  number: capture_bytes() :: out += q(2)
  number: capture_bytes() :: out += struct.pack('<B', 0)
  number: capture_bytes() :: out += struct.pack('<B', 1) + d(ratio, *axis) + struct.pack('<B', rest) + d(*move, dur)
  number: capture_bytes() :: if version >= 3
  number: capture_bytes() :: if version >= 4
  number: capture_bytes() :: out += q(1) + d(*translation(0.25).T.ravel())
  number: capture_bytes() :: out += q(1) + struct.pack('<iiiiiB', 0, 1, 1, 0, 1, 0) + d(1.5, 0.0, 1.4) + d(1, 0, 0) + d(0, 1, 0)
  number: capture_bytes() :: out += q(1) + struct.pack('<ii', 0, 1) + d(2.25) + q(3) + d(-0.1, 0.0, 0.1) + struct.pack('<i', 42)
  number: capture_bytes() :: out += q(1) + struct.pack('<ii', 9, 3) + q(3) + d(0.25, 0.01, 0.25) + q(3) + struct.pack('<3i', 0, 9, 1)
  number: capture_bytes() :: out += q(0) + q(0)

[case] tests/test_loop_graph.py :: LoopGraphTest.test_chain_with_one_loop_edge_matches_hand_computed
  markers: -
  number: cap = chain_capture(tries={(0, 4, False): try_of(translation(-0.4))})
  number: g = lg.LoopGraph(cap, [(0, 4, False)], loop_omega={(0, 4, False): W_LOOP})
  number: taken = 0.4 * 0.04 / (0.04 + 0.0025)
  number: expected_x = np.arange(5) - taken * np.arange(5) / 4
  number: np.testing.assert_allclose(sol.poses[:, 0, 3], expected_x, atol=1e-09)
  number: np.testing.assert_allclose(sol.poses[:, 1:3, 3], 0, atol=1e-08)
  number: np.testing.assert_allclose(sol.poses[:, :3, :3], np.broadcast_to(np.eye(3), (5, 3, 3)), atol=1e-08)
  assert: self.assertAlmostEqual(sol.cost_odometry, 4 * 100 * (taken / 4) ** 2, places=9)
  assert: self.assertAlmostEqual(sol.cost_loops, 400 * (0.4 - taken) ** 2, places=9)
  assert: self.assertAlmostEqual(sol.cost, sol.cost_odometry + sol.cost_loops, places=12)
  assert: self.assertEqual(len(sol.factor_costs), 5)

