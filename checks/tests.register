[case] tests/ndt_map_test.cpp :: update_rgd: every cell carries the inverse of its covariance, refreshed when a later call changes the cell
  markers: -
  value: const auto make_points = [&](int n) {...}
  value: const auto check_all = [&](const NDTBucketMapType &buckets) {...}
  assert: REQUIRE(cell.inverse_computed)
  assert: CHECK(std::memcmp(cell.cov_inverse.data(), expected.data(), 9 * sizeof(double)) == 0)
  value: const bool expected_usable = !((expected.array() > 100000.0).any() || (expected.array() < -100000.0).any())
  assert: CHECK(cell.inverse_usable == expected_usable)
  assert: CHECK((inverse != nullptr) == expected_usable)
  assert: CHECK(usable > 0)
  assert: REQUIRE(inverse != nullptr)
  assert: CHECK(std::memcmp(inverse->data(), expected.data(), 9 * sizeof(double)) == 0)

