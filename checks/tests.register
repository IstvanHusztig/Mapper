  value: add_window_offsets() :: std::mt19937 rng(5)
  loop: add_window_offsets() :: for (size_t w = 1; w < r.windows.size(); w++)
  loop: add_window_offsets() :: for (size_t n = 0; n < window.poses.size(); n++)
  value: Measured :: size_t voxels = 0
  number: measure() :: return {mean_error(poses, truth), max_error(poses, truth), occupied_voxels(r.windows, r.points, 0.03)}
  loop: run() :: for (size_t w = 0; w < r.points.size(); w++)
  value: check_seams() :: Recording r = loop_recording(2)
  number: check_seams() :: add_window_offsets(r, 0.03, 0.2 * deg)
  number: check_seams() :: MESSAGE("Consistency seams: mean error ", before.mean.position * 1000.0, " mm / ", before.mean.rotation / deg, " deg -> ", after.mean.position * 1000.0, " mm / ", after.mean.rotation / deg, " deg; largest ", before.largest.position * 1000.0, " -> ", after.largest.position * 1000.0, " mm; 3 cm voxels ", before.voxels, " -> ", after.voxels, " (truth ", truth_map.voxels, "); ", ms, " ms")
  assert: check_seams() :: CHECK(after.mean.position <= 0.8 * before.mean.position)
  assert: check_seams() :: CHECK(after.mean.rotation <= 0.8 * before.mean.rotation)
  assert: check_seams() :: CHECK(after.voxels <= truth_map.voxels + 0.85 * (before.voxels - truth_map.voxels))
  value: check_truth() :: Recording r = loop_recording(2)
  number: check_truth() :: MESSAGE("Consistency truth: largest change ", after.largest.position * 1000.0, " mm / ", after.largest.rotation / deg, " deg, mean ", after.mean.position * 1000.0, " mm; ", ms, " ms")
  assert: check_truth() :: CHECK(after.largest.position <= 0.005)
  assert: check_truth() :: CHECK(after.largest.rotation <= 0.1 * deg)
  loop: run_in_chunks() :: for (size_t w = 0; w < r.points.size(); w++)
  loop: run_in_chunks() :: for (int pass = 0; pass < config.num_constistency_iter; pass++)

[case] tests/consistency_test.cpp :: consistency: Consistency with several chunks is repeatable and reduces the seams
  markers: -
  value: Recording a = loop_recording(2)
  value: size_t total_points = 0
  value: const size_t chunk_points = total_points / 5 + 1
  assert: REQUIRE(chunk_points > 10000)
  number: add_window_offsets(a, 0.03, 0.2 * deg)
  assert: REQUIRE(poses_a.size() == poses_b.size())
  loop: for (size_t i = 0; i < poses_a.size(); i++)
  assert: CHECK(same)
  number: MESSAGE("Consistency in 5 chunks: mean error ", before.mean.position * 1000.0, " mm -> ", after.mean.position * 1000.0, " mm")
  assert: CHECK(after.mean.position <= 0.9 * before.mean.position)

