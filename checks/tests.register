  assert: CHECK(none.loops == plain.loops)
  assert: CHECK(same_bits(all_poses(none.windows), all_poses(plain.windows)))
  assert: CHECK(none.rejected.empty())
  assert: CHECK(without.rejected_not_in_capture.empty())
  assert: CHECK(without.rejected == std::vector<std::string>{loop_try_name(named)})
  assert: CHECK(without.rejected_not_asked.empty())
  assert: CHECK(!(e.i == kept.i && e.j == kept.j))
  assert: CHECK(!same_bits(all_poses(without.windows), all_poses(plain.windows)))
  value: const std::pair<int, int> unknown{0, 1}
  assert: CHECK(bad.rejected_not_in_capture == std::vector<std::string>{"0-1"})
  assert: CHECK(bad.loops == 0)
  assert: CHECK(same_bits(all_poses(bad.windows), all_poses(capture.windows)))
  assert: REQUIRE(write_loop_closure_replay_json(file, without, LoopClosureSettingsDifference{}, config, why))
  loop: for (const char *field : {"\"shift_m\"", "\"angle_deg\"", "\"first_solve_residual_m\"", "\"rejected_tries\"", "\"edges_kept\""})
  assert: CHECK_MESSAGE(text.find(field) != std::string::npos, field)
  assert: CHECK(text.find(loop_try_name(named)) != std::string::npos)

[case] tests/loop_closure_test.cpp :: loop closure replay: the tries to reject are read as i-j[,i-j...]
