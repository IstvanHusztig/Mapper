  number: oscillation() :: return {g * env.e, dg * env.e + g * env.de, ddg * env.e + 2.0 * dg * env.de + g * env.dde}
  number: Motion() :: after the parameters: : gait_(gait), z_(start_position.z()), v_end_(0.0), psi_end_(start_heading_rad), t_end_(0.0), p_end_(start_position.head<2>())
  value: Motion() :: const double deg = pi / 180.0, w1 = 2.0 * pi * 0.5 * gait.step_hz, w2 = 2.0 * pi * gait.step_hz
  value: Motion() :: const double s2 = std::sqrt(2.0)
