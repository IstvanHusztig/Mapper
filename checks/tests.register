[case] tests/window_noise_model_test.cpp :: window noise model: the motion edges' weights follow their formulas
  markers: -
  value: const Window w = uneven_window(12, 0.002)
  loop: for (const double k : {4.0, 9.0})
  assert: REQUIRE(noise.edges.rotation.size() == 11)
  loop: for (size_t i = 0; i < noise.edges.rotation.size(); i++)
  value: const double dt = w.timestamps[i + 1].first - w.timestamps[i].first
  assert: CHECK(noise.edges.dt[i] == dt)
  loop: for (int axis = 0; axis < 3; axis++)
  assert: CHECK(noise.edges.rotation[i](axis) == 1.0 / (sigma * sigma))
  assert: CHECK(noise.edges.x == 1.0 / (m.x_sigma_m * m.x_sigma_m))
  assert: [the floor holds at zero dt] CHECK(time_scaled_rotation_sigma(4.0, 1e-4, 0.0, 2e-6) == 2e-6)
  number: imu_term(imu, 12, false)
  assert: [the position scale only with the accelerometer term] REQUIRE(noise.unknowns.acc_term)
  value: [the position scale only with the accelerometer term] double x = 1.0 / (m.x_sigma_m * m.x_sigma_m)
  number: x *= 0.1
  assert: [the position scale only with the accelerometer term] CHECK(noise.edges.x == x)

[case] tests/window_noise_model_test.cpp :: window noise model: the velocity continuity and the first step, only without the accelerometer term
  markers: -
  value: const Window w = uneven_window(10, 0.002)
  value: const VelocityPrior prior{true, Eigen::Vector3d(0.8, 0.1, 0.0)}
  assert: REQUIRE(noise.velocity_continuity)
  assert: REQUIRE(noise.velocity_continuity_weights.size() == 8)
  loop: for (size_t i = 1; i + 1 < w.poses.size(); i++)
  value: const double dt1 = w.timestamps[i].first - w.timestamps[i - 1].first, dt2 = w.timestamps[i + 1].first - w.timestamps[i].first
  value: const double sigma = m.acc_sigma_mps2 * 0.5 * (dt1 + dt2)
  assert: CHECK(noise.velocity_continuity_weights[i - 1] == 1.0 / (sigma * sigma))
  assert: REQUIRE(noise.first_step_prior)
  value: const double sigma = m.acc_sigma_mps2 * (w.timestamps[1].first - w.timestamps[0].first)
  assert: CHECK(noise.first_step_weight == 1.0 / (sigma * sigma))
  assert: CHECK(noise.first_step_velocity == prior.velocity)
  number: imu_term(imu, 10, false)
  assert: CHECK_FALSE(with_acc.velocity_continuity)
  assert: CHECK(with_acc.velocity_continuity_weights.empty())
  assert: CHECK_FALSE(with_acc.first_step_prior)

[case] tests/window_noise_model_test.cpp :: window noise model: the accelerometer terms' spans and weights
  markers: -
  value: const Window w = Window(uneven_window(30, 0.002))
  number: imu_term(imu, 30, false)
  assert: REQUIRE(noise.unknowns.acc_term)
  assert: REQUIRE(anchors.size() >= 4)
  assert: REQUIRE(noise.accelerometer_terms.size() == anchors.size() - 2 + 2)
  value: const double d2 = 0.0013 * 0.0013, f2 = 0.1 * 0.1
  loop: for (size_t j = 0; j < noise.accelerometer_terms.size(); j++)
  assert: CHECK(s.weight == 1.0 / ((d2 / s.tau + f2) * s.tau * s.tau))
  assert: CHECK(s.tau > 0.0)
  assert: CHECK(first.kind == AccelerometerTermKind::anchor_triple)
  assert: CHECK(first.tau == 0.5 * (w.timestamps[anchors[1]].first + w.timestamps[anchors[2]].first) - 0.5 * (w.timestamps[anchors[0]].first + w.timestamps[anchors[1]].first))
  value: const AccelerometerTermSpan &start = noise.accelerometer_terms[noise.accelerometer_terms.size() - 2]
  assert: CHECK(start.kind == AccelerometerTermKind::start_velocity)
  assert: CHECK(start.tau == 0.5 * (w.timestamps[anchors[1]].first - w.timestamps[0].first))
  assert: CHECK(end.kind == AccelerometerTermKind::end_velocity)
  assert: CHECK(end.c == 29)
  assert: CHECK(noise.end_velocity_tied)
  loop: [a gap leaves the terms across it out] for (size_t k = 15; k < gap.timestamps.size(); k++)
  number: gap.timestamps[k].first += 0.05
  number: gap.timestamps[k].second += 0.05
  assert: [a gap leaves the terms across it out] CHECK(g.accelerometer_terms.size() < noise.accelerometer_terms.size())

[case] tests/window_noise_model_test.cpp :: window noise model: what exists in the first window, at rest and without timestamps
  markers: -
  value: const Window w = uneven_window(20, 0.002)
  assert: [the first window: no bias estimation, no accelerometer term] CHECK_FALSE(noise.unknowns.estimate_bias)
  assert: [the first window: no bias estimation, no accelerometer term] CHECK(noise.bias_prior_information.isZero())
  assert: [the first window: no bias estimation, no accelerometer term] CHECK(noise.accelerometer_terms.empty())
  assert: [the first window: no bias estimation, no accelerometer term] CHECK(noise.velocity_prior_information.isZero())
  assert: [the first window: no bias estimation, no accelerometer term] CHECK(noise.offset_prior_information.isZero())
  assert: [the first window: no bias estimation, no accelerometer term] CHECK(noise.zero_velocity_weight == 0.0)
  number: imu_term(imu, 20, true)
  assert: [a window at rest gets the zero-velocity weight] CHECK(noise.at_rest)
  assert: [a window at rest gets the zero-velocity weight] CHECK(noise.zero_velocity_weight == 1.0 / (0.01 * 0.01))
  number: imu_term(imu, 20, false)
  assert: [without timestamps: no time scaling, no bias, no accelerometer term, no velocity continuity] CHECK_FALSE(noise.unknowns.time_scaled_sigma)
  assert: [without timestamps: no time scaling, no bias, no accelerometer term, no velocity continuity] CHECK_FALSE(noise.unknowns.acc_term)
  assert: [without timestamps: no time scaling, no bias, no accelerometer term, no velocity continuity] CHECK_FALSE(noise.velocity_continuity)
  assert: [without timestamps: no time scaling, no bias, no accelerometer term, no velocity continuity] CHECK(noise.edges.rotation[0](0) == 1.0 / (sigma * sigma))

[case] tests/window_noise_model_test.cpp :: window noise model: the same values the terms put into the normal equations
  markers: -
  value: const Window w = uneven_window(30, 0.002)
  number: imu_term(imu, 30, true)
  assert: REQUIRE(u.estimate_bias)
  assert: REQUIRE(u.acc_term)
  loop: for (int a = 0; a < 3; a++)
  loop: for (int b = 0; b < 3; b++)
  assert: CHECK(bias.matrix(u.ib + a, u.ib + b) == noise.bias_prior_information(a, b))
  assert: CHECK(velocity.matrix(u.iv + a, u.iv + b) == noise.velocity_prior_information(a, b))
  assert: CHECK(offset.matrix(u.io + a, u.io + b) == noise.offset_prior_information(a, b))
  assert: CHECK(rest.matrix(u.iv + a, u.iv + a) == noise.zero_velocity_weight)
  assert: CHECK(rest.matrix(u.ie + a, u.ie + a) == noise.zero_velocity_weight)
  loop: for (int k = 0; k < 6; k++)
  assert: CHECK(origin.matrix(k, k) == noise.origin[size_t(k)])

[case] tests/window_noise_model_test.cpp :: window noise model: the priors grow by their random walk over the window and by the noise over the gap
  markers: -
  number: carried << 4.0, 0.5, 0.0, 0.5, 3.0, 0.2, 0.0, 0.2, 2.0
  number: carried *= 1e-6
  value: const double rw = 2e-4, duration = 0.4
  assert: CHECK(grown == carried + Eigen::Matrix3d::Identity() * (rw * rw * duration))
  assert: CHECK((grown - carried).isDiagonal())
  assert: CHECK(random_walk_prior_cov(carried, rw, 0.0) == carried)
  value: const double density = 0.0013, floor = 0.1, gap = 0.002
  assert: CHECK(v == carried + Eigen::Matrix3d::Identity() * (density * density * gap + floor * floor * gap * gap))
  assert: CHECK(v(0, 0) > carried(0, 0))
  assert: CHECK(v(0, 1) == carried(0, 1))

[case] tests/window_noise_model_test.cpp :: window term table: mean rotation rate from the attitude increments
  markers: -
