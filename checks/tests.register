  assert: CHECK(fine_time_held_out(V3(-0.5, -0.5, -0.5), rule()) == fine_time_held_out(V3(-0.9, -0.1, -0.3), rule()))

[case] tests/loop_fine_time_test.cpp :: loop fine time: at most 256 patches, spread over all; the offset grid; the order of preference
  markers: -
  assert: CHECK(fine_time_take(5, 256) == std::vector<size_t>{0, 1, 2, 3, 4})
  value: const std::vector<size_t> t = fine_time_take(1000, 256)
  assert: REQUIRE(t.size() == 256)
  assert: CHECK(t.front() == 0)
  assert: CHECK(t.back() == 999)
  assert: CHECK(std::adjacent_find(t.begin(), t.end(), [](size_t a, size_t b) { return b <= a; }) == t.end())
  assert: CHECK(t[1] == 3)
  value: const std::vector<double> grid = fine_time_offset_grid(5.04, rule(), bound)
  assert: CHECK(bound == doctest::Approx(7.56))
  assert: REQUIRE(grid.size() == 151)
  assert: CHECK(grid.front() == -75 * 0.1)
  assert: CHECK(grid.back() == 75 * 0.1)
  assert: CHECK(grid[75] == 0.0)
  assert: CHECK(fine_time_offset_grid(100.0, rule(), bound).size() == 161)
  assert: CHECK(bound == 8.0)
  value: const std::vector<double> small = {-0.2, -0.1, 0.0, 0.1, 0.2}
  assert: CHECK(fine_time_preference(small) == std::vector<int>{2, 1, 3, 0, 4})

[case] tests/loop_fine_time_test.cpp :: loop fine time: the profile is the brute-force minimum; no support gives zero; the ends are pinned; ties as the rule orders
  markers: -
  value: const std::vector<double> grid = grid_of(2)
  assert: CHECK(profile_cost(E, grid, path, 0.10) == doctest::Approx(brute_profile_cost(E, grid, 0.10)).epsilon(1e-12))
  value: const std::vector<double> wide = grid_of(5)
  assert: CHECK(wide[k] == 0.0)
  value: const std::vector<double> g20 = grid_of(20)
  assert: CHECK(d[4] == doctest::Approx(1.0))
  assert: CHECK(d[w + 1] > d[w])
  assert: CHECK(d[w + 1] < d[w])
  assert: CHECK(std::abs(d[0]) < std::abs(d[1]))
  value: const std::vector<double> g3 = grid_of(3)
  assert: CHECK(g3[fine_time_profile(T, g3, rule())[0]] == doctest::Approx(-0.2))
  assert: CHECK(g3[fine_time_profile(T, g3, rule())[0]] == doctest::Approx(0.1))
  assert: CHECK(fine_time_own_offset(T[0], g3, rule()) == doctest::Approx(-0.2))

