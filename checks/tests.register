[case] tests/terms_at_truth_test.cpp :: terms at the truth: D4, gyro white noise at ARW/sqrt(dt) gives the rotation edges' assumed variance
  markers: -
  number: noise.gyro_arw_deg_sqrt_s = Eigen::Vector3d(0.028, 0.042, 0.057)
  value: static const std::unique_ptr<Fixture> noisy = make_fixture(a5_route(), noise, 0.0)
  assert: REQUIRE(f.cut.ok)
  value: const Options opt = make_options(0.01, noise.gyro_arw_deg_sqrt_s)
  value: const double deg = 3.14159265358979323846 / 180.0
  value: double sum_z2 = 0.0, sum_z = 0.0
  value: int n = 0
  number: Axis all[3], first[3]
  value: double assumed_check = 0.0
  loop: for (int w = 0; w < static_cast<int>(f.cut.windows.size()); w++)
  loop: for (int k = 0; k + 1 < static_cast<int>(tw->window.poses.size()); k++)
  value: double dt = 0.0
  loop: for (int a = 0; a < 3; a++)
  value: Axis &s = w == 0 ? first[a] : all[a]
  number: assumed_check = std::max(assumed_check, std::abs(1.0 / weight(a) / (arw * arw * dt) - 1.0))
  assert: CHECK(assumed_check < 1e-9)
  number: o << std::fixed << std::setprecision(4) << "D4 rotation edges at ARW/sqrt(dt) noise, A5 walking, " << f.cut.windows.size() << " windows; production assumed variance = (ARW)^2 dt to " << std::scientific << assumed_check << std::fixed
  loop: for (int a = 0; a < 3; a++)
  value: const auto interval = truth_stats::chi2_interval(df, 0.01 / 3.0)
  assert: CHECK(inside_interval(all[a].sum_z2, df))

[case] tests/terms_at_truth_test.cpp :: terms at the truth: D4, the gap covariance's algebra, apart from its mean
  markers: -
  value: const double gap = 0.002, density = 0.0013, floor = 0.1
  value: const Eigen::Matrix3d C = Eigen::Matrix3d::Identity() * 0.3
  assert: CHECK((velocity_prior_cov_over_gap(C, density, floor, gap) - (C + (density * density * gap + floor * floor * gap * gap) * Eigen::Matrix3d::Identity())).cwiseAbs().maxCoeff() < 1e-18)
  value: constexpr double D = 0.01056
  value: Motion rest(Eigen::Vector3d(0, 0, 1.5), 0.0)
  number: rest.rest(60.0)
  number: io.seed = 3
  value: double sum2 = 0.0
  value: int n = 0
  loop: for (int k = 0; k < rec.n_nodes(); k++)
  loop: for (int axis = 0; axis < 3; axis++)
  value: const double noise = rec.acc_g[k](axis) * standard_gravity - (axis == 2 ? standard_gravity : 0.0)
  value: const double claimed = velocity_prior_cov_over_gap(Eigen::Matrix3d::Zero(), D, 0.0, rec.dt_s())(0, 0)
  value: const auto interval = truth_stats::chi2_interval(n, 0.01)
  assert: CHECK(inside_interval(sum2 / claimed, static_cast<double>(n)))

