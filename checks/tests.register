[case] tests/scan_to_map_test.cpp :: window terms: the NDT point terms' right-hand side is minus half their cost's gradient
  markers: -
  loop: for (bool huber : {false, true})
  number: c.degenerate_projection_ratio = c.degenerate_projection_ratio_full = 0.0
  number: c.ndt_huber_cutoff = 3.0
  number: c.ndt_information_scale = 0.1
  loop: for (int i = 0; i < n_nodes; i++)
  number: guess[i].translation() += Eigen::Vector3d(0.02, -0.01, 0.008)
  number: guess[i].linear() = Eigen::AngleAxisd(0.004, Eigen::Vector3d::UnitZ()).toRotationMatrix() * guess[i].linear()
  value: double cost = 0.0
  assert: REQUIRE(cost0 > 0.0)
  value: const double h = 1e-7
  loop: for (int node : {0, 10, 25, n_nodes - 1})
  loop: for (int p = 0; p < 6; p++)
  value: const int column = node * 6 + p
  number: [cost_at] double *const parameter[6] = {&pose.px, &pose.py, &pose.pz, &pose.om, &pose.fi, &pose.ka}
  value: const double gradient = (cost_at(h) - cost_at(-h)) / (2.0 * h)
  value: const double scale = std::max({std::abs(gradient), std::abs(e0.rhs(column, 0)), 1e-6 * cost0})
  assert: CHECK(std::abs(e0.rhs(column, 0) + 0.5 * gradient) <= 1e-3 * scale)

[case] tests/scan_to_map_test.cpp :: window term table: the rows add up to the window's complete equations
  markers: -
  loop: for (int k = 0; k < n_nodes; k++)
  number: guess[k].translation() += Eigen::Vector3d(0.01, -0.02, 0.005) * (k / double(n_nodes - 1))
  number: w.velocity.start = w.velocity.end = Eigen::Vector3d(1.0, 0.0, 0.0)
  number: w.gyro_bias.mean = Eigen::Vector3d(0.001, 0.0, -0.002)
  number: acc.imu.velocity_guess = Eigen::Vector3d(0.9, 0.05, -0.02)
  assert: REQUIRE(t.failure.empty())
  loop: for (const char *name : {"ndt_indoor", "ndt_outdoor", "ndt_unprojected", "edge_position", "edge_rotation", "gyro_bias_prior", "accelerometer", "velocity_prior", "offset_prior", "origin_fix", "total", "damping"})
  assert: CHECK(table_row(t, name) != nullptr)
  assert: CHECK(table_row(t, "velocity_continuity") == nullptr)
  assert: REQUIRE(turn_defined)
  loop: for (int i = 0; i < kTermMotions * kTermDirections; i++)
  value: const double pull = m[i].dot(all.rhs.col(0)) / weight
  assert: CHECK(std::abs(total->weight[i / 3][i % 3] - weight) <= 1e-9 * weight)
  assert: CHECK(std::abs(total->pull[i / 3][i % 3] - pull) <= 1e-6 * std::max(std::abs(pull), 1e-6))

[case] tests/scan_to_map_test.cpp :: window term table: NDT shows a sideways offset and a stretch of the guess
  markers: -
  number: c.degenerate_projection_ratio = c.degenerate_projection_ratio_full = 0.0
  assert: [ndt_pull] REQUIRE(t.failure.empty())
  assert: [ndt_pull] REQUIRE(ndt != nullptr)
  value: [moved sideways: the shift pull sideways is minus the offset] const double at_truth = ndt_pull(truth, 0, 1)
  call: [moved sideways: the shift pull sideways is minus the offset] ndt_pull(truth, 0, 1)
  loop: [moved sideways: the shift pull sideways is minus the offset] for (double offset : {0.01, 0.05})
  number: p.translation() += Eigen::Vector3d(0.0, offset, 0.0)
  value: [moved sideways: the shift pull sideways is minus the offset] const double pull = ndt_pull(guess, 0, 1) - at_truth
  call: [moved sideways: the shift pull sideways is minus the offset] ndt_pull(guess, 0, 1)
  number: if (offset == 0.01)
  assert: [moved sideways: the shift pull sideways is minus the offset] CHECK((pull < -0.75 * offset && pull > -1.05 * offset))
  assert: [moved sideways: the shift pull sideways is minus the offset] CHECK((pull < -0.5 * offset && pull > -1.1 * offset))
  value: [stretched along travel: the stretch pull along is minus the stretch] const double at_truth = ndt_pull(truth, 1, 0)
  call: [stretched along travel: the stretch pull along is minus the stretch] ndt_pull(truth, 1, 0)
  loop: [stretched along travel: the stretch pull along is minus the stretch] for (double stretch : {0.01, 0.05})
  loop: [stretched along travel: the stretch pull along is minus the stretch] for (int k = 0; k < n_nodes; k++)
  number: guess[k].translation() += Eigen::Vector3d(stretch * k / double(n_nodes - 1), 0.0, 0.0)
  value: [stretched along travel: the stretch pull along is minus the stretch] const double pull = ndt_pull(guess, 1, 0) - at_truth
  call: [stretched along travel: the stretch pull along is minus the stretch] ndt_pull(guess, 1, 0)
  number: if (stretch == 0.01)
  assert: [stretched along travel: the stretch pull along is minus the stretch] CHECK((pull < -0.75 * stretch && pull > -1.05 * stretch))
  assert: [stretched along travel: the stretch pull along is minus the stretch] CHECK((pull < -0.5 * stretch && pull > -1.1 * stretch))

[case] tests/scan_to_map_test.cpp :: window term table: the accelerometer's curve pull is a missing constant acceleration
  markers: -
  value: const double a = 0.8, duration = (n_nodes - 1) * node_dt
  loop: for (int k = 0; k < n_nodes; k++)
  number: truth.push_back(pose(Eigen::Vector3d(t + 0.5 * a * t * t, 0.0, 1.5), 0.0))
  number: guess.push_back(pose(Eigen::Vector3d(t, 0.0, 1.5), 0.0))
  number: w.velocity.start = w.velocity.end = Eigen::Vector3d(1.0, 0.0, 0.0)
  number: make_acc_data(acc, truth, Eigen::Vector3d(a, 0.0, 0.0))
  assert: REQUIRE(t.failure.empty())
  assert: REQUIRE(row != nullptr)
  value: const double missing = 0.5 * a * duration * duration
  number: MESSAGE("accelerometer curve pull along ", row->pull[2][0], " m, missing ", missing, " m")
  assert: CHECK(std::abs(row->pull[2][0] - missing) <= 1e-3 * missing)
  assert: CHECK(std::abs(row->weight[1][0]) <= 1e-9 * row->weight[2][0])

[case] tests/scan_to_map_test.cpp :: window term table: the gyro edges' turn pull is a heading ramp against the motion model
  markers: -
