[case] tests/window_capture_test.cpp :: window term csv: the features file's old columns keep their names, order and values; the new ones follow
  markers: -
  assert: REQUIRE(old_names.size() == 93)
  loop: for (const bool filled : {false, true})
  call: features_lines_of(record)
  assert: REQUIRE(lines.size() == 2)
  value: const std::vector<std::string> names = csv_fields(lines[0]), values = csv_fields(lines[1])
  assert: REQUIRE(names.size() == old_names.size() + kNewColumns)
