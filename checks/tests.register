  assert: CHECK(is_window_stationary(trajectory(n, 0.0, 0.0), ts, acc, acc_threshold, gyro_threshold))
  assert: CHECK_FALSE(is_window_stationary(trajectory(n, 0.0, 0.0), ts, one_spike, acc_threshold, gyro_threshold))
  assert: CHECK_FALSE(is_window_stationary(trajectory(n, 0.1, 0.0), ts, acc, acc_threshold, gyro_threshold))

