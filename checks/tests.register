[case] tests/synthetic_inertial_test.cpp :: synthetic motion: derivatives agree and segments join smoothly
  markers: -
  value: const double h = 1e-5
  value: const MotionState a = m.state(t - 1e-9), b = m.state(t + 1e-9)
  assert: CHECK(worst_v < 1e-7)
  assert: CHECK(worst_a < 1e-6)
  assert: CHECK(worst_w < 1e-6)
  assert: CHECK(worst_join < 1e-4)
  assert: CHECK(m.at_rest(0.0, 1.0))
  assert: CHECK_FALSE(m.at_rest(0.0, 1.5))
  assert: CHECK(m.first_motion_time() == doctest::Approx(1.0))
  assert: CHECK(m.end_speed() == doctest::Approx(0.0).epsilon(1e-9))

