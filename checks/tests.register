[case] tests/loop_closure_test.cpp :: loop closure information edges: the transformed information reproduces the registration's error in the edge's residual
  markers: -
  value: const Eigen::Affine3d pose_i = tilted_pose(0, 0, 0, 10, 0), pose_j = tilted_pose(5, 1, 0.1, 40, 1)
  number: correction.translation() = Eigen::Vector3d(0.2, -0.1, 0.05)
  number: correction.linear() = Eigen::AngleAxisd(1.5 * DEG_TO_RAD, Eigen::Vector3d(0.1, 0.2, 1.0).normalized()).toRotationMatrix()
  value: const Eigen::Matrix<double, 6, 6> H = registration_information(box(Eigen::Vector3d(3, 2, 1)), correction)
  value: const Eigen::Matrix<double, 6, 6> omega = loop_edge_information(pose_i, pose_j, correction, H, false, 0.05, ok)
  assert: REQUIRE(ok)
  value: const double best = Eigen::SelfAdjointEigenSolver<Eigen::Matrix3d>(omega.topLeftCorner<3, 3>()).eigenvalues()(2)
  assert: CHECK(best == doctest::Approx(1.0 / (0.05 * 0.05)).epsilon(1e-9))
  number: [measurement] Eigen::Matrix<double, 6, 1> m = tb(pose_i.inverse() * C * pose_j)
  loop: for (int k = 0; k < 6; k++)
  number: Eigen::Matrix<double, 6, 1> e
  number: e << 1e-4 * (k + 1), -2e-4 * (k % 2), 1.5e-4, 0.5e-4 * (k % 3), -1e-4, 2e-4 * (k == 2)
  number: const Eigen::Matrix<double, 6, 1> dm = measurement(from_tb(tb(correction) + e)) - measurement(correction)
  assert: CHECK(r == doctest::Approx(ratios.front()).epsilon(1e-3))

[case] tests/loop_closure_test.cpp :: loop closure information edges: a cross-floor edge carries no height
  markers: -
  value: const Eigen::Affine3d pose_i = tilted_pose(0, 0, 0, 0, 0), pose_j = tilted_pose(1, 3, -2.9, 30, 0.5)
  value: const Eigen::Affine3d correction = Eigen::Affine3d(Eigen::Translation3d(0.1, 0.05, 0.3))
  value: const Eigen::Matrix<double, 6, 6> H = registration_information(box(Eigen::Vector3d(1, 4, -1.6)), correction)
  value: const Eigen::Matrix<double, 6, 6> omega = loop_edge_information(pose_i, pose_j, correction, H, true, 0.05, ok)
  assert: REQUIRE(ok)
  number: [measurement] return Eigen::Matrix<double, 6, 1>(tb(pose_i.inverse() * C * pose_j))
  value: const Eigen::Matrix<double, 6, 1> up = measurement(Eigen::Translation3d(0, 0, 0.01) * correction) - measurement(correction)
  value: const Eigen::Matrix<double, 6, 1> side = measurement(Eigen::Translation3d(0.01, 0, 0) * correction) - measurement(correction)
  assert: CHECK(up.dot(omega * up) < 1e-6 * side.dot(omega * side))
  assert: CHECK(side.dot(omega * side) > 0.01)

