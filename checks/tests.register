  assert: CHECK(model.config().use_consistency)

[case] tests/gui_view_model_test.cpp :: gui view-model: a run on a folder that doesn't exist doesn't start
  markers: -
  assert: CHECK_FALSE(model.start_run((fs::temp_directory_path() / "lo_gui_view_model_test_no_such_folder").string()))
  assert: CHECK_FALSE(model.running())
  assert: CHECK(notifier.load_failures.empty())
  assert: CHECK(model.run_parameters().empty())

[case] tests/gui_view_model_test.cpp :: gui view-model: a run on an empty folder fails to load
  markers: -
  assert: REQUIRE(model.load_parameters(file))
  assert: REQUIRE(model.start_run(folder.path.string()))
  assert: CHECK_FALSE(model.running())
  assert: REQUIRE(notifier.load_failures.size() == 1)
  assert: CHECK(notifier.load_failures[0] == folder.path.string())
  assert: CHECK(notifier.saved == 0)
  assert: CHECK(model.run_parameters() == file)
  assert: CHECK(model.working_directory().empty())
  assert: CHECK_FALSE(fs::exists(folder.path / "cache"))

[case] tests/gui_view_model_test.cpp :: gui progress: finished windows are read only during the odometry, and a stage change waits for a read
  markers: -
  value: int reads = 0
  value: std::size_t seen = 0
  assert: CHECK(reads == 0)
  number: progress.progress(5, 10)
  assert: CHECK(reads == 1)
  assert: CHECK(seen == 5)
  number: std::this_thread::sleep_for(std::chrono::milliseconds(50))
  assert: CHECK_FALSE(changed.load())
  assert: CHECK(progress.stage() == RunStage::Odometry)
  assert: CHECK(changed.load())
  assert: CHECK(progress.stage() == RunStage::LoopClosure)
  assert: CHECK(reads == 1)

[case] tests/gui_view_model_test.cpp :: gui progress: pause holds the run at its next checkpoint until resume; reset starts afresh
  markers: -
  number: progress.progress(3, 10)
  assert: CHECK(progress.windows_done() == 3)
  assert: CHECK(progress.fraction() == doctest::Approx(0.3))
  number: std::this_thread::sleep_for(std::chrono::milliseconds(50))
  assert: CHECK_FALSE(passed.load())
  assert: CHECK(passed.load())
  assert: CHECK_FALSE(progress.paused())
  assert: CHECK(progress.windows_done() == 0)
  assert: CHECK(progress.stage() == RunStage::Loading)
  assert: CHECK(progress.fraction() == 0.0f)

