  value: check_acc_gradient() :: const double gradient = (ep.motion_cost - em.motion_cost) / (2.0 * h)
  value: check_acc_gradient() :: const double scale = std::max({std::abs(gradient), std::abs(e0.rhs(c, 0)), 1e-9 * e0.motion_cost, 1e-12})
  assert: check_acc_gradient() :: CHECK(std::abs(e0.rhs(c, 0) + 0.5 * gradient) <= tolerance * scale)
  value: make_acc_case() :: constexpr int n = 30
  value: make_follow_case() :: constexpr int n = 30
