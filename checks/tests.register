[case] tests/fusion_orientation_test.cpp :: Fusion adapter reset matches Fusion with the public gain settings throughout startup
  markers: -
  loop: for (auto convention : {AxesConvention::Nwu, AxesConvention::Enu, AxesConvention::Ned})
  number: filter.reset(convention,.05f)
  value: FusionAhrsSettings settings{convention==AxesConvention::Nwu ? FusionConventionNwu : convention==AxesConvention::Enu ? FusionConventionEnu : FusionConventionNed, .05f,90.f,90.f,0}
  loop: for (int i=0;i<2200;++i)
  value: const Eigen::Vector3f acc(.2f,0,1)
  number: filter.update({0,0,2},acc,.002f)
  number: FusionVector gyro{0,0,2}, acceleration{.2f,0,1}, zero{0,0,0}
  number: FusionAhrsUpdate(&reference,gyro,acceleration,zero,.002f)
  assert: CHECK(actual.w()==q.element.w)
  assert: CHECK(actual.x()==q.element.x)
  assert: CHECK(actual.y()==q.element.y)
  assert: CHECK(actual.z()==q.element.z)
  number: filter.reset(convention,.05f)
  assert: CHECK(angle(filter.orientation(),Eigen::Quaternionf::Identity())<1e-6)

