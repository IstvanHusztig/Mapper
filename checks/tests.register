[case] tests/synthetic_inertial_test.cpp :: synthetic IMU: planted white noise at 1.05 and 1/1.05, rejections counted (measured, not required)
  markers: skip
  value: const double n_gyro = 160.0 / (o.dt_ns * 1e-9) - 1, n_acc = 160.0 / (o.dt_ns * 1e-9)
  number: MESSAGE("sigma ratio detected with 90 % power at alpha 1e-4: gyro (" << n_gyro - 1 << " dof) " << sigma_ratio_with_power(n_gyro - 1, 1e-4, 0.9) << ", accelerometer (" << n_acc - 1 << " dof) " << sigma_ratio_with_power(n_acc - 1, 1e-4, 0.9))
  loop: for (const double factor : {1.05, 1.0 / 1.05})
  value: int gyro_rejected = 0, accel_rejected = 0
  loop: for (int seed = 1; seed <= planted_seeds; seed++)
  value: const PlantedRejections r = planted_noise_check(factor, 1.0, seed)
  loop: for (int a = 0; a < 3; a++)
  number: MESSAGE("factor " << factor << ": gyro " << gyro_rejected << " of " << 3 * planted_seeds << " (seed, axis) rejected, accelerometer " << accel_rejected << " of " << 3 * planted_seeds)

[case] tests/synthetic_inertial_test.cpp :: synthetic IMU: planted random walks at 1.5 are rejected in at least 4 of 5 seeds
  markers: skip
  value: int gyro_rejected = 0, accel_rejected = 0
  loop: for (int seed = 1; seed <= planted_seeds; seed++)
  value: const PlantedRejections r = planted_noise_check(1.0, 1.5, seed)
  assert: CHECK(gyro_rejected >= 4)
  assert: CHECK(accel_rejected >= 4)

