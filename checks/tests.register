  loop: for (const bool shuffled : {false, true})
  loop: for (const int iterations : {1, 30})
  assert: CHECK(identical(single, multi))

[case] tests/scan_to_map_test.cpp :: scan-to-map: two multithreaded runs are identical, bit for bit
  markers: -
  loop: for (const bool use_corridor : {false, true})
  value: const MultithreadRun first = run_window(s, true, true, 30)
  value: const MultithreadRun second = run_window(s, true, true, 30)
  assert: CHECK(identical(first, second))

[case] tests/scan_to_map_test.cpp :: scan-to-map: reusing the Cholesky analyses changes nothing, bit for bit
  markers: -
  loop: for (const bool use_corridor : {false, true})
  value: const MultithreadRun without = run_window(s, true, false, 30)
  value: const MultithreadRun with = run_window(s, true, false, 30, &workspace)
  assert: CHECK(identical(without, with))
  assert: CHECK(workspace.damped.calls() == 30)
  assert: CHECK(workspace.damped.analyses() <= 3)
  assert: CHECK(workspace.covariance.calls() == 30)
  assert: CHECK(workspace.covariance.analyses() <= 3)

[case] tests/scan_to_map_test.cpp :: scan-to-map: stored cell inverses equal inverting on the spot, bit for bit
  markers: -
  loop: for (const bool use_corridor : {false, true})
  loop: for (const int iterations : {1, 30})
  assert: CHECK(identical(cached, on_the_spot))

[case] tests/scan_to_map_test.cpp :: scan-to-map: degeneracy-aware NDT terms leave the blind direction to the motion model
  markers: -
  value: const Eigen::Vector3d shift(0.05, 0.03, 0.0)
  value: const std::vector<Eigen::Affine3d> projected = run_projected(corridor(), shift, 0.1, 0.2, true)
  value: const std::vector<Eigen::Affine3d> plain = run_projected(corridor(), shift, 0.0, 0.0, true)
  number: [measure] along = across = 0.0
  loop: for (size_t k = 0; k < truth.size(); k++)
  number: [measure] along = std::max(along, std::abs(d.x() - shift.x() * (double(k) / double(truth.size() - 1))))
  value: double along = 0.0, across = 0.0, plain_along = 0.0, plain_across = 0.0
  number: MESSAGE("corridor: change along the axis ", along * 1000.0, " mm with projection, ", plain_along * 1000.0, " mm without; error across ", across * 1000.0, " mm with, ", plain_across * 1000.0, " mm without (30 mm before)")
  assert: CHECK(along < 0.002)
  assert: CHECK(across < 0.25 * 0.03)
  assert: CHECK(across <= plain_across + 0.001)
  value: const std::vector<Eigen::Affine3d> single = run_projected(corridor(), shift, 0.1, 0.2, false)
  loop: for (size_t k = 0; k < truth.size(); k++)
  assert: CHECK(projected[k].matrix() == single[k].matrix())

[case] tests/scan_to_map_test.cpp :: scan-to-map: degeneracy-aware NDT terms change nothing in a closed room
  markers: -
  value: const Eigen::Vector3d shift(0.02, -0.02, 0.01)
  value: const std::vector<Eigen::Affine3d> off = run_projected(room(), shift, 0.0, 0.0, true)
  value: const std::vector<Eigen::Affine3d> on = run_projected(room(), shift, 0.1, 0.2, true)
  loop: for (size_t k = 0; k < off.size(); k++)
  assert: CHECK(off[k].matrix() == on[k].matrix())

[case] tests/scan_to_map_test.cpp :: scan-to-map, imu always on: a blind corridor follows the accelerometer along its axis
  markers: -
  loop: for (int i = 0; i < n_nodes; i++)
  number: k.truth.push_back(pose(Eigen::Vector3d(walk_x(t), 0.0, 1.5) + grid_offset, 0.0))
  number: k.world_acceleration.push_back(Eigen::Vector3d(walk_a * std::sin(2.0 * pi * walk_f * t), 0.0, 0.0))
  number: k.guess = straight(walk_v0, 0.0)
  number: k.velocity_prior = Eigen::Vector3d(walk_v0, 0.0, 0.0)
  number: k.translation_sigma_m = 0.03
  value: const double t_end = (n_nodes - 1) * node_dt, w = 2.0 * pi * walk_f
  value: const double v_end = walk_v0 + walk_a / w * (1.0 - std::cos(w * t_end))
  number: MESSAGE("blind corridor, end error along the axis: guess ", guess_error * 1000.0, " mm, accelerometer off ", end_error(off) * 1000.0, " mm, always on ", end_error(on) * 1000.0, " mm; end velocity ", on.velocity.end.x(), " m/s (true ", v_end, ")")
  assert: CHECK(std::abs(end_error(on)) < 0.2 * std::abs(guess_error))
  assert: CHECK(std::abs(end_error(off)) > 0.5 * std::abs(guess_error))
  assert: CHECK(on.velocity.end.x() == doctest::Approx(v_end).epsilon(0.02))

[case] tests/scan_to_map_test.cpp :: scan-to-map, imu always on: a blind window at rest stays put
  markers: -
  number: k.truth = straight(0.0, 0.0)
  number: k.velocity_prior = Eigen::Vector3d(0.5, 0.0, 0.0)
  number: k.velocity_prior_sigma = 0.1
  number: MESSAGE("blind window at rest: largest position error ", e.position * 1000.0, " mm with the zero-velocity measurement, ", e_moving.position * 1000.0, " mm without; velocities ", rest.velocity.start.x(), " / ", rest.velocity.end.x(), " m/s")
  assert: CHECK(e.position < 0.003)
  assert: CHECK(std::abs(rest.velocity.end.x()) < 0.05)

