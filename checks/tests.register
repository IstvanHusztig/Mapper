[case] tests/truth_statistics_test.cpp :: exact control 2: the statistic and the chi-square quantiles on inputs with known values
  markers: -
  assert: CHECK(truth_stats::normalised_error(e, P) == doctest::Approx(0.25 + 4.0 / 9.0).epsilon(1e-14))
  assert: CHECK(truth_stats::normalised_error(Eigen::Vector2d(1.0, 1.0), P2) == doctest::Approx(2.0 / 3.0).epsilon(1e-14))
  assert: CHECK(truth_stats::normalised_error(e, 4.0 * P) == doctest::Approx(0.25 * (0.25 + 4.0 / 9.0)).epsilon(1e-14))
  assert: CHECK(truth_stats::chi2_cdf(2.0, x) == doctest::Approx(1.0 - std::exp(-x / 2)).epsilon(1e-12))
  assert: CHECK(truth_stats::chi2_cdf(4.0, x) == doctest::Approx(1.0 - std::exp(-x / 2) * (1.0 + x / 2)).epsilon(1e-12))
  assert: CHECK(truth_stats::chi2_cdf(1.0, x) == doctest::Approx(std::erf(std::sqrt(x / 2))).epsilon(1e-12))
  assert: CHECK(truth_stats::chi2_quantile(2.0, 0.5) == doctest::Approx(2.0 * std::log(2.0)).epsilon(1e-12))
  value: const Row table[] = { {1, 0.95, 3.841459, 5e-6}, {2, 0.95, 5.991465, 5e-6}, {5, 0.95, 11.07050, 5e-5}, {10, 0.95, 18.30704, 5e-5}, {10, 0.05, 3.940299, 5e-6}, {30, 0.95, 43.77298, 5e-5}, {100, 0.975, 129.5612, 5e-4}, {100, 0.025, 74.22193, 5e-4}, {200, 0.99, 249.4451, 5e-4}, {200, 0.01, 156.4320, 5e-4}, {1, 0.5, 0.4549364, 5e-7}, }
  assert: CHECK(std::abs(truth_stats::chi2_quantile(r.k, r.p) - r.value) < r.tol)
  assert: CHECK(truth_stats::chi2_cdf(r.k, truth_stats::chi2_quantile(r.k, r.p)) == doctest::Approx(r.p).epsilon(1e-10))
  value: const auto iv = truth_stats::chi2_interval(50.0, 0.01)
  assert: CHECK(truth_stats::chi2_cdf(50.0, iv.second) - truth_stats::chi2_cdf(50.0, iv.first) == doctest::Approx(0.99).epsilon(1e-10))
  value: const double low = truth_stats::power_of_variance_ratio(200.0, 1.5, 0.01)
  value: const double high = truth_stats::power_of_variance_ratio(200.0, 1.0 / 1.5, 0.01)
  assert: CHECK(low == doctest::Approx(0.92).epsilon(0.01))
  assert: CHECK(high == doctest::Approx(0.94).epsilon(0.01))
  assert: CHECK(truth_stats::power_of_variance_ratio(200.0, 1.0, 0.01) == doctest::Approx(0.005).epsilon(1e-6))
  assert: CHECK(a.normal() == b.normal())
  value: const int n = 20000
  assert: CHECK(std::abs(s / n) < 4.0 / std::sqrt(double(n)))
  assert: CHECK(std::abs(s2 / n - 1.0) < 4.0 * std::sqrt(2.0 / n))

[case] tests/truth_statistics_test.cpp :: exact control 3: the power plan, and the honest chain lies inside its interval
  markers: -
  value: const auto plan = truth_stats::runs_for_power(2, 1.5, 0.01, 1, 0.9)
  assert: REQUIRE(plan.runs > 0)
  assert: CHECK(plan.power_low_side >= 0.9)
  assert: CHECK(plan.power_high_side >= 0.9)
  value: const double k1 = (plan.runs - 1) * 2.0
  assert: CHECK(std::min(truth_stats::power_of_variance_ratio(k1, 1.5, 0.01), truth_stats::power_of_variance_ratio(k1, 1.0 / 1.5, 0.01)) < 0.9)
  assert: CHECK(truth_stats::runs_for_power(2, 1.5, 0.01, 3, 0.9).runs > plan.runs)
  assert: CHECK(truth_stats::runs_for_power(2, 1.25, 0.01, 1, 0.9).runs > plan.runs)
  value: const auto interval = truth_stats::chi2_interval(plan.degrees_of_freedom, 0.01)
  value: const double s = summed_normalised_error(c, 1001, plan.runs, 1.0)
  call: summed_normalised_error(c, 1001, plan.runs, 1.0)
  assert: CHECK(inside(s, interval))
  call: summed_normalised_error(c, seed, plan.runs, 1.0)
  assert: CHECK(rejected <= 10)

[case] tests/truth_statistics_test.cpp :: exact control 4: the reported covariance x1.5 and /1.5 are rejected, low and high
  markers: -
  value: const auto plan = truth_stats::runs_for_power(2, 1.5, 0.01, 1, 0.9)
  assert: REQUIRE(plan.runs > 0)
  value: const auto interval = truth_stats::chi2_interval(plan.degrees_of_freedom, 0.01)
  value: const double s_large = summed_normalised_error(c, 3001, plan.runs, 1.5)
  call: summed_normalised_error(c, 3001, plan.runs, 1.5)
  value: const double s_small = summed_normalised_error(c, 3001, plan.runs, 1.0 / 1.5)
  call: summed_normalised_error(c, 3001, plan.runs, 1.0 / 1.5)
  assert: CHECK(s_large < interval.first)
  assert: CHECK(s_small > interval.second)
  assert: CHECK_FALSE(inside(s_large, interval))
  assert: CHECK_FALSE(inside(s_small, interval))
  call: summed_normalised_error(c, seed, plan.runs, 1.5)
  call: summed_normalised_error(c, seed, plan.runs, 1.0 / 1.5)
  assert: CHECK(low_hits >= 160)
  assert: CHECK(high_hits >= 160)

[case] tests/truth_statistics_test.cpp :: exact control 5: the normalised move averages 1, the old form 0.5
  markers: -
  value: const double m = 2.0, s2 = 0.04, s = std::sqrt(s2)
  value: const int N = 20000
  value: const double post = (m + z) / 2.0
  value: const double q = old_form / (1.0 - (s2 / 2.0) / s2)
  assert: CHECK(std::abs(mean_q - 1.0) < 4.0 * se_q)
  assert: CHECK(std::abs(mean_old - 0.5) < 4.0 * se_old)
  value: const Eigen::Vector3d m(1.0, -1.0, 0.5)
  value: const double trace_reduction = 3.0 - (P.llt().solve(Ppost)).trace()
  value: const int N = 20000
  assert: CHECK(std::abs(mean - 1.0) < 4.0 * se)

