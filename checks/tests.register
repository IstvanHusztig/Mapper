[case] tests/test_verification_tools.py :: CompareBaselineTests.test_a_manifest_written_from_a_folder_is_identical_to_it_and_to_its_twin
  markers: -
  assert: self.assertEqual((code, out.strip()), (0, f'wrote {manifest} (5 files)'))
  assert: self.assertEqual((written['dataset'], written['params'], len(written['files'])), ('known', 'p.toml', 5))
  assert: self.assertEqual(self.run_tool(self.a, manifest), (0, 'IDENTICAL: 5 files\n'))
  assert: self.assertEqual(self.run_tool(self.b, manifest), (0, 'IDENTICAL: 5 files\n'))
  assert: self.assertEqual(code, 1)
  assert: self.assertIn('different scan_lio_0.laz', out.splitlines())
  assert: self.assertIn('DIFFERENT: 1 of 5 files', out)

[file] tests/toml_config_repository_test.cpp

[case] tests/toml_config_repository_test.cpp :: TomlConfigRepository saves and loads the settings
  markers: -
  assert: [defaults] REQUIRE(repo.save(file.string(), config, paths, gui))
  number: loaded.decimation = 123.0
  assert: [defaults] REQUIRE(repo.load(file.string(), loaded, loaded_paths, loaded_gui))
  assert: [defaults] CHECK(loaded.decimation == config.decimation)
  assert: [defaults] CHECK(loaded.nr_iter == config.nr_iter)
  assert: [defaults] CHECK(loaded.use_loop_closure == config.use_loop_closure)
  number: config.nr_iter = 77
  number: config.decimation = 0.0625
  number: gui.clear_color[0] = 0.25f
  assert: [changed values of each kind] REQUIRE(repo.save(file.string(), config, paths, gui))
  assert: [changed values of each kind] REQUIRE(repo.load(file.string(), loaded, loaded_paths, loaded_gui))
  assert: [changed values of each kind] CHECK(loaded.use_loop_closure == config.use_loop_closure)
  assert: [changed values of each kind] CHECK(loaded.nr_iter == 77)
  assert: [changed values of each kind] CHECK(loaded.decimation == 0.0625)
  assert: [changed values of each kind] CHECK(loaded.config_version == "test-version")
  assert: [changed values of each kind] CHECK(loaded.software_version == dmapper_version())
  assert: [changed values of each kind] CHECK(loaded_paths.current_output_dir == "out_dir")
  assert: [changed values of each kind] CHECK(loaded_paths.working_directory_preview == "preview_dir")
  assert: [changed values of each kind] CHECK(loaded_gui.clear_color[0] == 0.25f)
  assert: [missing file] CHECK_FALSE(repo.load((fs::temp_directory_path() / "lidar_odometry_tests_no_such_file.toml").string(), loaded, loaded_paths, loaded_gui))

