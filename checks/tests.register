  assert: CHECK(loop_closure_replay_settings(older, quantile).changed == std::vector<std::string>{"loop_closure_match_check_quantile"})
  assert: CHECK(kernel_off.refused.empty())
  assert: CHECK(kernel_off.changed.empty())
  assert: CHECK(loop_closure_replay_settings(with_kernel, captured).refused == std::vector<std::string>{"loop_closure_kernel_scale"})

