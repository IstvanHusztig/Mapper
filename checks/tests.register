[case] tests/odometry_snapshot_test.cpp :: odometry snapshot: restore refuses another recording and takes the windows and run state otherwise
  markers: -
  number: fewer.windows.assign(snapshot.windows.begin(), snapshot.windows.end() - 1)
  assert: CHECK_FALSE(fewer.restore_odometry(snapshot, why))
  assert: CHECK(why.find("windows") != std::string::npos)
  number: other_time.windows[3].timestamps[2].first += 1e-6
  assert: CHECK_FALSE(other_time.restore_odometry(snapshot, why))
  assert: CHECK(why.find("window 4") != std::string::npos)
  number: pipeline.windows = loop_recording(1).windows
  assert: REQUIRE(pipeline.restore_odometry(snapshot, why))
  assert: CHECK(same(pipeline.windows, snapshot.windows))
  assert: CHECK(same(pipeline.state.m_g, snapshot.m_g))
  assert: CHECK(pipeline.state.total_length_of_calculated_trajectory == snapshot.total_length_of_calculated_trajectory)
  assert: CHECK(pipeline.state.consecutive_distance == snapshot.consecutive_distance)
  assert: CHECK(same(pipeline.snapshot().windows, snapshot.windows))

[case] tests/odometry_snapshot_test.cpp :: odometry snapshot: the post-processing after a restore gives the same windows as after the odometry
  markers: -
  value: Recording r = loop_recording(1)
  value: std::mt19937 rng(3)
  value: std::uniform_real_distribution<double> shift(-0.02, 0.02)
  loop: for (size_t w = 1; w < r.windows.size(); w++)
  number: config.num_constistency_iter = 2
  number: config.in_out_params_indoor.resolution_X = config.in_out_params_indoor.resolution_Y = config.in_out_params_indoor.resolution_Z = 0.15
  loop: for (size_t w = 0; w < r.points.size(); w++)
  assert: REQUIRE(write_odometry_snapshot(file.path, written, config, why))
  assert: REQUIRE(read_odometry_snapshot(file.path, config, read, why))
  assert: CHECK(same(restored, direct))

