  assert: REQUIRE(c.store.load(PointSet::WindowOriginal, i, points))
  assert: CHECK(p.timestamp > ts.front().first)
  number: if (p.index_pose == static_cast<int>(ts.size()) - 1)
  assert: CHECK(found == expected)
  assert: CHECK(in_gaps == c.windows.size() * 100)
  assert: CHECK(gaps_at_last_node == in_gaps)

