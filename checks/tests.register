[case] tests/holdout_test.cpp :: hold-out: odd blocks are left out, even blocks kept, 0 keeps everything
  markers: -
  assert: CHECK_FALSE(is_held_out(0.004, 0.01))
  assert: CHECK(is_held_out(0.015, 0.01))
  assert: CHECK_FALSE(is_held_out(0.025, 0.01))
  assert: CHECK(is_held_out(-0.005, 0.01))
  assert: CHECK_FALSE(is_held_out(0.015, 0.0))
  value: std::vector<Point3Di> points(6)
  loop: for (int i = 0; i < 6; i++)
  number: points[i].timestamp = 0.005 + 0.01 * i
  number: remove_held_out(kept, 0.01)
  assert: REQUIRE(kept.size() == 3)
  loop: for (int i = 0; i < 3; i++)
  assert: CHECK(kept[i].timestamp == doctest::Approx(0.005 + 0.02 * i))
  number: remove_held_out(all, 0.0)
  assert: CHECK(all.size() == 6)

