[case] tests/ndt_map_test.cpp :: update_rgd exact: the far side of a thin wall doesn't enter the near side's cell
  markers: -
  loop: for (int i = 0; i < 9; i++)
  loop: for (int j = 0; j < 9; j++)
  number: [side] points.push_back(make_point(Eigen::Vector3d(x, 0.55 + 0.05 * i, 0.55 + 0.05 * j)))
