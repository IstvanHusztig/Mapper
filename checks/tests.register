  value: const double trace_reduction = 3.0 - (P.llt().solve(Ppost)).trace()
  value: Rng rng(78)
  value: const int N = 20000
  value: double sum = 0, sum2 = 0
  loop: for (int i = 0; i < N; ++i)
  assert: CHECK(std::abs(mean - 1.0) < 4.0 * se)

