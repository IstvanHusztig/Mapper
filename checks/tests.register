[case] tests/normal_equations_test.cpp :: PatternCachedCholesky: the analysis is kept for the same pattern and redone for another, results unchanged
  markers: -
  value: const int n = 300
  value: const Eigen::VectorXd b = Eigen::VectorXd::LinSpaced(n, -1.0, 1.0)
  value: const Eigen::SparseMatrix<double> a = spd_band(n, 7, seed)
  call: solve_with(cached, a, b)
  call: solve_with(fresh, a, b)
  assert: CHECK(x == y)
  assert: CHECK((a * x - b).norm() < 1e-9 * b.norm())
  assert: CHECK(cached.calls() == 5)
  assert: CHECK(cached.analyses() == 1)
  value: const Eigen::SparseMatrix<double> a = spd_band(n, 7, seed, true)
  call: solve_with(cached, a, b)
  assert: CHECK(x == solve_with(fresh, a, b))
  call: solve_with(fresh, a, b)
  assert: CHECK(cached.calls() == 8)
  assert: CHECK(cached.analyses() == 2)
  value: const Eigen::VectorXd b2 = Eigen::VectorXd::Ones(n + 10)
  value: const Eigen::SparseMatrix<double> a2 = spd_band(n + 10, 7, 9)
  assert: CHECK(solve_with(cached, a2, b2) == solve_with(fresh2, a2, b2))
  call: solve_with(cached, a2, b2)
  call: solve_with(fresh2, a2, b2)
  assert: CHECK(cached.analyses() == 3)

