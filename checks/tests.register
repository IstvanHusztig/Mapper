[case] tests/test_verification_tools.py :: VerificationTests.test_snapshot_world_frame_and_corruption
  markers: -
  assert: self.assertEqual(snapshot.load_snapshot(p), [(Decimal(1000000000.0), 4.0, 5.0, 6.0), (Decimal(2000000000.0), 4.0, 5.0, 6.0)])
  assert: self.assertEqual(len(snapshot.load_snapshot(p)), 2)
  number: variants = [good[:n] for n in (0, 8, 12, 28, 40, len(good) - 1)]
  number: variants += [good + b'x', b'BADMAGIC' + good[8:], good[:8] + struct.pack('<I', 2) + good[12:], good[:28] + struct.pack('<Q', 2 ** 63) + good[36:], snapshot_bytes((1.0, 1.0)), snapshot_bytes((2.0, 1.0)), snapshot_bytes((1.0, math.nan))]
  assert: self.assertRaises((ValueError, ArithmeticError))
  guarded: snapshot.load_snapshot(p)

[case] tests/test_verification_tools.py :: VerificationTests.test_missing_diagnostics_never_success
  markers: -
  number: p.write_text(log_text().splitlines()[0] + '\nProcessing time: 1 [s]\n')
  assert: self.assertTrue({'bend', 'speed', 'bias'}.issubset(r['missing_required']))
  assert: self.assertEqual(proc.returncode, 2)
  assert: self.assertIn('NOT MEASURED', proc.stdout)
  assert: self.assertNotIn('result: PASS', proc.stdout)
  assert: self.assertFalse(health.analyse(p)['completed'])
  assert: self.assertEqual(health.analyse(p)['missing_required'], [])
  assert: self.assertEqual(health.analyse(p)['coverage']['chi2'], 0)
  assert: self.assertIn('expected total window coverage NOT ESTABLISHED', health.analyse(p)['missing_required'])

