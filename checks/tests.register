  assert: CHECK(same_floor_revisits(out_and_back, 3, c) == std::vector<int>{0})
  value: const std::vector<RevisitSegment> straight = {segment_at(0.0, 0.0, 0.0, 4.5), segment_at(4.5, 0.0, 4.5, 9.0), segment_at(9.0, 0.0, 9.0, 13.5), segment_at(13.5, 0.0, 13.5, 18.0)}
  assert: CHECK(same_floor_revisits(straight, 3, c).empty())
  value: const std::vector<RevisitSegment> standing = {segment_at(0.0, 0.0, 0.0, 0.0), segment_at(0.1, 0.0, 0.0, 0.0), segment_at(0.0, 0.1, 0.0, 0.0)}
  assert: CHECK(same_floor_revisits(standing, 2, c).empty())
  value: const std::vector<RevisitSegment> afar = {segment_at(0.0, 0.0, 0.0, 0.0), segment_at(6.8, 0.0, 8.6, 13.0)}
  assert: CHECK(same_floor_revisits(afar, 1, c).empty())
  number: upstairs[3].center.z() = 2.8
  assert: CHECK(same_floor_revisits(upstairs, 3, c).empty())

