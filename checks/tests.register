  assert: CHECK(refused("[lidar_odometry_control]\nnr_iter = 3.5\n"))
  assert: CHECK(refused("[in_out_params_indoor]\nresolution_W = 0.3\n"))

[case] tests/toml_golden_test.cpp :: a retired setting is ignored at the value the code kept and refused otherwise
  markers: -
  assert: CHECK(loads("[consistency]\nuse_mutliple_gaussian = false\nconsistency_min_distance = 0.4\n"))
  assert: CHECK(loads("[imu_translation]\ndegenerate_projection_all_point_normals = false\nndt_unmatched_point_cost = 0.0\n"))
  assert: CHECK(loads("[imu_translation]\nndt_unmatched_point_cost = 0\n"))
  assert: CHECK(loads("[robust_lidar_odometry]\nuse_robust_and_accurate_lidar_odometry = false\ndistance_bucket = 0.2\n"))
  assert: CHECK(loads("[imu_translation]\nimu_carry_joint_covariance = false\nimu_accel_window_sigma_mps2 = 0.0\n"))
  assert: CHECK(loads("[loop_closure]\nloop_closure_kernel_scale = 0.0\n"))
  assert: CHECK_FALSE(loads("[consistency]\nuse_mutliple_gaussian = true\n"))
  assert: CHECK_FALSE(loads("[imu_translation]\ncarried_covariance_normal_information_only = true\n"))
  assert: CHECK_FALSE(loads("[imu_translation]\nndt_unmatched_point_cost = 16.0\n"))
  assert: CHECK_FALSE(loads("[robust_lidar_odometry]\nuse_robust_and_accurate_lidar_odometry = true\n"))
  assert: CHECK_FALSE(loads("[imu_translation]\nimu_carry_joint_covariance = true\n"))
  assert: CHECK_FALSE(loads("[imu_translation]\nimu_accel_window_sigma_mps2 = 0.05\n"))
  assert: CHECK_FALSE(loads("[loop_closure]\nloop_closure_kernel_scale = 0.5\n"))
  assert: CHECK_FALSE(loads("[robust_lidar_odometry]\nno_such_setting = 1.0\n"))
  assert: CHECK(check("[motion_model_uncertainty]\nturn_rate_threshold_deg_s = 30.0\n", ignored).empty())
  assert: REQUIRE(ignored.size() == 1)
  assert: CHECK(ignored[0] == "'turn_rate_threshold_deg_s' in [motion_model_uncertainty]: setting removed from dMapper, ignored")
  assert: CHECK(check("[motion_model_uncertainty]\nturn_rate_threshold_deg_s = 30\n", ignored).empty())
  assert: REQUIRE(refused.size() == 1)
  assert: CHECK(refused[0] == "'turn_rate_threshold_deg_s' in [motion_model_uncertainty]: setting removed from dMapper; only 30 (the " "behaviour that remains) is accepted")
  assert: CHECK(loads("[motion_model_uncertainty]\nturn_rate_threshold_deg_s = 30.0\n"))
  assert: CHECK_FALSE(loads("[motion_model_uncertainty]\nturn_rate_threshold_deg_s = 45.0\n"))

[file] tests/truth_statistics.cpp
  number: regularised_gamma_p() :: if (!(a > 0.0) || x < 0.0)
  number: regularised_gamma_p() :: if (x == 0.0)
  number: regularised_gamma_p() :: return 0.0
  value: regularised_gamma_p() :: const double eps = 1e-16
  number: regularised_gamma_p() :: if (x < a + 1.0)
  value: regularised_gamma_p() :: double term = 1.0 / a
  loop: regularised_gamma_p() :: for (int n = 1; n < 100000; ++n)
  value: regularised_gamma_p() :: const double tiny = 1e-300
  value: regularised_gamma_p() :: double b = x + 1.0 - a
  value: regularised_gamma_p() :: double c = 1.0 / tiny
  value: regularised_gamma_p() :: double d = 1.0 / b
  loop: regularised_gamma_p() :: for (int i = 1; i < 100000; ++i)
  number: regularised_gamma_p() :: b += 2.0
  number: regularised_gamma_p() :: d = 1.0 / d
  number: regularised_gamma_p() :: if (std::abs(delta - 1.0) < eps)
  number: regularised_gamma_p() :: return 1.0 - std::exp(log_prefix) * h
  number: chi2_cdf() :: if (!(k > 0.0))
  number: chi2_cdf() :: if (x <= 0.0)
  number: chi2_cdf() :: return 0.0
  number: chi2_cdf() :: return regularised_gamma_p(0.5 * k, 0.5 * x)
  number: chi2_quantile() :: if (!(p > 0.0 && p < 1.0))
  value: chi2_quantile() :: double lo = 0.0
  value: chi2_quantile() :: double hi = k + 10.0 * std::sqrt(2.0 * k) + 10.0
  number: chi2_quantile() :: hi *= 2.0
  loop: chi2_quantile() :: for (int i = 0; i < 300; ++i)
  value: chi2_quantile() :: const double mid = 0.5 * (lo + hi)
  number: chi2_quantile() :: if (hi - lo <= 1e-14 * hi)
  number: chi2_quantile() :: return 0.5 * (lo + hi)
  number: chi2_interval() :: return {chi2_quantile(k, 0.5 * alpha), chi2_quantile(k, 1.0 - 0.5 * alpha)}
  number: power_of_variance_ratio() :: if (ratio >= 1.0)
  number: power_of_variance_ratio() :: return 1.0 - chi2_cdf(k, ratio * hi)
  number: runs_for_power() :: if (dof_per_run < 1 || !(multiplier > 1.0) || primary_comparisons < 1)
  loop: runs_for_power() :: for (int m = 1; m <= max_runs; ++m)
  value: runs_for_power() :: const double high = power_of_variance_ratio(k, 1.0 / multiplier, plan.alpha_per_comparison)
  number: next_bits() :: state_ += 0x9E3779B97F4A7C15ull
  number: next_bits() :: z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull
  number: next_bits() :: z = (z ^ (z >> 27)) * 0x94D049BB133111EBull
  number: next_bits() :: return z ^ (z >> 31)
  number: uniform() :: return (static_cast<double>(next_bits() >> 11) + 0.5) * (1.0 / 9007199254740992.0)
  value: normal() :: const double r = std::sqrt(-2.0 * std::log(u1))
  value: normal() :: const double a = 6.283185307179586476925286766559 * u2
  loop: normal_vector() :: for (int i = 0; i < n; ++i)

