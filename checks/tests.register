[case] tests/recording_files_test.cpp :: load_imu scales the gyro as parsed, one rounding to float, axes at 1 untouched
  markers: -
  value: const std::vector<std::array<double, 3>> gyro = {{0.00301514565944672, -0.01316380687057972, -0.00219087721779943}, {-0.00337643921375275, 0.00707621872425079, -0.00645193504169583}, {0.51234567890123456, -1.2345678901234567, 2.3456789012345678}}
  number: out << std::setprecision(17)
  loop: for (std::size_t i = 0; i < gyro.size(); ++i)
  number: out << gyro[i][0] << " " << gyro[i][1] << " " << gyro[i][2] << " 0.1 0.2 0.97 0 " << (i + 1) * 2000000 << " " << 1794586153591994709LL + (long long)i * 2000000 << "\n"
  value: const Imu plain = load_imu(file.string(), 0, logger)
  number: calibration.gyro_scale = Eigen::Vector3d(1.0, 1.0, 1.004)
  value: const Imu scaled = load_imu(file.string(), 0, logger, calibration)
  assert: REQUIRE(plain.size() == gyro.size())
  assert: REQUIRE(scaled.size() == gyro.size())
  loop: for (std::size_t i = 0; i < gyro.size(); ++i)
  assert: CHECK(plain[i].gyro.x() == static_cast<float>(gyro[i][0]))
  assert: CHECK(plain[i].gyro.z() == static_cast<float>(gyro[i][2]))
  assert: CHECK(scaled[i].gyro.x() == plain[i].gyro.x())
  assert: CHECK(scaled[i].gyro.y() == plain[i].gyro.y())
  assert: CHECK(scaled[i].gyro.z() == static_cast<float>(gyro[i][2] * 1.004))
  assert: CHECK(scaled[i].acc == plain[i].acc)
  assert: CHECK(scaled[i].timestamps == plain[i].timestamps)

[file] tests/run_reporting_test.cpp

[case] tests/run_reporting_test.cpp :: LogMessage writes one whole message without the trailing newline
  markers: -
  number: log_info(logger) << "loaded " << 3 << " files" << std::endl
  assert: REQUIRE(logger.messages.size() == 3)
  assert: CHECK(logger.messages[0] == std::make_pair(LogLevel::Info, std::string("loaded 3 files")))
  assert: CHECK(logger.messages[1] == std::make_pair(LogLevel::Warning, std::string("part one, part two")))
  assert: CHECK(logger.messages[2] == std::make_pair(LogLevel::Error, std::string("a\nb")))

[case] tests/run_reporting_test.cpp :: LogMessage stream state does not carry over to the next message
  markers: -
  number: log_info(logger) << std::fixed << std::setprecision(10) << 0.5
  number: log_info(logger) << 0.5
  assert: REQUIRE(logger.messages.size() == 2)
  assert: CHECK(logger.messages[0].second == "0.5000000000")
  assert: CHECK(logger.messages[1].second == "0.5")

[case] tests/run_reporting_test.cpp :: ConsoleReporter sends info and debug to out, warnings and errors to err
  markers: -
  assert: CHECK(out.str() == "d\ni\n")
  assert: CHECK(err.str() == "w\ne\n")

[case] tests/run_reporting_test.cpp :: ConsoleReporter keeps lines whole when written from many threads
  markers: -
  value: constexpr int threads = 8, per_thread = 1000
  loop: for (int t = 0; t < threads; t++)
  loop: for (int i = 0; i < per_thread; i++)
  assert: REQUIRE(lines.size() == threads * per_thread)
  assert: REQUIRE(line.rfind("thread ", 0) == 0)
  assert: REQUIRE(line.size() >= 4)
  assert: REQUIRE(line.substr(line.size() - 4) == " end")
  assert: REQUIRE(line.find("thread ", 1) == std::string::npos)

[case] tests/run_reporting_test.cpp :: ConsoleReporter stage lines and the loading counter
  markers: -
  number: console.progress(1, 3)
  number: console.progress(2, 3)
  number: console.progress(3, 3)
  number: console.progress(1, 4)
  number: console.progress(1, 10)
  assert: CHECK(out.str() == "[stage] Loading\n" "\rrunning iterations: 1/3\rrunning iterations: 2/3\n" "message while counting\n" "\rrunning iterations: 3 (done)\n" "after loading\n" "\rrunning iterations: 1/4\n" "[stage] Odometry\n" "window 1\n")
  assert: CHECK(err.str().empty())

