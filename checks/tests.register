[case] tests/loop_fine_time_test.cpp :: loop fine time: sums are made in numpy's order
  markers: -
  value: const double p[7] = {1.0, 10.0, 100.0, 1000.0, 10000.0, 100000.0, 1000000.0}
  loop: for (int i = 0; i < n; i++)
  number: [values] a.push_back(((i % 13) - 6.0) * p[i % 7] / 3.0)
  value: const std::vector<double> a7 = values(7), a100 = values(100), a300 = values(300)
  assert: CHECK(fine_time_pairwise_sum(a7.data(), a7.size()) == -41152.0)
  assert: CHECK(fine_time_pairwise_sum(a100.data(), a100.size()) == -41144.99999999938)
  assert: CHECK(fine_time_pairwise_sum(a300.data(), a300.size()) == -1672015.9999999984)
  assert: CHECK(fine_time_pairwise_sum(a300.data(), a300.size()) / 300.0 == -5573.386666666661)
  assert: CHECK(fine_time_pairwise_sum(nullptr, 0) == 0.0)

