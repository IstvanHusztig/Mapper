[case] tests/orientation_test.cpp :: orientation: time steps, and one trajectory node per timestamp with the filter's orientation
  markers: -
  value: Imu imu = still_imu(3, Eigen::Vector3f::Zero())
  assert: REQUIRE(e.updates.size() == 4)
  assert: CHECK(e.updates[0].dt_s == static_cast<float>(1.0 / 200.0))
  assert: CHECK(e.updates[1].dt_s == doctest::Approx(0.005).epsilon(1e-6))
  assert: CHECK(e.updates[3].dt_s == static_cast<float>(0.002))
  assert: CHECK(trajectory.size() == 3)
  assert: CHECK((node.first.topLeftCorner<3, 3>() - expected).norm() < 1e-6)
  assert: CHECK(node.first.topRightCorner<3, 1>().norm() == 0.0)
  assert: CHECK(node.second == doctest::Approx(time + 999.0))

