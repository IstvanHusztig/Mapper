[case] tests/synthetic_inertial_test.cpp :: synthetic motion: derivatives agree and segments join smoothly
  markers: -
  value: const double h = 1e-5
  value: double worst_v = 0, worst_a = 0, worst_w = 0, worst_join = 0
  loop: for (double t = 0.01; t < m.duration() - 0.01; t += 0.00731)
  number: worst_v = std::max(worst_v, ((b.position - a.position) / (2 * h) - c.velocity).norm())
  number: worst_a = std::max(worst_a, ((b.velocity - a.velocity) / (2 * h) - c.acceleration).norm())
  number: worst_w = std::max(worst_w, (aa.axis() * aa.angle() / (2 * h) - c.body_rate).norm())
  loop: for (double t : {1.0, 3.0, 4.0, 6.0, 8.0, 10.0, 10.5, 13.5})
  value: const MotionState a = m.state(t - 1e-9), b = m.state(t + 1e-9)
  number: worst_join = std::max({worst_join, (a.position - b.position).norm(), (a.velocity - b.velocity).norm() * 1e3, (a.acceleration - b.acceleration).norm() * 1e3, (a.body_rate - b.body_rate).norm() * 1e3})
  assert: CHECK(worst_v < 1e-7)
  assert: CHECK(worst_a < 1e-6)
  assert: CHECK(worst_w < 1e-6)
  assert: CHECK(worst_join < 1e-4)
  assert: CHECK(m.at_rest(0.0, 1.0))
  assert: CHECK_FALSE(m.at_rest(0.0, 1.5))
  assert: CHECK(m.first_motion_time() == doctest::Approx(1.0))
  assert: CHECK(m.end_speed() == doctest::Approx(0.0).epsilon(1e-9))

