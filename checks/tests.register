[case] tests/unit_cases_inertial_test.cpp :: unit case K3: the start velocity prior's mean over a 2 ms gap, at constant acceleration
  markers: -
  loop: for (double a : {0.0, 1.0, 2.0})
  value: const Chain chain = make_chain(a, 0.5)
  assert: CHECK(chain.gap_s == doctest::Approx(dt).epsilon(1e-9))
  assert: REQUIRE(run.ok)
  assert: CHECK(run.record.window == 3)
  assert: REQUIRE(run.record.prepared.velocity_prior_mean.has_value())
  assert: CHECK(prior.x() == run.carried_velocity.x())
  assert: CHECK(prior.y() == 0.0)
  assert: CHECK(prior.z() == 0.0)
  assert: CHECK(error == doctest::Approx(-a * chain.gap_s).epsilon(1e-6).scale(1.0))

[case] tests/unit_cases_inertial_test.cpp :: unit case K3 marker: the start velocity prior's mean equals the true start velocity
  markers: should_fail
  loop: for (double a : {1.0, 2.0})
  value: const Chain chain = make_chain(a, 0.5)
  assert: REQUIRE(run.ok)
  assert: REQUIRE(run.record.prepared.velocity_prior_mean.has_value())
  assert: CHECK(std::abs(error) < 1e-4)

[case] tests/unit_cases_inertial_test.cpp :: unit case K4: the tail re-propagation's last node and the next window's first pose against the truth
  markers: -
  value: const TailMeasurement one = measure_tail(1.0, 15, 10)
  value: const TailMeasurement two = measure_tail(2.0, 15, 10)
  assert: CHECK(one.last_node_error == doctest::Approx(-0.75e-3).epsilon(0.01))
  assert: CHECK(two.next_first_error == doctest::Approx(-1.66e-3).epsilon(0.01))
  assert: CHECK(two.last_node_error == doctest::Approx(2.0 * one.last_node_error).epsilon(1e-9))
  value: const TailMeasurement none = measure_tail(2.0, 0, 10)
  assert: CHECK(none.last_node_error == 0.0)
  value: const TailMeasurement shipped = measure_tail(2.0, 30, 20)

[case] tests/unit_cases_inertial_test.cpp :: unit case K4 marker: the tail re-propagation's last node and the next first pose equal the truth
  markers: should_fail
  loop: for (double a : {1.0, 2.0})
  value: const TailMeasurement m = measure_tail(a, 15, 10)
  assert: CHECK(std::abs(m.last_node_error) < 5e-5)
  assert: CHECK(std::abs(m.next_first_error) < 5e-5)

[case] tests/unit_cases_inertial_test.cpp :: unit case A2: a noise-free constant-velocity window is taken as at rest, and the zero-velocity term then holds it
  markers: -
  value: const double v = 2.0
  value: const Chain chain = make_chain(0.0, v)
  value: const Window &w = chain.windows[2]
  assert: CHECK(w.poses.back().translation().x() - w.poses.front().translation().x() > 0.7)
  value: const bool rests = window_rests(w.poses, w.timestamps, w.imu_acc, w.imu_angles, 1.0, 0.3, 3.0 * DEG_TO_RAD)
  assert: CHECK(rests)
  assert: REQUIRE_FALSE(rest_c.use_zero_velocity_detection)
  number: moving_c.zero_velocity_acc_threshold_mps2 = -1.0
  assert: REQUIRE(as_rest.ok)
  assert: REQUIRE(as_moving.ok)
  assert: CHECK(as_rest.record.at_rest)
  assert: CHECK_FALSE(as_moving.record.at_rest)
  assert: CHECK(as_moving.record.velocity_start.x() == doctest::Approx(v).epsilon(1e-3))
  assert: CHECK(as_moving.record.velocity_end.x() == doctest::Approx(v).epsilon(1e-3))
  assert: CHECK(std::abs(as_rest.record.velocity_end.x()) < 0.05)
  assert: CHECK(as_rest.record.velocity_start.x() < 1.0)
  assert: CHECK(as_rest.record.velocity_start.x() > 0.1)
  assert: CHECK(as_rest.record.result_move.x() < 0.1 * true_move)

[case] tests/unit_cases_inertial_test.cpp :: unit case K6: the rest test with a tilted open-loop filter attitude
  markers: -
  assert: CHECK(rests_at_tilt(0.0, 1))
  value: Window moving = motion_window(100.0, nodes, 0.0, 0.0, 0.5)
  assert: CHECK_FALSE(window_rests(moving.poses, moving.timestamps, moving.imu_acc, moving.imu_angles, 1.0, 0.3, 3.0 * DEG_TO_RAD))
  loop: for (double tilt : {0.5, 1.0, 1.5, 1.7, 1.75, 1.8, 2.0, 3.0})
  number: sweep << tilt << " deg: " << (rests_at_tilt(tilt, 1) ? "rest" : "NOT rest") << "; "
  value: const double pitch = tilt_threshold_deg(1)
  value: const double roll = tilt_threshold_deg(0)
  value: const double expected = 2.0 * std::asin(0.3 / (2.0 * g0)) / DEG_TO_RAD
  assert: CHECK(pitch == doctest::Approx(expected).epsilon(1e-3))
  assert: CHECK(roll == doctest::Approx(expected).epsilon(1e-3))
  assert: CHECK(rests_at_tilt(1.7, 1))
  assert: CHECK_FALSE(rests_at_tilt(1.8, 1))
  assert: CHECK(rests_at_tilt(2.8, 1, 0.5))
  assert: CHECK_FALSE(rests_at_tilt(3.0, 1, 0.5))

[case] tests/unit_cases_inertial_test.cpp :: unit case K6 marker: the rest test recognises rest at a filter tilt of 2 and 3 degrees
  markers: should_fail
  loop: for (double tilt : {2.0, 3.0})
  assert: CHECK(rests_at_tilt(tilt, 1))
  assert: CHECK(rests_at_tilt(tilt, 0))

