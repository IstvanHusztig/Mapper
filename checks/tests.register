  assert: CHECK(windows[i].poses[0].isApprox(windows[i - 1].poses.back(), 1e-12))
  value: const Eigen::Affine3d rel_new = windows[i].poses[k - 1].inverse() * windows[i].poses[k]
  value: const Eigen::Affine3d rel_old = original[i].poses[k - 1].inverse() * original[i].poses[k]
  assert: CHECK(rel_new.isApprox(rel_old, 1e-12))
  assert: [one call matches the old placement of all later windows after every window] CHECK((once[i].poses[k].matrix() - repeated[i].poses[k].matrix()).cwiseAbs().maxCoeff() < 1e-9)
  assert: [first = 0 and first = size change nothing] CHECK(w[i].poses[k].isApprox(original[i].poses[k], 0.0))

[case] tests/window_steps_test.cpp :: estimate_previous_velocity measures the previous window's final velocity
  markers: -
  value: const Window previous = moving_window(50, 1.5, 0.0)
  value: const PreviousVelocity v = estimate_previous_velocity(previous, 20, 5.0)
  assert: CHECK(v.use)
  assert: CHECK_FALSE(v.dropped)
  assert: CHECK(v.velocity.isApprox(Eigen::Vector3d(1.5, 0.0, 0.0), 1e-9))
  value: const PreviousVelocity fast = estimate_previous_velocity(moving_window(50, 7.0, 0.0), 20, 5.0)
  assert: CHECK_FALSE(fast.use)
  assert: CHECK(fast.dropped)
  assert: CHECK(fast.speed == doctest::Approx(7.0))
  assert: CHECK(fast.velocity == Eigen::Vector3d::Zero())
  assert: CHECK_FALSE(estimate_previous_velocity(moving_window(1, 1.5, 0.0), 20, 5.0).use)
  assert: CHECK_FALSE(estimate_previous_velocity(mismatched, 20, 5.0).use)

[case] tests/window_steps_test.cpp :: predict_window_poses guesses the window's motion
  markers: -
  value: const int n = 40
  value: const Window previous = moving_window(n, 1.0, 0.0, pose(3.0, 1.0, 0.0, 0.0))
  value: const Eigen::Vector3d v0(1.0, 0.0, 0.0)
  assert: [constant velocity from the previous window] CHECK_FALSE(r.stationary)
  assert: [constant velocity from the previous window] CHECK(w.poses[k].translation().isApprox(end + v0 * (k * dt), 1e-12))
  assert: [constant velocity from the previous window] CHECK(w.motion_model_poses.size() == w.poses.size())
  value: [IMU integration: p = v t + a t^2 / 2] const Eigen::Vector3d a(0.5, -0.2, 0.0)
  assert: [IMU integration: p = v t + a t^2 / 2] CHECK(w.poses[k].translation().isApprox(end + v0 * t + 0.5 * a * t * t, 1e-9))
  assert: [a window at rest is predicted without motion] CHECK(r.stationary)
  assert: [a window at rest is predicted without motion] CHECK(w.poses[k].translation().isApprox(end, 1e-12))
  value: [mean shift between the two previous windows, and its plausibility limit] const Window before = moving_window(n, 1.0, 0.0, pose(3.0 - n * dt, 1.0, 0.0, 0.0))
  assert: [mean shift between the two previous windows, and its plausibility limit] CHECK_FALSE(r.mean_shift_dropped)
  assert: [mean shift between the two previous windows, and its plausibility limit] CHECK(w.poses[k].translation().isApprox(end + shift * k, 1e-12))
  value: [mean shift between the two previous windows, and its plausibility limit] const Window far = moving_window(n, 1.0, 0.0, pose(-100.0, 1.0, 0.0, 0.0))
  assert: [mean shift between the two previous windows, and its plausibility limit] CHECK(predict_window_poses(w2, previous, &far, v0, PosePredictionOptions()).mean_shift_dropped)
  assert: [mean shift between the two previous windows, and its plausibility limit] CHECK(w2.poses[k].translation().isApprox(end, 1e-12))

[case] tests/window_steps_test.cpp :: apply_gyro_bias_prior grows the prior and removes the bias from the guess
  markers: -
  value: const int n = 50
  value: const double bias = 0.1
  value: const double rw = 0.01
  value: const double duration = (n - 1) * dt
  assert: CHECK(prior.mean == carried.mean)
  assert: CHECK(prior.covariance.isApprox(carried.covariance + Eigen::Matrix3d::Identity() * (rw * rw * duration), 1e-15))
  assert: CHECK(w.gyro_bias.mean == prior.mean)
  assert: CHECK(w.gyro_bias.covariance == prior.covariance)
  assert: CHECK(w.poses[k].linear().isApprox(Eigen::Matrix3d::Identity(), 1e-12))
  assert: CHECK(w.motion_model_poses[k].matrix() == w.poses[k].matrix())

[case] tests/window_steps_test.cpp :: repropagate_window_tail continues the tail with the kept velocity and the IMU rotation
  markers: -
  value: const int n = 60
  value: const int tail = 5
  value: const Window imu = moving_window(n, 1.0, 0.4)
  assert: [no tail nodes: nothing changes] CHECK(w.poses[k].matrix() == before.poses[k].matrix())
  value: [the tail continues from the last kept node] const int a = n - 1 - tail
  assert: [the tail continues from the last kept node] CHECK(w.poses[k].matrix() == before.poses[k].matrix())
  assert: [the tail continues from the last kept node] CHECK(w.poses[k].translation().isApprox(Eigen::Vector3d(k * dt, 0.0, 0.0), 1e-9))
  value: [the tail continues from the last kept node] const Eigen::Matrix3d expected = Eigen::AngleAxisd(0.4 * (k - a) * dt, Eigen::Vector3d::UnitZ()).toRotationMatrix()
  assert: [the tail continues from the last kept node] CHECK(w.poses[k].linear().isApprox(expected, 1e-9))
  assert: [a short velocity span (a slower IMU) gives the same tail at constant velocity] CHECK(w.poses[k].translation().isApprox(Eigen::Vector3d(k * dt, 0.0, 0.0), 1e-9))
  assert: [no velocity span, or one longer than the kept nodes: nothing changes] CHECK(w.poses[k].matrix() == before.poses[k].matrix())
  assert: [a bias update removes rotation from the IMU increments] CHECK(w.poses[k].linear().isApprox(Eigen::Matrix3d::Identity(), 1e-9))

[case] tests/window_steps_test.cpp :: convergence_of finds when the poses settle and when delta drops below the fast threshold
  markers: -
  value: const IterationConvergence c = convergence_of(poses_after, deltas, 1e-4, 0.001 * 3.14159265358979 / 180.0, 1e-2)
  assert: CHECK(c.iterations == 10)
  assert: CHECK(c.settled_after == 3)
  assert: CHECK(c.fast_stop_after == 3)
  assert: CHECK(c.fast_stop_position_error_m == doctest::Approx(1.11e-5).epsilon(1e-6))
  assert: CHECK(c.fast_stop_rotation_error_rad == doctest::Approx(0.0))
  value: [a rotation that settles late] const IterationConvergence r = convergence_of(poses_after, deltas, 1e-4, 0.001 * 3.14159265358979 / 180.0, 1e-2)
  assert: [a rotation that settles late] CHECK(r.settled_after == 9)
  value: [a run cut short is measured against its last iteration] const IterationConvergence r = convergence_of(poses_after, deltas, 1e-4, 0.001 * 3.14159265358979 / 180.0, 1e-2)
  assert: [a run cut short is measured against its last iteration] CHECK(r.iterations == 2)
  assert: [a run cut short is measured against its last iteration] CHECK(r.settled_after == 2)
  assert: [a run cut short is measured against its last iteration] CHECK(r.fast_stop_after == 0)

