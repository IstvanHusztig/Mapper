  loop: for (size_t k = 1; k < truth.size(); k++)
  number: longest_step = std::max(longest_step, (truth[k].translation() - truth[k - 1].translation()).norm())
  value: const double turn = Eigen::AngleAxisd(truth[k].linear() * truth[k - 1].linear().transpose()).angle()
  number: if (k > 1)
  assert: CHECK(longest_step <= 0.1 + 1e-9)
  assert: CHECK(largest_turn <= 0.05 + 1e-9)
  assert: CHECK(largest_turn_change <= 0.005 + 1e-6)
  value: double worst = 0.0
  loop: for (size_t i = 0; i < lap_nodes; i++)
  value: double nearest = 1e9
  assert: CHECK(r.lap_time_s > 10.0)
  assert: CHECK(worst <= 0.1)

