[case] tests/window_steps_test.cpp :: predict_window_poses steps: the four ways to the translations
  markers: -
  value: const Window w = turning_window(11)
  value: const std::vector<Eigen::Vector3d> a(11, Eigen::Vector3d(0.5, 0.0, 0.0))
  value: const Eigen::Vector3d v0(1.0, 0.2, 0.0), shift(0.001, 0.0, 0.0)
  value: const double gap = 0.002
  value: const Eigen::Vector3d start = w.poses[0].translation()
  value: [accelerometer integration: p = v t + a t^2 / 2 from the gap on] const double t = 0.02
  value: [accelerometer integration: p = v t + a t^2 / 2 from the gap on] const Eigen::Vector3d expected = start + v0 * gap + v0 * t + 0.5 * a[0] * t * t
  assert: [accelerometer integration: p = v t + a t^2 / 2 from the gap on] CHECK((poses.back().translation() - expected).norm() < 1e-12)
  assert: [at rest: no motion] CHECK(p.translation() == start)
  assert: [constant velocity over the node times and the gap] CHECK((poses[k].translation() - (w.poses[k].translation() + v0 * (0.002 * k + gap))).norm() < 1e-12)
  assert: [the mean shift per node] CHECK((poses[k].translation() - (w.poses[k].translation() + shift * double(k))).norm() < 1e-15)

