  assert: CHECK(rest.matrix(u.ie + a, u.ie + a) == noise.zero_velocity_weight)
  assert: CHECK(origin.matrix(k, k) == noise.origin[size_t(k)])

[case] tests/window_noise_model_test.cpp :: window noise model: the priors grow by their random walk over the window and by the noise over the gap
  markers: -
  value: const double rw = 2e-4, duration = 0.4
  assert: CHECK(grown == carried + Eigen::Matrix3d::Identity() * (rw * rw * duration))
  assert: CHECK((grown - carried).isDiagonal())
  assert: CHECK(random_walk_prior_cov(carried, rw, 0.0) == carried)
  value: const double density = 0.0013, floor = 0.1, gap = 0.002
  assert: CHECK(v == carried + Eigen::Matrix3d::Identity() * (density * density * gap + floor * floor * gap * gap))
  assert: CHECK(v(0, 0) > carried(0, 0))
  assert: CHECK(v(0, 1) == carried(0, 1))

