[case] tests/window_terms_test.cpp :: window terms: each term counts the scalar residuals it adds
  markers: -
  assert: [accelerometer term, velocity priors, offset prior] REQUIRE(u.anchors.size() >= 3)
  assert: [accelerometer term, velocity priors, offset prior] REQUIRE(end_tied)
  assert: [accelerometer term, velocity priors, offset prior] CHECK(acc.residuals == 3 * static_cast<int>(u.anchors.size() - 2 + 2))
  assert: [accelerometer term, velocity priors, offset prior] CHECK(rest.residuals == 3 + 6)
  assert: [accelerometer term, velocity priors, offset prior] CHECK(untied.residuals == 3 + 3)
  assert: [accelerometer term, velocity priors, offset prior] CHECK(offset.residuals == 3)
  value: [edges, gyro-bias prior, velocity continuity, origin fix] const Window w = straight_window(12, 0.002)
  value: [edges, gyro-bias prior, velocity continuity, origin fix] const VelocityPrior previous{true, Eigen::Vector3d(1.0, 0.0, 0.0)}
  assert: [edges, gyro-bias prior, velocity continuity, origin fix] CHECK(edges.residuals == 6 * 11)
  assert: [edges, gyro-bias prior, velocity continuity, origin fix] CHECK(bias.residuals == 3)
  assert: [edges, gyro-bias prior, velocity continuity, origin fix] CHECK(continuity.residuals == 3 * 10 + 3)
  assert: [edges, gyro-bias prior, velocity continuity, origin fix] CHECK(origin.residuals == 6)

