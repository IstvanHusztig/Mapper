[case] tests/unit_cases_inertial_test.cpp :: unit case A2: a noise-free constant-velocity window is taken as at rest, and the zero-velocity term then holds it
  markers: -
  value: const double v = 2.0
  value: const Chain chain = make_chain(0.0, v)
  value: const Window &w = chain.windows[2]
  assert: CHECK(w.poses.back().translation().x() - w.poses.front().translation().x() > 0.7)
  value: const bool rests = window_rests(w.poses, w.timestamps, w.imu_acc, w.imu_angles, 1.0, 0.3, 3.0 * DEG_TO_RAD)
  assert: CHECK(rests)
  assert: REQUIRE_FALSE(rest_c.use_zero_velocity_detection)
  assert: REQUIRE(as_rest.ok)
  assert: REQUIRE(as_moving.ok)
  assert: CHECK(as_rest.record.at_rest)
  assert: CHECK_FALSE(as_moving.record.at_rest)
  assert: CHECK(as_moving.record.velocity_start.x() == doctest::Approx(v).epsilon(1e-3))
  assert: CHECK(as_moving.record.velocity_end.x() == doctest::Approx(v).epsilon(1e-3))
  assert: CHECK(std::abs(as_rest.record.velocity_end.x()) < 0.05)
  assert: CHECK(as_rest.record.velocity_start.x() < 1.0)
  assert: CHECK(as_rest.record.velocity_start.x() > 0.1)
  assert: CHECK(as_rest.record.result_move.x() < 0.1 * true_move)

[case] tests/unit_cases_inertial_test.cpp :: unit case K6: the rest test with a tilted open-loop filter attitude
  markers: -
  assert: CHECK(rests_at_tilt(0.0, 1))
  assert: CHECK_FALSE(window_rests(moving.poses, moving.timestamps, moving.imu_acc, moving.imu_angles, 1.0, 0.3, 3.0 * DEG_TO_RAD))
  value: const double pitch = tilt_threshold_deg(1)
  value: const double roll = tilt_threshold_deg(0)
  value: const double expected = 2.0 * std::asin(0.3 / (2.0 * g0)) / DEG_TO_RAD
  assert: CHECK(pitch == doctest::Approx(expected).epsilon(1e-3))
  assert: CHECK(roll == doctest::Approx(expected).epsilon(1e-3))
  assert: CHECK(rests_at_tilt(1.7, 1))
  assert: CHECK_FALSE(rests_at_tilt(1.8, 1))
  assert: CHECK(rests_at_tilt(2.8, 1, 0.5))
  assert: CHECK_FALSE(rests_at_tilt(3.0, 1, 0.5))

