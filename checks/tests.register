  assert: CHECK(rounds == 3)
  assert: CHECK(set == std::vector<bool>{false, false, true, false})
  assert: CHECK(removed == std::vector<std::string>{"a", "b", "", ""})
  value: const auto r2 = fine_time_apply_rule(both, [](const std::vector<bool> &s) {...})
  assert: CHECK(both == std::vector<bool>{false, false})
  assert: CHECK(r2 == std::vector<std::string>{"0 -> 9", "0 -> 9"})

[case] tests/loop_fine_time_test.cpp :: loop fine time: supports reach a segment's windows beyond the run, cut at the ends; overlapping supports are marked
  markers: -
  value: const auto apart = fine_time_supports({{10, 20}, {40, 50}}, 100, r)
  assert: CHECK(apart[0].first_window == 4)
  assert: CHECK(apart[0].last_window == 26)
  assert: CHECK(!apart[0].overlap)
  assert: CHECK(!apart[1].overlap)
  value: const auto close = fine_time_supports({{10, 20}, {30, 35}, {80, 98}}, 100, r)
  assert: CHECK(close[0].overlap)
  assert: CHECK(close[1].overlap)
  assert: CHECK(!close[2].overlap)
  assert: CHECK(close[2].last_window == 99)
  assert: CHECK(fine_time_supports({{2, 5}}, 100, r)[0].first_window == 0)

