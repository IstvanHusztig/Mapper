  number: windows[w].readings = WindowReadings{w >= 28 && w <= 35 ? 0.01 : 0.5, Eigen::Vector3d::UnitX(), false, Eigen::Vector3d(0.4, 0.0, 0.0), 0.4}
  assert: CHECK(fixed_report.edge_time_support.empty())
  assert: REQUIRE(report.outcome == "applied")
  assert: REQUIRE(loops > 0)
  assert: REQUIRE(!report.odometry_runs.empty())
  value: int with_blocks = 0, without = 0
  assert: CHECK(t.first_window == segments[t.j].first_window)
  assert: CHECK(t.last_window == segments[t.j].last_window)
  assert: CHECK(t.first_window <= run.last_window)
  assert: CHECK(run.first_window <= t.last_window)
  assert: CHECK(std::isfinite(t.support.first_pose_residual_m))
  assert: CHECK(t.axis.norm() == doctest::Approx(1.0))
  assert: REQUIRE(t.support.along_axis)
  assert: REQUIRE(t.support.shares.size() == 4)
  value: double sum = 0.0
  assert: CHECK(sum == doctest::Approx(1.0))
  assert: CHECK(std::isfinite(t.support.residual_m))
  assert: CHECK(!t.support.along_axis)
  assert: CHECK(std::isnan(t.support.residual_m))
  value: size_t expected = 0
  assert: CHECK(report.edge_time_support.size() == expected)
  assert: CHECK(with_blocks > 0)
  assert: CHECK(without > 0)
  assert: REQUIRE(write_loop_closure_replay_json(file, replayed, LoopClosureSettingsDifference{}, config, why))
  assert: CHECK(text.find("\"edge_time_support\"") != std::string::npos)
  assert: CHECK(text.find("\"time_support_residual_m\": null") != std::string::npos)
  assert: CHECK(text.find("\"shares\"") != std::string::npos)
  assert: CHECK(text.find("\"first_pose_residual_m\"") != std::string::npos)

