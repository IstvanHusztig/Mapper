[case] tests/test_verification_tools.py :: RunHealthKnownLogTests.test_the_planted_values_are_read_back_exactly_and_judged
  markers: -
  assert: self.assertEqual(r['windows'], 200)
  assert: self.assertEqual((r['bend_gt3'], r['bend_gt10'], r['bend_max']), (1, 0, 4.0))
  assert: self.assertEqual(r['speed_max'], 2.6)
  assert: self.assertEqual(r['bias_max'], [0.6, 0.05, 0.02])
  assert: self.assertEqual((r['chi2_windows'], r['chi2_p50'], r['chi2_p95']), (41, 8.0, 30.0))
  assert: self.assertEqual(r['coverage'], {'bend': 200, 'speed': 200, 'bias': 200, 'chi2': 41})
  assert: self.assertEqual(r['missing_required'], [])
  assert: self.assertEqual(rows['windows bent > 3 deg against the gyro'], ('1 (0.5 %)', '<= 1 %', 'CLEAR'))
  assert: self.assertEqual(rows['windows bent > 10 deg'], ('0', '0', 'CLEAR'))
  assert: self.assertEqual(rows['largest bend'], ('4.0 deg', '', ''))
  assert: self.assertEqual(rows['windows faster than 2.5 m/s'], ('1 (max 2.60 m/s)', '0', 'TRIGGER'))
  assert: self.assertEqual(rows['largest gyro bias estimate x / y / z'], ('0.60 / 0.05 / 0.02 deg/s', '<= 0.5', 'TRIGGER'))
  assert: self.assertEqual(rows['chi2 of the velocity jump, median / p95'], ('8 / 30 (41 windows)', '<= 5 / 20', 'TRIGGER'))
  assert: self.assertEqual(code, 1)
  assert: self.assertIn('result: TRIGGERS', out)

[case] tests/test_verification_tools.py :: RunHealthKnownLogTests.test_each_planted_value_just_below_its_limit_is_clear
  markers: -
  assert: self.assertEqual((r['bend_gt3'], r['bend_max'], r['speed_max'], r['bias_max'][0]), (0, 2.9, 2.49, 0.49))
  assert: self.assertEqual((r['chi2_p50'], r['chi2_p95']), (4.9, 19.4))
  assert: self.assertEqual(rows['windows bent > 3 deg against the gyro'], ('0 (0.0 %)', '<= 1 %', 'CLEAR'))
  assert: self.assertEqual(rows['largest bend'], ('2.9 deg', '', ''))
  assert: self.assertEqual(rows['windows faster than 2.5 m/s'], ('0 (max 2.49 m/s)', '0', 'CLEAR'))
  assert: self.assertEqual(rows['largest gyro bias estimate x / y / z'], ('0.49 / 0.05 / 0.02 deg/s', '<= 0.5', 'CLEAR'))
  assert: self.assertEqual(rows['chi2 of the velocity jump, median / p95'], ('5 / 19 (41 windows)', '<= 5 / 20', 'CLEAR'))
  assert: self.assertEqual([k for k, v in rows.items() if v[2] == 'TRIGGER'], [])
  assert: self.assertEqual(code, 0)
  assert: self.assertIn('result: DIAGNOSTICS COMPLETE', out)

