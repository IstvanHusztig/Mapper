  number: k.guess[i].linear() = Eigen::AngleAxisd(1.0 * deg * i / (n_nodes - 1), Eigen::Vector3d::UnitX()).toRotationMatrix()
  number: k.translation_sigma_m = 1e-4
  number: k.rotation_sigma_deg = 1.7724539
  number: MESSAGE("tilt drift: largest rotation error ", before.rotation / deg, " -> ", after.rotation / deg, " deg, largest position error ", after.position * 1000.0, " mm")
  assert: CHECK(after.rotation < 0.5 * before.rotation)
  assert: CHECK(after.position < 0.005)

[case] tests/scan_to_map_test.cpp :: scan-to-map, imu always on: a gap in the IMU samples drops the stretched terms
  markers: -
  number: k.truth = straight(1.0, 0.0)
  loop: for (int i = 0; i < n_nodes; i++)
