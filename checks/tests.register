[case] tests/lm_solver_test.cpp :: lm solver: one iteration takes the damped step, and hands over the covariance from the undamped matrix
  markers: -
  value: const LmIteration it = lm_iteration(q, 1e-12, true, true, false, delta, c.workspace())
  assert: CHECK(it.applied)
  assert: CHECK(it.cost == doctest::Approx(q.cost_at(Eigen::Vector2d::Zero())))
  assert: CHECK(q.x.x() == doctest::Approx(1.0))
  assert: CHECK(q.x.y() == doctest::Approx(-2.0))
  assert: CHECK(delta == doctest::Approx(3.0))
  assert: REQUIRE(q.covariance.rows() == 2)
  assert: REQUIRE(q.covariance.cols() == 1)
  assert: CHECK(q.covariance(0, 0) == doctest::Approx(inverse(0, 1)))
  assert: CHECK(q.covariance(1, 0) == doctest::Approx(inverse(1, 1)))
  assert: CHECK(q.snapshots == 0)
  assert: [damping on the leading unknown only] CHECK(std::abs(d.x.x()) < 1e-5)
  assert: [damping on the leading unknown only] CHECK(d.x.y() == doctest::Approx(-2.0 + 1.0 / 3.0).epsilon(1e-5))
  value: [without a step: the covariance, nothing else] const LmIteration none = lm_iteration(n, 5.0, false, true, true, delta_n, c.workspace())
  assert: [without a step: the covariance, nothing else] CHECK_FALSE(none.applied)
  assert: [without a step: the covariance, nothing else] CHECK(n.x == Eigen::Vector2d::Zero())
  assert: [without a step: the covariance, nothing else] CHECK(delta_n == 42.0)
  assert: [without a step: the covariance, nothing else] CHECK(n.apply_calls == 0)
  assert: [without a step: the covariance, nothing else] CHECK(n.covariance.rows() == 2)
  assert: [without a step: the covariance, nothing else] CHECK(n.snapshots == 1)

[case] tests/lm_solver_test.cpp :: lm solver: the damping grows tenfold after iterations 10, 20, ... and at once after a refused step
  markers: -
  assert: [by schedule] REQUIRE(changed_from.size() == 2)
  assert: [by schedule] CHECK(changed_from[0] == 5.0)
  assert: [by schedule] CHECK(changed_from[1] == 50.0)
  assert: [by schedule] CHECK(r.lm_factor == 500.0)
  assert: [by schedule] CHECK(r.last_iteration == 20)
  assert: [by schedule] CHECK(r.stop == LmStop::iteration_limit)
  assert: [a refused step] REQUIRE(changed_from.size() == 1)
  assert: [a refused step] CHECK(changed_from[0] == 5.0)
  assert: [a refused step] REQUIRE(after.size() == 5)
  assert: [a refused step] CHECK(after[2] == after[1])

[case] tests/lm_solver_test.cpp :: lm solver: the iterations end at convergence, the iteration limit, a forced last iteration or the time limit
  markers: -
  assert: [converged] CHECK(r.stop == LmStop::converged)
  assert: [converged] CHECK(r.last_iteration < 5)
  assert: [converged] CHECK(std::string(lm_stop_name(r.stop)) == "converged")
  value: [iteration limit] const LmResult r = lm_solve(q, no_stop(3), c.workspace())
  assert: [iteration limit] CHECK(r.stop == LmStop::iteration_limit)
  assert: [iteration limit] CHECK(r.last_iteration == 3)
  assert: [iteration limit] CHECK(q.apply_calls == 4)
  assert: [forced: no time limit] CHECK(r.stop == LmStop::forced)
  assert: [forced: no time limit] CHECK(r.last_iteration == 3)
  assert: [forced: no time limit] CHECK(asked == 0)
  assert: [time limit] CHECK(r.stop == LmStop::time_limit)
  assert: [time limit] CHECK(r.last_iteration == 1)

[case] tests/lm_solver_test.cpp :: lm solver: with the step check a step that raised the cost is taken back; without it nothing is saved
  markers: -
  assert: [step check] CHECK(r.rejected_steps == 1)
  assert: [step check] CHECK(r.lm_factor == doctest::Approx(1e-8))
  assert: [step check] CHECK(q.cost_at(q.x) < 1e-12)
  assert: [step check] CHECK(changed_from.empty())
  assert: [the last step is checked too] CHECK(r.rejected_steps == 1)
  assert: [the last step is checked too] CHECK(q.cost_at(q.x) < 1e-12)
  assert: [no step check: no snapshots] CHECK(q.snapshots == 0)

