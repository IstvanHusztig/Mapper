  number: support_of() :: return {0.5 * (t(s.a) + t(s.b)), 0.5 * (t(s.b) + t(s.c)), t(s.a), t(s.c)}
  number: support_of() :: return {t(0), 0.5 * (t(0) + t(s.b)), t(0), t(s.b)}
  number: support_of() :: return {0.5 * (t(s.a) + t(s.b)), t(s.c), t(s.a), t(s.c)}
  number: term_sign() :: return s.kind == AccelerometerTermKind::end_velocity ? -1.0 : 1.0
  value: sample_overlaps() :: std::vector<double> l(n, 0.0)
  loop: sample_overlaps() :: for (int k = 0; k + 1 < n; k++)
  number: sample_overlaps() :: l[k] = std::max(0.0, std::min(w.timestamps[k + 1].first, t1) - std::max(w.timestamps[k].first, t0))
  number: observe_span() :: first = 0
  value: observe_span() :: const int hi = std::min(last + 1, n - 1)
  value: observe_span() :: std::vector<Eigen::Vector3d> sub_acc(tw.window.imu_acc.begin() + first, tw.window.imu_acc.begin() + hi + 1)
  number: observe_span() :: u.pose_band_offset = std::max(17, (u.n_nodes - 1) * 6 + 5)
  number: observe_span() :: return -eq.rhs.block<3, 1>(u.io, 0) / (s.weight * term_sign(s) * s.tau)
  number: quadrature_part() :: return (p(s.b) - p(0)) / (t(s.b) - t(0)) - tw.velocity_at(sup.t1)
  value: kernel_l1() :: const double c = 0.5 * (sup.lo + sup.hi)
  number: kernel_l1() :: [kernel] return (t(s.b) - u) / (t(s.b) - t(0))
  number: kernel_l1() :: [kernel] return u < t(s.b) ? (u - t(s.a)) / (t(s.b) - t(s.a)) : 1.0
  value: kernel_l1() :: constexpr int steps = 8000
  value: kernel_l1() :: double sum = 0.0
  loop: kernel_l1() :: for (int i = 0; i < steps; i++)
  value: kernel_l1() :: const double u = sup.lo + (i + 0.5) * h
  value: kernel_l1() :: const double box = (u >= sup.t0 && u <= sup.t1) ? 1.0 : 0.0
  number: kernel_l1() :: return sum * 1.01
  value: Extremes :: double rate = 0.0
  value: Extremes :: double force = 0.0
  value: Extremes :: double jerk = 0.0
  value: Extremes :: double rotation = 0.0
  value: extremes_of() :: const Eigen::Matrix3d r0 = motion.state(std::max(reference, 0.0)).rotation
  value: extremes_of() :: constexpr double step = 0.00025, d = 2e-4
  loop: extremes_of() :: for (double t = std::max(from, d); t <= to + 1e-12; t += step)
  number: extremes_of() :: e.jerk = std::max(e.jerk, (motion.state(t + d).acceleration - motion.state(t - d).acceleration).norm() / (2.0 * d))
  value: Bounds :: double quadrature = 0.0, samples = 0.0
  value: derive_bounds() :: const Extremes e = extremes_of(*tw.motion, tw.motion_time(sup.lo) - dt, tw.motion_time(sup.hi) + dt, tw.motion_time(tw.window.timestamps[0].first), tw.offset_body.norm())
  number: derive_bounds() :: b.quadrature = 1.01 * e.jerk * kernel_l1(tw.window, s)
  number: derive_bounds() :: b.samples = s.tau * (0.5 * dt * e.rate * e.force + std::ldexp(1.0, -24) * e.force + tw.offset_body.norm() * e.rotation) + e.jerk * dt * dt
  default: observe_edge_rotation() :: defaults of (const TermWindow &tw, int k, Eigen::Vector3d *weight = nullptr, double *dt = nullptr)
  number: observe_edge_rotation() :: sub.poses = {tw.window.poses[k], tw.window.poses[k + 1]}
  number: observe_edge_rotation() :: sub.motion_model_poses = {tw.window.motion_model_poses[k], tw.window.motion_model_poses[k + 1]}
  number: observe_edge_rotation() :: sub.timestamps = {tw.window.timestamps[k], tw.window.timestamps[k + 1]}
  value: observe_edge_rotation() :: const double edge_dt = nm.edges.dt[0]
  value: observe_edge_rotation() :: const Eigen::Vector3d w = nm.edges.rotation[0]
  loop: observe_edge_rotation() :: for (int r = 0; r < 3; r++)
  number: observe_edge_rotation() :: d(r) = eq.rhs(nm.unknowns.ib + r, 0) / (edge_dt * w(r))

