  number: update_rgd(grid(0.5), buckets, a, Eigen::Vector3d(-2.0, 0.75, 0.75), true)
  assert: REQUIRE(buckets.size() == 1)
  assert: CHECK(angle_deg(before.normal_vector, Eigen::Vector3d::UnitX()) < 1e-3)
  assert: CHECK(before.normal_vector.x() < 0.0)
  number: update_rgd(grid(0.5), buckets, b, Eigen::Vector3d(4.0, 0.75, 0.75), true)
  assert: REQUIRE(buckets.size() == 1)
  assert: CHECK(after.number_of_points == before.number_of_points)
  assert: CHECK(after.mean == before.mean)
  assert: CHECK(after.cov == before.cov)
  assert: CHECK(after.normal_vector == before.normal_vector)

[case] tests/ndt_map_test.cpp :: update_rgd: every cell carries the inverse of its covariance, refreshed when a later call changes the cell
  markers: -
  loop: for (const bool exact : {true, false})
  value: std::mt19937 rng(11)
  value: std::uniform_real_distribution<double> xy(0.1, 3.9)
  value: std::uniform_real_distribution<double> z(0.95, 1.05)
  loop: for (int i = 0; i < n; i++)
  value: [check_all] size_t usable = 0, skipped = 0
  assert: [check_all] REQUIRE(cell.inverse_computed)
  assert: [check_all] CHECK(std::memcmp(cell.cov_inverse.data(), expected.data(), 9 * sizeof(double)) == 0)
  value: [check_all] const bool expected_usable = !((expected.array() > 100000.0).any() || (expected.array() < -100000.0).any())
  assert: [check_all] CHECK(cell.inverse_usable == expected_usable)
  assert: [check_all] CHECK((inverse != nullptr) == expected_usable)
  assert: [check_all] CHECK(usable > 0)
  value: auto first = make_points(4000)
  number: update_rgd(grid(0.5), buckets, first, Eigen::Vector3d(2.0, 2.0, 5.0), exact)
  call: check_all(buckets)
  value: auto second = make_points(4000)
  number: update_rgd(grid(0.5), buckets, second, Eigen::Vector3d(2.0, 2.0, 5.0), exact)
  call: check_all(buckets)
  number: plain.cov = Eigen::Matrix3d::Identity() * 0.03 * 0.03
  assert: REQUIRE(inverse != nullptr)
  assert: CHECK(std::memcmp(inverse->data(), expected.data(), 9 * sizeof(double)) == 0)

