[case] tests/test_check_register.py :: HolesTest.test_python_helpers_and_set_ups_are_listed_under_the_file
  markers: -
  number: fb = [b for b in reg.blocks if b.name is None][0].lines
  assert: self.assertIn(('assert', 'verify() :: tc.assertLess(x, 2)'), fb)
  assert: self.assertIn(('assert', 'Base.setUp() :: self.assertTrue(self.ready())'), fb)
  assert: self.assertIn(('assert', 'Base.check() :: self.assertEqual(a, b)'), fb)
  assert: self.assertIn(('call', 'Base.indirect() :: self.check(a, a)'), fb)
  assert: self.assertFalse([t for k, t in fb if 'ready() ::' in t])
  number: a = [b for b in reg.blocks if b.name == 'Tests.test_a'][0].lines
  assert: self.assertIn(('call', 'verify(self, 1)'), a)
  assert: self.assertIn(('call', 'self.indirect(2)'), a)
  number: c = [b for b in reg.blocks if b.name == 'Tests.test_c'][0].lines
  assert: self.assertIn(('call', 'local(1)'), c)
  assert: self.assertIn(('assert', 'self.assertGreaterEqual(x, 0)'), c)

