  assert: REQUIRE(bytes.size() > block + 12)
  value: const std::uint32_t version = 1
  assert: REQUIRE(read_odometry_snapshot(file.path, config, read, why))
  assert: REQUIRE(read.windows.size() == written.windows.size())
  assert: CHECK_FALSE(w.readings.has_value())
  assert: CHECK(read.consecutive_distance == written.consecutive_distance)
  assert: REQUIRE(write_odometry_snapshot(file.path, written, config, why))
  assert: CHECK_FALSE(read_odometry_snapshot(file.path, config, read, why))
  assert: CHECK(why.find("window readings") != std::string::npos)

