  loop: for (size_t k = 0; k < old_names.size(); k++)
  assert: CHECK(names[k] == old_names[k])
  assert: CHECK(values[k] == old_values[k])
  assert: CHECK(names[old_names.size()] == "prepared_first_x_m")
  assert: CHECK(names.back() == "move_gyro_bias_reduction")
  value: const bool reason = names[k].size() > 7 && names[k].compare(names[k].size() - 7, 7, "_reason") == 0
  assert: CHECK(values[k] == (reason ? "absent" : ""))

[case] tests/window_capture_test.cpp :: window term csv: the prepared and handed-on state, every field written, absent ones empty
  markers: -
  call: features_lines_of(record)
  assert: REQUIRE(lines.size() == 2)
  value: const std::vector<std::string> names = csv_fields(lines[0]), values = csv_fields(lines[1])
  assert: REQUIRE(values.size() == names.size())
  assert: [at] REQUIRE_MESSAGE(it != names.end(), name)
  call: [near] at(name)
  assert: [near] REQUIRE_FALSE(v.empty())
  assert: [near] CHECK(std::stod(v) == doctest::Approx(expected).epsilon(1e-8))
  number: [retired] return name.rfind("handed_velocity_offset_cov_", 0) == 0 || name == "move_joint" || name == "move_joint_reduction"
  loop: for (size_t k = 93; k < names.size(); k++)
