  number: readings() :: rd.push_back(WindowReadings{weak ? 0.01 : 0.5, Eigen::Vector3d::UnitX(), false, move, 1.0})
  value: uniform_steps() :: Eigen::Matrix<double, 6, 6> omega = Eigen::Matrix<double, 6, 6>::Zero()
  value: uniform_steps() :: const double wt = 1.0 / std::pow(c.loop_closure_odometry_sigma_m, 2), wr = 1.0 / std::pow(c.loop_closure_odometry_sigma_deg * DEG_TO_RAD, 2)
  number: uniform_steps() :: return LoopOdometryEdgeInformation(segments - 1, omega)
  value: MemoryLoopClosureCaptureSink :: int writes = 0
  number: capture_without_tries() :: c.windows = loop_recording(2).windows
  loop: same_bits() :: for (size_t k = 0; k < a.size(); k++)
  value: registrations_fingerprint() :: std::uint64_t h = 1469598103934665603ULL
  loop: registrations_fingerprint() :: for (size_t k = 0; k < n; k++)
  number: registrations_fingerprint() :: [add] h = (h ^ b[k]) * 1099511628211ULL
  number: registrations_fingerprint() :: add(t.correction.matrix().data(), 16 * sizeof(double))
  number: registrations_fingerprint() :: add(t.information.data(), 36 * sizeof(double))
  number: registrations_fingerprint() :: add(t.centre.data(), 3 * sizeof(double))
  value: capture_with_tries() :: Recording r = loop_recording(2)
  number: capture_with_tries() :: add_second_lap_drift(r, {0.3, 0.4, 0.0}, 2.0 * deg)
  loop: capture_with_tries() :: for (int j = 0; j < static_cast<int>(c.segments.size()); j++)
  number: capture_with_tries() :: k.registration.overlap_before = 0.6
  number: capture_with_tries() :: k.registration.overlap_after = 0.8 - 0.01 * (c.tries.size() % 7)
  number: capture_with_tries() :: k.registration.correction.translation() = Eigen::Vector3d(-0.2 + 0.03 * (c.tries.size() % 5), -0.3, 0.0)
  loop: ConstructedEdge() :: for (size_t w = 0; w < moved.size(); w++)
  number: ConstructedEdge() :: before.push_back(Eigen::Vector3d(static_cast<double>(w), 0.3, -0.2))
  number: ConstructedEdge() :: after.push_back(before.back() + (moved[w] ? Eigen::Vector3d(1.0, 0.0, 0.0) : Eigen::Vector3d(0.0, 0.0, 0.0)))
  number: blocks() :: m(0, 0) = h
  number: blocks() :: m(1, 1) = 40.0
  number: registration() :: t.overlap_before = 0.6
  number: registration() :: t.overlap_after = 0.9
  number: registration() :: t.information = Eigen::Matrix<double, 6, 6>::Identity() * 1e4
  number: registration() :: if (j % 2 == 0)
  value: registration() :: Eigen::Matrix3d m = Eigen::Matrix3d::Identity() * 40.0
  number: registration() :: m(0, 0) = w - segments_[j].first_window + 1.0

[case] tests/loop_closure_test.cpp :: loop closure: drift on the second lap is reduced
  markers: skip
  value: Recording r = loop_recording(2)
  number: add_second_lap_drift(r, {0.3, 0.4, 0.0}, 2.0 * deg)
  number: MESSAGE("drift: ", result.loops, " loops accepted; end error ", end_before * 1000.0, " -> ", end_after * 1000.0, " mm; largest ", max_before.position * 1000.0, " mm / ", max_before.rotation / deg, " deg -> ", max_after.position * 1000.0, " mm / ", max_after.rotation / deg, " deg; mean ", mean_before.position * 1000.0, " -> ", mean_after.position * 1000.0, " mm; ", result.ms, " ms")
  assert: CHECK(result.loops >= 1)
  assert: CHECK(end_after <= 0.5 * end_before)

