[case] tests/synthetic_routes_test.cpp :: synthetic source: does what the production source does
  markers: -
  loop: for (int k = 0; k < 6; k++)
  number: raw.t_ns.push_back(1'000'000'000 + k * 2'000'000)
  number: raw.gyro_rad_s.emplace_back(0.1 * (k + 1), 0.2, -0.3)
  number: raw.acc_g.emplace_back(0.01, 0.02, 1.0 + 1e-9 * k)
  number: raw.points.push_back({{0.30, 0.0, 5.0}, 1.001, 0})
  number: raw.points.push_back({{0.36, 0.0, 1.0}, 1.002, 1})
  number: raw.points.push_back({{41.0, 0.0, 0.0}, 1.003, 2})
  number: raw.points.push_back({{3.0, 4.0, 1.0}, 0.0, 3})
  number: raw.points.push_back({{3.0, 4.0, 1.0}, 1.004, 4})
  number: raw.points.push_back({{0.20, 0.20, 1.0}, 1.005, 5})
  number: raw.points.push_back({{0.26, 0.26, 1.0}, 1.0055, 6})
  value: SyntheticSource source(raw, 1)
  number: calibration.gyro_scale = Eigen::Vector3d(1.01, 1.0, 0.99)
  value: const Imu imu = source.read_imu(0, calibration, logger)
  assert: REQUIRE(imu.size() == 6)
  assert: CHECK(imu[2].timestamps.first == static_cast<double>(1'004'000'000) / 1e9)
  assert: CHECK(imu[2].gyro.x() == static_cast<float>(raw.gyro_rad_s[2].x() * 1.01))
  assert: CHECK(imu[2].gyro.y() == 0.2f)
  assert: CHECK(imu[2].gyro.z() == static_cast<float>(-0.3 * 0.99))
  assert: CHECK(imu[5].acc.z() == static_cast<float>(1.0 + 5e-9))
  number: filter.xy_inner = 0.35
  number: filter.xy_outer = 40.0
  number: filter.lever_arm = Eigen::Vector3d(0.1, -0.2, 0.3)
  value: const std::vector<Point3Di> pts = source.read_points(0, filter, logger)
  assert: REQUIRE(pts.size() == 3)
  assert: CHECK(pts[0].index_point == 1)
  assert: CHECK(pts[1].index_point == 4)
  assert: CHECK(pts[2].index_point == 6)
  assert: CHECK((pts[0].point - Eigen::Vector3d(0.46, -0.2, 1.3)).norm() < 1e-15)
  assert: CHECK(pts[1].timestamp == 1.004)
  assert: CHECK(source.read_points(0, filter, logger).size() == 4)
  value: SyntheticSource three(raw, 3)
  assert: REQUIRE(three.chunk_count() == 3)
  value: size_t rows = 0, kept = 0
  loop: for (size_t c = 0; c < 3; c++)
  assert: CHECK(rows == 6)
  assert: CHECK(kept == 3)

