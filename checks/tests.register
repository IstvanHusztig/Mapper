[case] tests/loop_closure_test.cpp :: loop closure odometry steps: weak runs, their sigmas and their shares among the steps
  markers: -
  value: std::vector<WindowReadings> rd(30, seen_window())
  loop: for (int w : {4, 5, 7, 8, 9})
  number: rd[w] = weak_window(w == 7 ? Eigen::Vector3d(-Eigen::Vector3d::UnitX()) : Eigen::Vector3d(Eigen::Vector3d::UnitX()), Eigen::Vector3d(0.1, 0.0, 0.0))
  number: rd[13] = weak_window(Eigen::Vector3d::UnitY(), Eigen::Vector3d(0.4, 0.1, 0.0))
  number: rd[19] = weak_window(Eigen::Vector3d::UnitX(), Eigen::Vector3d(0.4, 0.0, 0.0))
  number: rd[20] = weak_window(Eigen::Vector3d::UnitY(), Eigen::Vector3d(0.4, 0.0, 0.0))
  number: rd[22] = weak_window(Eigen::Vector3d::UnitX(), Eigen::Vector3d::Zero())
  number: rd[22].at_rest = true
  loop: for (int w = 26; w < 30; w++)
  number: rd[w] = weak_window(-Eigen::Vector3d::UnitX(), Eigen::Vector3d(0.2, 0.0, 0.0))
  value: const std::vector<LoopClosureSegment> segments = segments_of_three(30)
  assert: REQUIRE(out.information.size() == 9)
  assert: REQUIRE(out.runs.size() == 5)
  value: const LoopOdometryRun &a = out.runs[0]
  assert: CHECK(a.first_window == 4)
  assert: CHECK(a.last_window == 9)
  assert: CHECK(a.weak_windows == 5)
  assert: CHECK(a.duration_s == doctest::Approx(2.4))
  assert: CHECK(a.axis.isApprox(Eigen::Vector3d::UnitX()))
  assert: CHECK(a.pace_before_mps == doctest::Approx(1.0))
  assert: CHECK(a.pace_after_mps == doctest::Approx(1.0))
  assert: CHECK(a.s1_m == doctest::Approx(0.5 * 0.05 * 2.4 * 2.4))
  assert: CHECK(a.s2_m == doctest::Approx(5 * 0.75 * 0.4))
  assert: CHECK(a.sigma_m == doctest::Approx(std::hypot(a.s1_m, a.s2_m)))
  assert: REQUIRE(a.step_shares.size() == 3)
  assert: CHECK(a.step_shares[0].first == 1)
  assert: CHECK(a.step_shares[0].second == doctest::Approx(2.0 / 6.0))
  assert: CHECK(a.step_shares[1].second == doctest::Approx(3.0 / 6.0))
  assert: CHECK(a.step_shares[2].second == doctest::Approx(1.0 / 6.0))
  value: const LoopOdometryRun &b = out.runs[1]
  assert: CHECK(b.first_window == 13)
  assert: CHECK(b.last_window == 13)
  assert: CHECK(b.axis.isApprox(Eigen::Vector3d::UnitY()))
  assert: CHECK(b.s1_m == doctest::Approx(0.5 * 0.05 * 0.4 * 0.4))
  assert: CHECK(b.s2_m == doctest::Approx(0.75 * 0.4))
  assert: REQUIRE(b.step_shares.size() == 1)
  assert: CHECK(b.step_shares[0].first == 4)
  assert: CHECK(b.step_shares[0].second == doctest::Approx(1.0))
  assert: CHECK(out.runs[2].first_window == 19)
  assert: CHECK(out.runs[2].last_window == 19)
  assert: CHECK(out.runs[3].first_window == 20)
  assert: CHECK(out.runs[3].last_window == 20)
  value: const LoopOdometryRun &e = out.runs[4]
  assert: CHECK(e.first_window == 26)
  assert: CHECK(e.last_window == 29)
  assert: CHECK(e.axis.isApprox(Eigen::Vector3d::UnitX()))
  assert: CHECK(e.pace_after_mps == doctest::Approx(1.0))
  assert: CHECK(e.s2_m == doctest::Approx(4 * 0.5 * 0.4))
  assert: REQUIRE(e.step_shares.size() == 1)
  assert: CHECK(e.step_shares[0].first == 8)
  assert: CHECK(e.step_shares[0].second == doctest::Approx(0.25))
  assert: CHECK(e.share_after_last_step == doctest::Approx(0.75))
  value: double expected = 0.0
  assert: CHECK(shares == doctest::Approx(1.0))
  number: expected += r.sigma_m * r.sigma_m * (1.0 - r.share_after_last_step)
  value: double added = 0.0
  value: const double w_r = 1.0 / std::pow(rule.sigma_deg * deg, 2)
  loop: for (size_t k = 0; k < out.information.size(); k++)
  number: const Eigen::Matrix<double, 6, 6> &omega = out.information[k]
  assert: CHECK(omega.topRightCorner<3, 3>().isZero())
  assert: CHECK(omega.bottomRightCorner<3, 3>().isApprox(Eigen::Matrix3d::Identity() * w_r))
  value: const Eigen::Matrix3d extra = Eigen::Matrix3d(omega.topLeftCorner<3, 3>().inverse()) - Eigen::Matrix3d::Identity() * base
  number: if (k == 0 || k == 5 || k == 7)
  assert: CHECK(extra.norm() < 1e-12)
  assert: CHECK(added == doctest::Approx(expected).epsilon(1e-9))
  value: const Eigen::Matrix3d extra2 = Eigen::Matrix3d(out.information[2].topLeftCorner<3, 3>().inverse()) - Eigen::Matrix3d::Identity() * base
  value: const Eigen::Vector3d along(std::cos(60.0 * deg), -std::sin(60.0 * deg), 0.0)
  assert: CHECK((extra2 - a.sigma_m * a.sigma_m * 0.5 * along * along.transpose()).norm() < 1e-9)

[case] tests/loop_closure_test.cpp :: loop closure odometry steps: windows without readings are not read, the rule applies to the others
  markers: -
  value: std::vector<WindowReadings> full(30, seen_window())
  loop: for (int w : {4, 5, 7, 8, 9, 19})
  number: full[w] = weak_window(Eigen::Vector3d::UnitX(), Eigen::Vector3d(0.1, 0.0, 0.0))
  value: const std::vector<LoopClosureSegment> segments = segments_of_three(30)
  loop: for (int w = 16; w < 19; w++)
  number: full[w].placed_move = Eigen::Vector3d(0.2, 0.0, 0.0)
  loop: for (int w = 20; w < 30; w++)
  assert: REQUIRE(part.runs.size() == 2)
  assert: CHECK(part.runs[0].first_window == 4)
  assert: CHECK(part.runs[0].last_window == 9)
  assert: CHECK(part.runs[0].sigma_m == all.runs[0].sigma_m)
  assert: CHECK(part.information[1] == all.information[1])
  assert: CHECK(part.runs[1].first_window == 19)
  assert: CHECK(part.runs[1].last_window == 19)
  assert: CHECK(all.runs[1].pace_before_mps == doctest::Approx(0.5))
  assert: CHECK(all.runs[1].pace_after_mps == doctest::Approx(1.0))
  assert: CHECK(part.runs[1].pace_before_mps == doctest::Approx(0.5))
  assert: CHECK(part.runs[1].pace_after_mps == doctest::Approx(0.5))
  value: const double wt = 1.0 / (rule.sigma_m * rule.sigma_m)
  loop: for (int k = 7; k < 9; k++)
  assert: CHECK(part.information[k].topLeftCorner<3, 3>().isApprox(Eigen::Matrix3d::Identity() * wt))
  value: std::vector<WindowReadings> rd(30, seen_window())
  loop: for (int w : {10, 11, 13, 14})
  number: rd[w] = weak_window(Eigen::Vector3d::UnitX(), Eigen::Vector3d(0.1, 0.0, 0.0))
  assert: CHECK(loop_odometry_step_information(gap, segments, rule).runs.size() == 1)
  number: gap[12].reset()
  assert: REQUIRE(split.runs.size() == 2)
  assert: CHECK(split.runs[0].last_window == 11)
  assert: CHECK(split.runs[1].first_window == 13)

[case] tests/loop_closure_test.cpp :: loop closure odometry steps: a window with a reading that is not a number is not read, like one without readings
  markers: -
  value: std::vector<WindowReadings> rd(30, seen_window())
  loop: for (int w : {4, 5, 7, 8, 9})
  number: rd[w] = weak_window(Eigen::Vector3d::UnitX(), Eigen::Vector3d(0.1, 0.0, 0.0))
  number: rd[7].placed_move.x() = nan
  number: rd[11].placed_move.y() = nan
  value: const std::vector<LoopClosureSegment> segments = segments_of_three(30)
  assert: CHECK(omega.allFinite())
  number: missing[7].reset()
  number: missing[11].reset()
  assert: REQUIRE(out.runs.size() == without.runs.size())
  loop: for (size_t k = 0; k < out.runs.size(); k++)
  assert: CHECK(out.runs[k].first_window == without.runs[k].first_window)
  assert: CHECK(out.runs[k].last_window == without.runs[k].last_window)
  assert: CHECK(out.runs[k].sigma_m == without.runs[k].sigma_m)
  assert: CHECK(std::isfinite(out.runs[k].sigma_m))
  assert: CHECK(out.information == without.information)
  assert: REQUIRE(out.runs.size() == 2)
  assert: CHECK(out.runs[0].last_window == 5)
  assert: CHECK(out.runs[1].first_window == 8)
  number: rd[7].placed_move.x() = 0.1
  number: rd[7].weak_axis.z() = nan
  assert: CHECK(loop_odometry_step_information(all_read(rd), segments, LoopOdometryRule{}).runs.size() == 2)

[case] tests/loop_closure_test.cpp :: loop closure odometry steps: the pace line runs from the pace before to the pace after, by the windows' mid times
  markers: -
  value: std::vector<WindowReadings> rd(9, seen_window())
  loop: for (int w = 0; w < 3; w++)
  number: rd[w].placed_move = Eigen::Vector3d(0.2, 0.0, 0.0)
  loop: for (int w = 5; w < 9; w++)
  number: rd[w].placed_move = Eigen::Vector3d(0.0, 0.6, 0.0)
  number: rd[3] = weak_window(Eigen::Vector3d::UnitX(), Eigen::Vector3d::Zero())
  number: rd[4] = weak_window(Eigen::Vector3d::UnitX(), Eigen::Vector3d(0.04, 0.0, 0.0))
