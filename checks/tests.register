  number: f_rms[a] = std::sqrt(sum_ff[a] / n - std::pow(sum_f[a] / n, 2))
  number: w_rms[a] = std::sqrt(sum_ww[a] / n - std::pow(sum_w[a] / n, 2)) * 180.0 / pi
  loop: for (int a = 0; a < 3; a++)
