[case] tests/window_covariance_test.cpp :: window covariance smoke: one window per run completes with finite values and valid preconditions
  markers: -
  value: double seconds = 0.0
  loop: for (const bool lidar : {false, true})
  loop: for (const bool switches : {false, true})
  value: const int runs = lidar ? 1 : 2
  loop: for (int j = 0; j < runs; j++)
  number: s.seed = 9000 + std::uint64_t(j)
  call: run_window(s)
  assert: CHECK(r.valid)
  assert: CHECK_FALSE(r.at_rest)
  assert: CHECK(r.prior_mismatch <= 1e-9)
  assert: CHECK(r.boundary_position <= 1e-9)
  assert: CHECK(r.boundary_rotation <= 1e-9)
  assert: CHECK(std::isfinite(r.z_v))
  assert: CHECK(std::isfinite(r.z_o))
  assert: CHECK(std::isfinite(r.bias))
  assert: CHECK(r.points > 1000)
  assert: CHECK(r.ndt_along_ratio < 1e-3)
  assert: CHECK(r.ndt_sideways > 0.0)
  assert: CHECK(r.points == 0)
  number: o << (lidar ? "b" : "a") << (switches ? " on" : " off") << ": z_v " << f(r.z_v, 2) << ", z_o " << f(r.z_o, 2) << "; "
  number: MESSAGE("window covariance smoke (6 runs, a smoke check, not an honesty test): ", o.str(), f(seconds, 1), " s")

