[case] tests/terms_at_truth_test.cpp :: terms at the truth: the observation is valid (alignment, isolation, the edge path)
  markers: -
  assert: REQUIRE(f.cut.ok)
  assert: REQUIRE(static_cast<int>(f.cut.windows.size()) == f.rec.n_windows)
  assert: CHECK(f.filter_error_rad < 2e-6)
  loop: for (const int w : {1, 6, 9})
  loop: for (size_t j = 0; j < tw->noise.accelerometer_terms.size(); j++)
  value: const Eigen::Vector3d whole = full.rhs.block<3, 1>(tw->noise.unknowns.io, 0)
  assert: CHECK((sum - whole).norm() <= 1e-9 * std::max(whole.norm(), 1e-12) + 1e-12)
  value: const auto tw = truth_window(f, 6, opt)
  value: const Eigen::Vector3d base = observe_edge_rotation(*tw, 40)
  value: constexpr double eps = 1e-4
  number: turned.window.motion_model_poses[41].linear() = turned.window.motion_model_poses[41].linear() * Eigen::AngleAxisd(eps, Eigen::Vector3d::UnitX()).toRotationMatrix()
  value: const Eigen::Vector3d seen = observe_edge_rotation(turned, 40) - base
  assert: CHECK(std::abs(std::abs(seen.x()) - eps) <= 1e-7)
  assert: CHECK(std::abs(seen.y()) <= 1e-9)
  assert: CHECK(std::abs(seen.z()) <= 1e-9)
  value: const Eigen::Vector3d bias(0.0, 0.01, 0.0)
  value: const Eigen::Vector3d shift = observe_edge_rotation(biased, 40) - base
  number: MESSAGE("edge path: a window bias 0.01 rad/s about y shifts the edge by " << shift.transpose() << " rad (bias * dt = " << 0.01 * tw->dt_s << ")")
  assert: CHECK(std::abs(std::abs(shift.y()) - 0.01 * tw->dt_s) <= 1e-9)
  assert: CHECK(std::abs(shift.x()) <= 1e-9)
  assert: CHECK(std::abs(shift.z()) <= 1e-9)

