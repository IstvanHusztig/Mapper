  assert: self.assertEqual(c['|d| rotation-rate Q3'], '3 (n 1; 50..50)')
  assert: self.assertEqual(c['|d| rotation-rate Q4'], '3.5 (n 2; 60..70)')
  assert: self.assertEqual(c['|d| start-acc Q1'], '3.5 (n 2; 1..2)')
  assert: self.assertEqual(c['|d| start-acc Q2'], '2.5 (n 2; 3..4)')
  assert: self.assertEqual(c['|d| start-acc Q3'], '2 (n 1; 5..5)')
  assert: self.assertEqual(c['|d| start-acc Q4'], '1 (n 2; 6..7)')
  assert: self.assertAlmostEqual(r, -1348 / 2044, places=12)
