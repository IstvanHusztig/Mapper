[case] tests/orientation_test.cpp :: orientation, Fusion adapter: a turn during the filter's start-up is integrated, not zeroed
  markers: -
  assert: REQUIRE(services.orientation)
  number: ahrs.reset(AxesConvention::Nwu, 0.5f)
  loop: for (int i = 0; i < 3500; i++)
  number: ahrs.update(Eigen::Vector3f(0.0f, 0.0f, 10.0f), Eigen::Vector3f(0.0f, 0.0f, 1.0f), 0.001f)
  value: const double yaw_deg = std::atan2(r(1, 0), r(0, 0)) * rad_to_deg
  value: const double tilt_deg = std::acos(std::clamp(static_cast<double>(r(2, 2)), -1.0, 1.0)) * rad_to_deg
  assert: CHECK(yaw_deg == doctest::Approx(35.0).epsilon(0.01))
  assert: CHECK(tilt_deg < 0.01)

