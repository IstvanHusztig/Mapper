  assert: self.assertEqual(c['start velocity + offset (n=6)'], 'n 0/9')
  assert: self.assertEqual(c['start velocity + offset: not measured'], 'absent 9')
  assert: self.assertEqual(c['start velocity + offset: reduction n - tr'], 'n 0')
  assert: self.assertEqual(c['gyro bias (n=3)'], 'n 1/9: median 0.5, p95 0.5, max 0.5')
  assert: self.assertEqual(c['gyro bias: not measured'], 'absent 1, reduction below 0.5 7')
  assert: self.assertEqual(c['all windows'], 'n 8/9: median 4.5, p95 7.65, max 8')
