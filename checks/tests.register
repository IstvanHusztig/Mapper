  assert: CHECK(w_rms[a] == doctest::Approx(gait.rate_rms_deg_s[a]).epsilon(0.10))

[case] tests/synthetic_inertial_test.cpp :: synthetic IMU: the estimator's time conventions
  markers: -
  value: Motion turn(Eigen::Vector3d(0, 0, 1.5), 0.0)
  number: turn.rest(0.5).turn(1.2, 2.0, 0.5).rest(0.5)
  number: [yaw] return std::atan2(turn.state(t).rotation(1, 0), turn.state(t).rotation(0, 0))
  value: double worst_gyro = 0
  loop: for (int k = 1; k < rt.n_nodes(); k++)
  number: worst_gyro = std::max(worst_gyro, std::abs(rt.gyro_rad_s[k].z() * dt - (yaw(k * dt) - yaw((k - 1) * dt))))
  assert: CHECK(rt.gyro_rad_s[0].norm() == 0.0)
  value: Motion line(Eigen::Vector3d(0, 0, 1.5), 0.0)
  number: line.rest(0.5).change_speed(1.5, 2.0, 0.5).cruise(1.0).change_speed(-1.5, 2.0, 0.5).rest(0.5)
  value: double worst_acc = 0
  loop: for (int k = 0; k < rl.n_nodes(); k++)
  number: worst_acc = std::max(worst_acc, std::abs(rl.acc_g[k].x() * standard_gravity - (line.state((k + 1) * dt).velocity.x() - line.state(k * dt).velocity.x()) / dt))
  assert: CHECK(worst_gyro < 1e-12)
  assert: CHECK(worst_acc < 1e-9)
  assert: CHECK(rl.n_nodes() == static_cast<int>(std::floor(line.duration() / dt + 1e-9)))
  assert: CHECK(rl.acc_g[0].z() == doctest::Approx(1.0).epsilon(1e-12))
  assert: CHECK(rl.acc_g[0].head<2>().norm() < 1e-15)
  assert: CHECK(rl.t_s[3] == static_cast<double>(rl.t_ns[3]) / 1e9)
  assert: CHECK(rl.t_ns[3] - rl.t_ns[2] == o.dt_ns)

[case] tests/synthetic_inertial_test.cpp :: synthetic IMU: an independent strap-down integration reproduces the truth within the derived bounds
  markers: -
  value: double wmax = 0, wdmax = 0, Fmax = 0, Jmax = 0
  value: const double h = 1e-4
  number: for (double t = h; t < n * dt; t += 5e-4)
  number: wdmax = std::max(wdmax, ((b.body_rate - a.body_rate) / (2 * h)).norm())
  number: Fmax = std::max(Fmax, (s.acceleration + Eigen::Vector3d(0, 0, g)).norm())
  number: Jmax = std::max(Jmax, ((b.acceleration - a.acceleration) / (2 * h)).norm())
  number: wmax *= 1.05
  number: wdmax *= 1.05
  number: Fmax *= 1.05
  number: Jmax *= 1.05
  value: const double magnus = 1.5 * dt * dt * dt / 12.0 * wmax * wdmax
  value: const double force_term = wmax * Fmax * dt / 2.0
  value: const double quad_term = Jmax * dt * dt * dt / 4.0
  value: double worst_rot = 0, worst_force = 0, worst_quad = 0
  loop: for (int k = 0; k + 1 < n; k++)
  value: const MotionState s0 = m.state(k * dt), s1 = m.state((k + 1) * dt)
  value: const Eigen::Matrix3d integrated = exp_so3(rec.gyro_rad_s[k + 1] * dt)
  value: const Eigen::Vector3d est_a = s0.rotation * (rec.acc_g[k] * g) - Eigen::Vector3d(0, 0, g)
  number: worst_quad = std::max(worst_quad, (s1.position - s0.position - s0.velocity * dt - 0.5 * mean_a * dt * dt).norm())
  assert: CHECK(worst_rot <= magnus)
  assert: CHECK(worst_force <= force_term)
  assert: CHECK(worst_quad <= quad_term)
  value: Eigen::Matrix3d R = m.state(0.0).rotation
  value: Eigen::Vector3d v = m.state(0.0).velocity, p = m.state(0.0).position
  value: double Bth = 0, Bv = 0, Bp = 0
  value: double max_th = 0, max_v = 0, max_p = 0, worst_ratio = 0
  loop: for (int k = 0; k + 1 < n; k++)
  value: const Eigen::Vector3d a = R * (rec.acc_g[k] * g) - Eigen::Vector3d(0, 0, g)
  number: p += v * dt + 0.5 * a * dt * dt
  number: R = R * exp_so3(rec.gyro_rad_s[k + 1] * dt)
  number: Bp += dt * Bv + 0.5 * dt * dt * Ba + quad_term
  value: const MotionState s = m.state((k + 1) * dt)
  assert: CHECK(within)
  assert: CHECK(max_th < 6e-6)
  assert: CHECK(max_v < 1e-2)
  assert: CHECK(max_p < 7e-2)

[case] tests/synthetic_inertial_test.cpp :: synthetic IMU: the noise statistics match the parameters
  markers: -
  value: Motion m(Eigen::Vector3d(0, 0, 1.5), 0.0)
  number: m.rest(160.0)
  number: o.seed = 5
  number: o.window_origin_node = 0
  value: const double dt = rec.dt_s(), deg = pi / 180.0, g = standard_gravity
  value: const double alpha = 1e-4
  loop: for (int a = 0; a < 3; a++)
  value: double sum = 0, sum2 = 0
  loop: for (int k = 1; k < n; k++)
  value: const double sigma = o.noise.gyro_arw_deg_sqrt_s[a] * deg / std::sqrt(dt), count = n - 1
  value: const double mean = sum / count, var = (sum2 - count * mean * mean) / (count - 1)
  value: const auto interval = truth_stats::chi2_interval(count - 1, alpha)
  assert: CHECK((count - 1) * var / (sigma * sigma) > interval.first)
  assert: CHECK((count - 1) * var / (sigma * sigma) < interval.second)
  assert: CHECK(std::abs(mean) < 4.5 * sigma / std::sqrt(count))
  number: sum = sum2 = 0
  loop: for (int k = 0; k < n; k++)
  value: const double expected = (a == 2 ? g : 0.0) + rec.accel_offset_mps2[rec.bias_index(k)][a]
  value: const double mean_a = sum / count_a, var_a = (sum2 - count_a * mean_a * mean_a) / (count_a - 1)
  value: const auto interval_a = truth_stats::chi2_interval(count_a - 1, alpha)
  assert: CHECK((count_a - 1) * var_a / (sigma_a * sigma_a) > interval_a.first)
  assert: CHECK((count_a - 1) * var_a / (sigma_a * sigma_a) < interval_a.second)
  assert: CHECK(std::abs(mean_a) < 4.5 * sigma_a / std::sqrt(count_a))
  value: const int windows = static_cast<int>(rec.gyro_bias_rad_s.size()) - 2
  value: double sum_gyro = 0, sum_acc = 0
  loop: for (int w = 2; w < static_cast<int>(rec.gyro_bias_rad_s.size()); w++)
  number: sum_gyro += (rec.gyro_bias_rad_s[w] - rec.gyro_bias_rad_s[w - 1]).squaredNorm()
  number: sum_acc += (rec.accel_offset_mps2[w] - rec.accel_offset_mps2[w - 1]).squaredNorm()
  value: const double var_gyro = std::pow(o.noise.gyro_bias_rw_deg_s_sqrt_s * deg, 2) * T, var_acc = std::pow(o.noise.accel_offset_rw_mps2_sqrt_s, 2) * T
  value: const auto interval = truth_stats::chi2_interval(3.0 * windows, alpha)
  number: MESSAGE(windows << " window steps: gyro bias variance ratio " << sum_gyro / (3.0 * windows) / var_gyro << ", offset " << sum_acc / (3.0 * windows) / var_acc)
  assert: CHECK(sum_gyro / var_gyro > interval.first)
  assert: CHECK(sum_gyro / var_gyro < interval.second)
  assert: CHECK(sum_acc / var_acc > interval.first)
  assert: CHECK(sum_acc / var_acc < interval.second)

[case] tests/synthetic_inertial_test.cpp :: synthetic IMU: bias and offset are constant inside a window, step between windows, and the seed decides
  markers: -
  value: Motion m(Eigen::Vector3d(0, 0, 1.5), 0.0)
  number: m.rest(5.0)
  number: o.noise.gyro_bias_rw_deg_s_sqrt_s = 0.05
  number: o.noise.accel_offset_rw_mps2_sqrt_s = 0.05
  number: o.noise.gyro_bias0_deg_s = Eigen::Vector3d(0.1, -0.2, 0.3)
  number: o.window_origin_node = 100
  number: o.nodes_per_window = 180
  value: const double deg = pi / 180.0
  value: int steps = 0
  loop: for (int k = 1; k < rec.n_nodes(); k++)
  value: const bool same = rec.gyro_rad_s[k] == rec.gyro_rad_s[k - 1] && rec.acc_g[k] == rec.acc_g[k - 1]
  value: const bool boundary = k > o.window_origin_node && (k - o.window_origin_node) % o.nodes_per_window == 0
  assert: CHECK(same == !boundary)
  assert: CHECK(steps > 10)
  assert: CHECK((rec.gyro_rad_s[50] - Eigen::Vector3d(0.1, -0.2, 0.3) * deg).norm() < 1e-15)
  assert: CHECK((rec.gyro_rad_s[150] - Eigen::Vector3d(0.1, -0.2, 0.3) * deg).norm() < 1e-15)
  assert: CHECK(rec.truth_at_node(150).gyro_bias == rec.truth_at_node(100).gyro_bias)
  assert: CHECK(rec.truth_at_node(300).gyro_bias != rec.truth_at_node(100).gyro_bias)
  assert: CHECK(again.gyro_rad_s == rec.gyro_rad_s)
  number: o2.seed = 2
  assert: CHECK(generate_imu(m, o2).gyro_rad_s != rec.gyro_rad_s)

