  number: sample_snapshot() :: w.gyro_bias.covariance = Eigen::Matrix3d::Identity() * (1e-6 + u(rng) * 1e-7)
  number: sample_snapshot() :: w.velocity.end_covariance(0, 1) = w.velocity.end_covariance(1, 0) = u(rng) * 1e-3
  number: sample_snapshot() :: w.imu_acc.assign(w.poses.size(), Eigen::Vector3d(u(rng), u(rng), 1.0 + u(rng) * 0.01))
  number: sample_snapshot() :: r.information_ratio = 0.5 + 0.5 * u(rng)
  number: sample_snapshot() :: r.at_rest = u(rng) > 0.5
  number: sample_snapshot() :: r.duration_s = 0.4 + 0.01 * u(rng)
  number: sample_snapshot() :: s.total_length_of_calculated_trajectory = 44.4 + u(rng)
  number: sample_snapshot() :: s.consecutive_distance = 12.3 + u(rng)
  loop: same() :: for (size_t k = 0; k < a.poses.size(); k++)
  loop: same() :: for (size_t k = 0; k < a.motion_model_poses.size(); k++)
  loop: same() :: for (size_t i = 0; i < a.size(); i++)

[case] tests/odometry_snapshot_test.cpp :: odometry snapshot: written and read back bit for bit
  markers: -
  assert: REQUIRE(write_odometry_snapshot(file.path, written, config, why))
  assert: REQUIRE(read_odometry_snapshot(file.path, config, read, why))
  assert: CHECK(same(read.windows, written.windows))
  assert: CHECK(same(read.m_g, written.m_g))
  assert: CHECK(read.total_length_of_calculated_trajectory == written.total_length_of_calculated_trajectory)
  assert: CHECK(read.consecutive_distance == written.consecutive_distance)

[case] tests/odometry_snapshot_test.cpp :: odometry snapshot: a format 1 file (before the readings) is read with the windows' readings absent
  markers: -
  assert: REQUIRE(write_odometry_snapshot(file.path, written, config, why))
  value: size_t block = 8
  number: block += 1 + (w.readings ? 8 + 24 + 1 + 24 + 8 : 0)
  assert: REQUIRE(bytes.size() > block + 12)
  value: const std::uint32_t version = 1
  number: std::memcpy(&bytes[8], &version, sizeof(version))
  assert: REQUIRE(read_odometry_snapshot(file.path, config, read, why))
  assert: REQUIRE(read.windows.size() == written.windows.size())
  assert: CHECK_FALSE(w.readings.has_value())
  assert: CHECK(read.consecutive_distance == written.consecutive_distance)
  assert: REQUIRE(write_odometry_snapshot(file.path, written, config, why))
  number: std::filesystem::resize_file(file.path, std::filesystem::file_size(file.path) - 3)
  assert: CHECK_FALSE(read_odometry_snapshot(file.path, config, read, why))
  assert: CHECK(why.find("window readings") != std::string::npos)

[case] tests/odometry_snapshot_test.cpp :: odometry snapshot: refused for other odometry settings, accepted for other post-processing settings
  markers: -
  assert: REQUIRE(write_odometry_snapshot(file.path, sample_snapshot(), config, why))
  number: odometry.nr_iter += 1
  assert: CHECK_FALSE(read_odometry_snapshot(file.path, odometry, read, why))
  assert: CHECK(why.find("odometry settings") != std::string::npos)
  number: grid.in_out_params_indoor.resolution_X += 0.01
  assert: CHECK_FALSE(read_odometry_snapshot(file.path, grid, read, why))
  number: holdout.holdout_block_s = 0.01
  assert: CHECK_FALSE(read_odometry_snapshot(file.path, holdout, read, why))
  number: post.loop_closure_cross_floor_max_vertical_m = 6.0
  number: post.loop_closure_odometry_weak_ratio = 0.1
  number: post.loop_closure_fine_time_min_sigma_m = 2.5
  assert: CHECK(read_odometry_snapshot(file.path, post, read, why))

