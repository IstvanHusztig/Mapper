  value: const Eigen::Vector3d v0(1.0, 0.0, 0.0)
  value: [constant velocity from the previous window] Window w = moving_window(n, 0.0, 0.0)
  assert: [constant velocity from the previous window] CHECK_FALSE(r.stationary)
  loop: [constant velocity from the previous window] for (int k = 0; k < n; k++)
  assert: [constant velocity from the previous window] CHECK(w.poses[k].translation().isApprox(end + v0 * (k * dt), 1e-12))
  assert: [constant velocity from the previous window] CHECK(w.motion_model_poses.size() == w.poses.size())
  value: [IMU integration: p = v t + a t^2 / 2] Window w = moving_window(n, 0.0, 0.0)
  value: [IMU integration: p = v t + a t^2 / 2] const Eigen::Vector3d a(0.5, -0.2, 0.0)
  loop: [IMU integration: p = v t + a t^2 / 2] for (int k = 0; k < n; k++)
  assert: [IMU integration: p = v t + a t^2 / 2] CHECK(w.poses[k].translation().isApprox(end + v0 * t + 0.5 * a * t * t, 1e-9))
  value: [a window at rest is predicted without motion] Window w = moving_window(n, 0.0, 0.0)
  number: o.zupt_acc_threshold_mps2 = 0.3
  number: o.zupt_gyro_threshold_rad_s = 0.05
  assert: [a window at rest is predicted without motion] CHECK(r.stationary)
  loop: [a window at rest is predicted without motion] for (int k = 0; k < n; k++)
  assert: [a window at rest is predicted without motion] CHECK(w.poses[k].translation().isApprox(end, 1e-12))
  value: [mean shift between the two previous windows, and its plausibility limit] const Window before = moving_window(n, 1.0, 0.0, pose(3.0 - n * dt, 1.0, 0.0, 0.0))
  value: [mean shift between the two previous windows, and its plausibility limit] Window w = moving_window(n, 0.0, 0.0)
  assert: [mean shift between the two previous windows, and its plausibility limit] CHECK_FALSE(r.mean_shift_dropped)
  loop: [mean shift between the two previous windows, and its plausibility limit] for (int k = 0; k < n; k++)
  assert: [mean shift between the two previous windows, and its plausibility limit] CHECK(w.poses[k].translation().isApprox(end + shift * k, 1e-12))
  value: [mean shift between the two previous windows, and its plausibility limit] const Window far = moving_window(n, 1.0, 0.0, pose(-100.0, 1.0, 0.0, 0.0))
  value: [mean shift between the two previous windows, and its plausibility limit] Window w2 = moving_window(n, 0.0, 0.0)
  assert: [mean shift between the two previous windows, and its plausibility limit] CHECK(predict_window_poses(w2, previous, &far, v0, PosePredictionOptions()).mean_shift_dropped)
  loop: [mean shift between the two previous windows, and its plausibility limit] for (int k = 0; k < n; k++)
  assert: [mean shift between the two previous windows, and its plausibility limit] CHECK(w2.poses[k].translation().isApprox(end, 1e-12))

[case] tests/window_steps_test.cpp :: apply_gyro_bias_prior grows the prior and removes the bias from the guess
  markers: -
  value: const int n = 50
  value: const double bias = 0.1
  value: Window w = moving_window(n, 1.0, bias)
  number: carried.mean = Eigen::Vector3d(0.0, 0.0, bias)
  number: carried.covariance = Eigen::Matrix3d::Identity() * 1e-4
  value: const double rw = 0.01
  value: const double duration = (n - 1) * dt
  assert: CHECK(prior.mean == carried.mean)
  assert: CHECK(prior.covariance.isApprox(carried.covariance + Eigen::Matrix3d::Identity() * (rw * rw * duration), 1e-15))
  assert: CHECK(w.gyro_bias.mean == prior.mean)
  assert: CHECK(w.gyro_bias.covariance == prior.covariance)
  loop: for (int k = 0; k < n; k++)
  assert: CHECK(w.poses[k].linear().isApprox(Eigen::Matrix3d::Identity(), 1e-12))
  assert: CHECK(w.motion_model_poses[k].matrix() == w.poses[k].matrix())

[case] tests/window_steps_test.cpp :: repropagate_window_tail continues the tail with the kept velocity and the IMU rotation
  markers: -
  value: const int n = 60
  value: const int tail = 5
  value: Window w = moving_window(n, 1.0, 0.0)
  value: const Window imu = moving_window(n, 1.0, 0.4)
  number: w.poses[k].translation().y() += 0.3
  number: repropagate_window_tail(w, 0, 20, Eigen::Vector3d::Zero())
  loop: [no tail nodes: nothing changes] for (int k = 0; k < n; k++)
  assert: [no tail nodes: nothing changes] CHECK(w.poses[k].matrix() == before.poses[k].matrix())
  number: repropagate_window_tail(w, tail, 20, Eigen::Vector3d::Zero())
  value: [the tail continues from the last kept node] const int a = n - 1 - tail
  loop: [the tail continues from the last kept node] for (int k = 0; k <= a; k++)
  assert: [the tail continues from the last kept node] CHECK(w.poses[k].matrix() == before.poses[k].matrix())
  loop: [the tail continues from the last kept node] for (int k = a + 1; k < n; k++)
  assert: [the tail continues from the last kept node] CHECK(w.poses[k].translation().isApprox(Eigen::Vector3d(k * dt, 0.0, 0.0), 1e-9))
  value: [the tail continues from the last kept node] const Eigen::Matrix3d expected = Eigen::AngleAxisd(0.4 * (k - a) * dt, Eigen::Vector3d::UnitZ()).toRotationMatrix()
  assert: [the tail continues from the last kept node] CHECK(w.poses[k].linear().isApprox(expected, 1e-9))
  number: repropagate_window_tail(w, tail, 4, Eigen::Vector3d::Zero())
  assert: [a short velocity span (a slower IMU) gives the same tail at constant velocity] CHECK(w.poses[k].translation().isApprox(Eigen::Vector3d(k * dt, 0.0, 0.0), 1e-9))
  number: repropagate_window_tail(w, tail, 0, Eigen::Vector3d::Zero())
  loop: [no velocity span, or one longer than the kept nodes: nothing changes] for (int k = 0; k < n; k++)
  assert: [no velocity span, or one longer than the kept nodes: nothing changes] CHECK(w.poses[k].matrix() == before.poses[k].matrix())
  number: repropagate_window_tail(w, tail, 20, Eigen::Vector3d(0.0, 0.0, 0.4))
  assert: [a bias update removes rotation from the IMU increments] CHECK(w.poses[k].linear().isApprox(Eigen::Matrix3d::Identity(), 1e-9))

[case] tests/window_steps_test.cpp :: convergence_of finds when the poses settle and when delta drops below the fast threshold
  markers: -
  value: double x = 0.0
  loop: for (int i = 0; i < 10; i++)
  number: if (i < 6)
  number: x += 0.01 * std::pow(0.1, i)
  number: poses_after.push_back({pose(0, 0, 0, 0), pose(1, 0, 0, 0), pose(2 + x, 0, 0, 0)})
  number: deltas.push_back(0.5 * std::pow(0.1, i))
  value: const IterationConvergence c = convergence_of(poses_after, deltas, 1e-4, 0.001 * 3.14159265358979 / 180.0, 1e-2)
  assert: CHECK(c.iterations == 10)
  assert: CHECK(c.settled_after == 3)
  assert: CHECK(c.fast_stop_after == 3)
  assert: CHECK(c.fast_stop_position_error_m == doctest::Approx(1.11e-5).epsilon(1e-6))
  assert: CHECK(c.fast_stop_rotation_error_rad == doctest::Approx(0.0))
  number: poses_after[7][1] = pose(1, 0, 0, 0.01)
  value: [a rotation that settles late] const IterationConvergence r = convergence_of(poses_after, deltas, 1e-4, 0.001 * 3.14159265358979 / 180.0, 1e-2)
  assert: [a rotation that settles late] CHECK(r.settled_after == 9)
  number: poses_after.resize(2)
  number: deltas.resize(2)
  value: [a run cut short is measured against its last iteration] const IterationConvergence r = convergence_of(poses_after, deltas, 1e-4, 0.001 * 3.14159265358979 / 180.0, 1e-2)
  assert: [a run cut short is measured against its last iteration] CHECK(r.iterations == 2)
  assert: [a run cut short is measured against its last iteration] CHECK(r.settled_after == 2)
  assert: [a run cut short is measured against its last iteration] CHECK(r.fast_stop_after == 0)

[case] tests/window_steps_test.cpp :: integrate_window_translations follows the accelerometer from the start velocity
  markers: -
  value: const double g = 9.80665
  number: const Eigen::Vector3d a(1.0, -0.5, 0.2), v0(1.2, 0.3, 0.0), start(2.0, -1.0, 0.5)
  value: double t = 0.0
  loop: for (int k = 0; k < 40; k++)
  number: w.poses.push_back(pose(0.0, 0.0, 0.0, 0.3 * t))
  number: w.timestamps.push_back({t, 0.0})
  number: w.imu_acc.push_back(w.poses.back().linear().transpose() * (a + Eigen::Vector3d(0.0, 0.0, g)) / g)
  number: t += (k % 3 == 0) ? 0.0002 : 0.0015
  number: w.poses[0].translation() = start
  assert: REQUIRE(integrate_window_translations(w, v0, Eigen::Vector3d(0.0, 0.0, 1.0), g))
  value: double worst = 0.0
  loop: for (size_t k = 0; k < w.poses.size(); k++)
  number: worst = std::max(worst, (w.poses[k].translation() - (start + v0 * tk + 0.5 * a * tk * tk)).norm())
  assert: CHECK(w.motion_model_poses[k].isApprox(w.poses[k]))
  assert: CHECK(worst < 1e-12)
  assert: CHECK(Eigen::AngleAxisd(w.poses.back().linear()).angle() == doctest::Approx(0.3 * w.timestamps.back().first))
  value: Window no_imu = moving_window(5, 1.0, 0.0)
  assert: CHECK_FALSE(integrate_window_translations(no_imu, v0, Eigen::Vector3d(0.0, 0.0, 1.0), g))

[case] tests/window_steps_test.cpp :: window_rests: still with gravity only, not while walking
  markers: -
  value: constexpr int n = 200
  loop: for (int k = 0; k < n; k++)
  value: const double t = 0.002 * k
  number: still.push_back(Eigen::Vector3d(0.0, 0.0, 1.0))
  number: walking.push_back(Eigen::Vector3d(2.0 / 9.80665 * std::sin(2.0 * 3.14159265358979323846 * 2.0 * t), 0.0, 1.0))
  assert: CHECK(window_rests(poses, ts, still, angles, 1.0, 0.1, 0.01))
  assert: CHECK_FALSE(window_rests(poses, ts, walking, angles, 1.0, 0.1, 0.01))

[case] tests/window_steps_test.cpp :: predict_window_poses steps: the mean shift per node and its limit
  markers: -
  value: Window before = turning_window(360), previous = turning_window(360)
  number: before.poses.back().translation() = Eigen::Vector3d(1.0, 2.0, 0.0)
  number: previous.poses.back().translation() = Eigen::Vector3d(1.36, 2.0, 0.0)
  assert: CHECK_FALSE(dropped)
  assert: CHECK(shift.x() == doctest::Approx(0.001))
  assert: CHECK(shift.y() == doctest::Approx(0.0))
  number: previous.poses.back().translation() = Eigen::Vector3d(501.0, 2.0, 0.0)
  assert: CHECK(mean_shift_of(previous, &before, dropped).isZero())
  assert: CHECK(dropped)
  assert: CHECK(mean_shift_of(previous, nullptr, dropped).isZero())
  assert: CHECK_FALSE(dropped)

[case] tests/window_steps_test.cpp :: predict_window_poses steps: the chained guess equals place_window_after
  markers: -
  value: Window previous = turning_window(20)
  number: previous.poses.back().translation() = Eigen::Vector3d(3.0, -1.0, 0.5)
  value: Window placed = turning_window(30), predicted = turning_window(30)
  assert: REQUIRE(predicted.poses.size() == placed.poses.size())
  loop: for (size_t k = 0; k < placed.poses.size(); k++)
  assert: CHECK(predicted.poses[k].linear() == placed.poses[k].linear())
  assert: CHECK(predicted.poses[k].translation() == placed.poses[k].translation())
  assert: CHECK(predicted.motion_model_poses.size() == predicted.poses.size())

[case] tests/window_steps_test.cpp :: predict_window_poses steps: the four ways to the translations
  markers: -
  value: const Window w = turning_window(11)
  value: const std::vector<Eigen::Vector3d> a(11, Eigen::Vector3d(0.5, 0.0, 0.0))
  number: const Eigen::Vector3d v0(1.0, 0.2, 0.0), shift(0.001, 0.0, 0.0)
  value: const double gap = 0.002
  value: const Eigen::Vector3d start = w.poses[0].translation()
  value: [accelerometer integration: p = v t + a t^2 / 2 from the gap on] const double t = 0.02
  value: [accelerometer integration: p = v t + a t^2 / 2 from the gap on] const Eigen::Vector3d expected = start + v0 * gap + v0 * t + 0.5 * a[0] * t * t
  assert: [accelerometer integration: p = v t + a t^2 / 2 from the gap on] CHECK((poses.back().translation() - expected).norm() < 1e-12)
  assert: [at rest: no motion] CHECK(p.translation() == start)
  loop: [constant velocity over the node times and the gap] for (size_t k = 0; k < poses.size(); k++)
  assert: [constant velocity over the node times and the gap] CHECK((poses[k].translation() - (w.poses[k].translation() + v0 * (0.002 * k + gap))).norm() < 1e-12)
  loop: [the mean shift per node] for (size_t k = 0; k < poses.size(); k++)
  assert: [the mean shift per node] CHECK((poses[k].translation() - (w.poses[k].translation() + shift * double(k))).norm() < 1e-15)

