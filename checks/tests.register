[case] tests/window_capture_test.cpp :: window capture: the capture leaves the run unchanged, and a replay with the same settings repeats it bit for bit
  markers: -
  value: const Recording r = loop_recording(1)
  call: run(r, c, nullptr)
  call: run(r, c, &sink)
  assert: REQUIRE(sink.written)
  assert: CHECK(capture.first == 5)
  assert: CHECK(capture.last == 12)
  assert: REQUIRE(capture.outcomes.size() == capture.last - capture.first + 1)
  assert: CHECK(same_poses(plain[i].poses, captured_run[i].poses))
  assert: CHECK(same_poses(capture.outcomes[k].poses, captured_run[capture.first + k].poses))
  assert: REQUIRE(write_window_capture(file, capture, c, why))
  assert: REQUIRE(read_window_capture(file, read, hash, why))
  assert: CHECK(hash == odometry_settings_hash(c))
  assert: CHECK_FALSE(same.cancelled)
  assert: CHECK(same.identical == capture.outcomes.size())
  assert: CHECK(same.largest_position_difference_m == 0.0)
  assert: CHECK_FALSE(other.cancelled)
  assert: CHECK(other.outcomes.size() == capture.outcomes.size())
  assert: CHECK(other.identical < capture.outcomes.size())

[case] tests/window_capture_test.cpp :: window capture: the range is the windows that start within it
  markers: -
  assert: CHECK(capture_range(windows, 1.0, 5.0, first, last))
  assert: CHECK(first == 1)
  assert: CHECK(last == 2)
  assert: CHECK(capture_range(windows, 0.0, 100.0, first, last))
  assert: CHECK((first == 0 && last == 4))
  assert: CHECK_FALSE(capture_range(windows, 4.5, 5.5, first, last))
  assert: CHECK_FALSE(capture_range(windows, -1.0, -1.0, first, last))
  assert: CHECK_FALSE(capture_range(windows, 3.0, 2.0, first, last))

