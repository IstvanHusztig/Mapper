[case] tests/test_check_register.py :: HolesTest.test_fail_and_fail_check_are_assertions_and_lambdas_that_assert_are_helpers
  markers: -
  number: pins = [b for b in reg.blocks if b.name == 'pins'][0].lines
  assert: self.assertIn(('assert', '[pin] FAIL_CHECK(message.str())'), pins)
  assert: self.assertIn(('call', 'pin("defaults", 1ull, 0x1ad4c1d5688ff94aull)'), pins)
  assert: self.assertIn(('assert', 'FAIL("stop")'), [b for b in reg.blocks if b.name == 'fail macro'][0].lines)
  number: calls = [b for b in reg.blocks if b.name == 'lambda call'][0].lines
  assert: self.assertIn(('call', 'check_all(buckets)'), calls)
  assert: self.assertFalse([t for k, t in calls if 'not_a_helper' in t and k == 'call'])
  number: fb = [b for b in reg.blocks if b.name is None][0].lines
  assert: self.assertIn(('assert', 'check_all() :: CHECK(value > 0.0)'), fb)
  assert: self.assertIn(('call', 'check_all() :: inside(value, 100.0)'), fb)
  assert: self.assertEqual((tot['macros']['FAIL_CHECK'], tot['macros']['FAIL']), (1, 1))

