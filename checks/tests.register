  assert: CHECK(fine_time_patches(std::vector<V3>(wall.begin(), wall.begin() + 10), X, 0.07, rule()).point.empty())

[case] tests/loop_fine_time_test.cpp :: loop fine time: the held-out hash holds out a fifth, fixed by the position's cell, with a non-negative remainder
  markers: -
  assert: CHECK(fine_time_held_out(q, rule()) == fine_time_held_out(V3(std::floor(q.x()) + 0.5, std::floor(q.y()) + 0.5, std::floor(q.z()) + 0.5), rule()))
  assert: CHECK(held > 750)
  assert: CHECK(held < 1250)
  assert: CHECK(fine_time_held_out(V3(0.2, 0.7, 0.1), rule()))
