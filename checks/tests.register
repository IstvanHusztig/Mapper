  value: const double rad_to_deg = 180.0 / 3.14159265358979323846
  value: RecordingEstimator :: int resets = 0
  value: RecordingEstimator :: float initial_gain = -1.0f
  value: RecordingEstimator :: float gain = -1.0f
  value: RecordingEstimator :: Eigen::Quaternionf fixed{Eigen::AngleAxisf(0.5f, Eigen::Vector3f::UnitZ())}
  loop: still_imu() :: for (int i = 0; i < n; i++)
  number: still_imu() :: imu.push_back({{1.0 + 0.005 * i, 1000.0 + 0.005 * i}, gyro, Eigen::Vector3f(0.0f, 0.0f, 1.0f)})
  value: Flags :: int bias_samples = 1000
  value: Flags :: double bias_gate = 5.0
  default: run() :: defaults of (Imu &imu, ImuTrajectory &trajectory, const Flags &f = {}, double gain = 0.5)

[case] tests/orientation_test.cpp :: orientation: the filter starts with the first convention set and the configured gain
  markers: -
  value: Imu imu = still_imu(3, Eigen::Vector3f::Zero())
  value: const RecordingEstimator e = run(imu, trajectory, c.flags, 0.25)
  assert: CHECK(e.resets == 1)
  assert: CHECK(e.convention == c.expected)
  assert: CHECK(e.initial_gain == 0.25f)

[case] tests/orientation_test.cpp :: orientation: the gyroscope goes in degrees, with the bias of the first stationary samples removed
  markers: -
  value: const Eigen::Vector3f bias(0.01f, -0.02f, 0.03f)
  value: [without bias removal] Imu imu = still_imu(1200, bias)
  assert: [without bias removal] REQUIRE(e.updates.size() == 1200)
  loop: [without bias removal] for (int k = 0; k < 3; k++)
  assert: [without bias removal] CHECK(e.updates.back().gyro_deg_s[k] == doctest::Approx(bias[k] * rad_to_deg).epsilon(1e-6))
  value: [at rest: the median of the first 1000 samples is removed] Imu imu = still_imu(1200, bias)
  assert: [at rest: the median of the first 1000 samples is removed] CHECK(u.gyro_deg_s.norm() < 1e-6f)
  value: [moving: no bias is removed when the first 1000 samples vary too much] Imu imu = still_imu(1200, bias)
  loop: [moving: no bias is removed when the first 1000 samples vary too much] for (int i = 0; i < 1000; i += 2)
  number: imu[i].gyro.x() = 1.0f
  assert: [moving: no bias is removed when the first 1000 samples vary too much] CHECK(e.updates.back().gyro_deg_s.y() == doctest::Approx(bias.y() * rad_to_deg).epsilon(1e-6))
  value: [a window of 200 samples (1 s at a 200 Hz IMU): only those samples set the bias] Imu imu = still_imu(400, bias)
  loop: [a window of 200 samples (1 s at a 200 Hz IMU): only those samples set the bias] for (int i = 200; i < 400; i++)
  number: f.bias_samples = 200
  assert: [a window of 200 samples (1 s at a 200 Hz IMU): only those samples set the bias] CHECK(e.updates.front().gyro_deg_s.norm() < 1e-6f)
  loop: [a window of 200 samples (1 s at a 200 Hz IMU): only those samples set the bias] for (int k = 0; k < 3; k++)
  assert: [a window of 200 samples (1 s at a 200 Hz IMU): only those samples set the bias] CHECK(e.updates.back().gyro_deg_s[k] == doctest::Approx(-bias[k] * rad_to_deg).epsilon(1e-6))
  value: [a gate below the samples' variance rejects the bias as movement] Imu imu = still_imu(400, bias)
  loop: [a gate below the samples' variance rejects the bias as movement] for (int i = 0; i < 200; i += 2)
  number: imu[i].gyro.z() += 0.05f
  number: f.bias_samples = 200
  number: f.bias_gate = 1.0
  assert: [a gate below the samples' variance rejects the bias as movement] CHECK(e.updates.back().gyro_deg_s.x() == doctest::Approx(bias.x() * rad_to_deg).epsilon(1e-6))
  number: f.bias_gate = 5.0
  assert: [a gate below the samples' variance rejects the bias as movement] CHECK(std::abs(e2.updates.back().gyro_deg_s.x()) < 1e-6f)
  value: [no more samples than the window: no bias is removed] Imu imu = still_imu(200, bias)
  number: f.bias_samples = 200
  assert: [no more samples than the window: no bias is removed] CHECK(e.updates.back().gyro_deg_s.z() == doctest::Approx(bias.z() * rad_to_deg).epsilon(1e-6))

