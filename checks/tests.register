  assert: CHECK(worst < 1e-6)

[case] tests/window_cut_test.cpp :: window hand-off: the predicted guess of the next window keeps the motion between the two samples
  markers: -
  call: cut(c)
  value: const Eigen::Vector3d velocity(0.8, -0.3, 0.1)
  value: double worst_yaw = 0.0, worst_position = 0.0
  loop: for (size_t i = 1; i < c.windows.size(); i++)
  number: predict_window_poses(c.windows[i], c.windows[i - 1], nullptr, velocity, options)
  value: const Window &prev = c.windows[i - 1]
  loop: for (size_t k = 0; k < w.poses.size(); k++)
  value: const Eigen::Vector3d expected = prev.poses.back().translation() + velocity * (w.timestamps[0].first - prev.timestamps.back().first)
  number: worst_position = std::max(worst_position, (w.poses[0].translation() - expected).norm())
  assert: CHECK(worst_yaw < 1e-6)
  assert: CHECK(worst_position < 1e-9)

[case] tests/window_cut_test.cpp :: window hand-off: the points between two windows belong to the earlier window's last node
