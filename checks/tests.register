  assert: CHECK_FALSE(record.handed_on.velocity_end.has_value())
  value: const Eigen::Affine3d expected = sink.records[i - 1].handed_on.last_node_handed_on->pose * r.windows[i].imu_motion_from_previous
  assert: CHECK((record.prepared.first_pose->translation() - expected.translation()).norm() < 1.0)
