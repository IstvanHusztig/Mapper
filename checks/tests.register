  value: const Eigen::Vector3d v = Eigen::Vector3d(1.0, 0.03, 0.002).normalized()
  value: const double a = 1.3 * 3.14159265358979323846 / 180.0
  value: const ProjectedShiftWeight q = projected_shift_weight(t, 0.02, 0.04)
  assert: REQUIRE_MESSAGE(q.measured, q.why)
  assert: CHECK(std::abs(std::abs(q.removed.dot(v)) - 1.0) < 1e-12)
  value: const std::array<Eigen::Vector3d, 4> probes{Eigen::Vector3d::UnitX(), Eigen::Vector3d::UnitY(), Eigen::Vector3d(0.3, -0.8, 0.5).normalized(), v}
  assert: CHECK(std::abs(q.along(u) - u.dot(Wp * u)) <= 1e-9 * Wp.norm())
  assert: CHECK_FALSE(projected_shift_weight(t, 0.02, 0.04).measured)

[case] tests/synthetic_loop_test.cpp :: synthetic loop smoke: a short run completes, its preconditions hold, its deterministic fields repeat
  markers: skip(loop_cases_skipped)
  value: constexpr int r3_windows = 14
  value: constexpr int r2_windows = 10
  assert: CHECK(run->completed)
  assert: CHECK(run->valid())
  assert: CHECK(run->time_limit_windows == 0)
  assert: CHECK(run->map_rebuilds == 0)
  assert: CHECK(run->unavailable.records_missing == 0)
  assert: CHECK(run->unavailable.handoff_not_done == 0)
  assert: CHECK(run->unavailable.move_joint == run->windows_run)
  assert: CHECK(run->unavailable.total() > 0)
  assert: CHECK(classified == run->windows_run)
  assert: REQUIRE(a.windows_run == r3_windows)
  assert: CHECK(a.windows_cut == r3.n_windows)
  assert: CHECK(a.class_windows[int(WindowClass::rest)] >= 2)
  assert: CHECK(a.class_windows[int(WindowClass::seen)] >= 1)
  assert: CHECK_MESSAGE(repeat, "first difference: ", difference)
  assert: REQUIRE(c.windows_run == r2_windows)
  assert: CHECK(c.r2.present)
  assert: CHECK(c.r2.turn_window > r2_windows)
  assert: CHECK(c.r2.exit_window > c.r2.turn_window)
  assert: CHECK_FALSE(c.r2.exit_in_run)
  assert: CHECK(c.r2.landmark_cells.size() >= 20)
  assert: CHECK(c.not_evaluated.size() == 1)
  assert: WARN_MESSAGE(false, "the smoke case took more than one minute: ", f(total_s, 1), " s")

