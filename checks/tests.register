  assert: CHECK(moved <= 0.1 + 1e-9)

[case] tests/loop_fine_time_test.cpp :: loop fine time edges: an edge whose information lies late in its segment agrees; one the informative scans contradict stops the run
  markers: -
  call: build_corridor(c, {3.0, 6.5, 9.0, 13.0, 17.0}, nullptr, bump)
  value: const ConstructedEdge late = constructed_edge(c, 12, 4, Eigen::Affine3d::Identity(), {28, 29})
  call: step(c, windows, {late.edge}, {&late.registration})
  assert: REQUIRE(report.runs.size() == 1)
  assert: CHECK(report.runs[0].status == "applied")
  assert: REQUIRE(report.edges.size() == 1)
  value: const LoopFineTimeEdgeRow &row = report.edges[0]
  assert: CHECK(!row.target)
  assert: CHECK(row.first_pose_m == doctest::Approx(bump(24 * 0.4)))
  assert: CHECK(std::abs(row.rho_before_m) < 1e-12)
  assert: CHECK(std::abs(row.rho_after_m) < 1e-12)
  assert: CHECK(row.informed_share == doctest::Approx(1.0))
  assert: CHECK(row.limit_m == doctest::Approx(0.15))
  assert: CHECK(row.cls == FineTimeEdgeClass::agrees)
  assert: CHECK(!same_bits(windows, c.corrected))
  value: const ConstructedEdge against = constructed_edge(c, 12, 3, shift_x(mean_bump), {18, 19, 20, 21, 22, 23})
  call: step(c, windows, {late.edge, against.edge}, {&late.registration, &against.registration})
  assert: REQUIRE(report.runs.size() == 1)
  assert: CHECK(report.runs[0].status == "not applied")
  assert: CHECK(report.runs[0].cause == "edge 12 -> 3 contradicted")
  assert: REQUIRE(report.edges.size() == 2)
  value: const LoopFineTimeEdgeRow &row = report.edges[1]
  assert: CHECK(row.stopped_run)
  assert: CHECK(row.rho_after_m == row.rho_before_m)
  assert: CHECK(!report.edges[0].stopped_run)
  assert: CHECK(same_bits(windows, c.corrected))

[case] tests/loop_fine_time_test.cpp :: loop fine time edges: a later visit registered onto a moved part of the run stops the run
  markers: -
  call: build_corridor(c, {3.0, 6.5, 9.0, 13.0, 17.0}, nullptr, bump)
  value: const double k_i = bump(18 * 0.4)
  value: const ConstructedEdge onto = constructed_edge(c, 3, 12, shift_x(-k_i), {72, 73, 74, 75, 76, 77})
  call: step(c, windows, {onto.edge}, {&onto.registration})
  assert: REQUIRE(report.runs.size() == 1)
  assert: REQUIRE(report.edges.size() == 1)
  value: const LoopFineTimeEdgeRow &row = report.edges[0]
  assert: CHECK(row.target)
  assert: CHECK(std::abs(row.rho_before_m) < 1e-12)
  assert: CHECK(row.informed_share == doctest::Approx(1.0))
  assert: CHECK(row.stopped_run)
  assert: CHECK(report.runs[0].status == "not applied")
  assert: CHECK(report.runs[0].cause == "edge 3 -> 12 contradicted")
  assert: CHECK(same_bits(windows, c.corrected))

[case] tests/loop_fine_time_test.cpp :: loop fine time replay: a capture made with the step on replays bit for bit; another graph or other eligible runs are refused
  markers: -
  call: build_corridor(c, {3.0, 6.5, 9.0, 13.0, 17.0}, bump, nullptr, {{13, 27}, {70, 72}})
  assert: REQUIRE(c.runs.size() == 2)
  assert: REQUIRE(c.runs[0].sigma_m >= 1.0)
  assert: REQUIRE(c.runs[1].sigma_m < 1.0)
  assert: REQUIRE(c.runs[1].sigma_m > 0.5)
  assert: REQUIRE(report.outcome == "applied")
  assert: REQUIRE(loops > 0)
  assert: REQUIRE(report.fine_time.ran)
  assert: REQUIRE(report.fine_time.runs.size() == 1)
  assert: REQUIRE(report.fine_time.runs[0].scored)
  assert: REQUIRE(scores.captured().has_value())
  assert: CHECK(contains(logger.infos, "loop closure fine time: run windows 13-27"))
  assert: CHECK(contains(logger.infos, "loop closure fine time: step "))
  assert: REQUIRE(report.fine_time.runs[0].status == "applied")
  assert: CHECK(own.missing.empty())
  assert: CHECK(own.report.outcome == "applied")
  assert: CHECK(own.identical_nodes == own.nodes)
  assert: REQUIRE(write_loop_closure_capture(file, capture, c.config, why))
  assert: REQUIRE(read_loop_closure_capture(file, back, settings, why))
  assert: REQUIRE(back.fine_time.has_value())
  assert: CHECK(back.fine_time->curves.size() == capture.fine_time->curves.size())
  assert: CHECK(loop_closure_replay_settings(settings, c.config).changed.empty())
  assert: CHECK(from_file.identical_nodes == from_file.nodes)
  assert: REQUIRE(write_loop_closure_replay_json(json, own, LoopClosureSettingsDifference{}, c.config, why))
  assert: REQUIRE(write_loop_fine_time_csv(csv, own.report.fine_time, why))
  assert: CHECK(json_text.find("\"fine_time\"") != std::string::npos)
  assert: CHECK(json_text.find("\"rho_after_m\"") != std::string::npos)
  assert: CHECK(csv_text.rfind("run,window,in_run,start_s,mid_s,offset_m,supported,train_patches,held_patches,matched_most,train_before_m,", 0) == 0)
  assert: CHECK(std::count(csv_text.begin(), csv_text.end(), '\n') == 1 + 27)
  assert: CHECK(other_graph.report.outcome == "fine_time_curves_unavailable")
  assert: CHECK(other_graph.loops == 0)
  assert: CHECK(same_bits(other_graph.windows, capture.windows))
  assert: CHECK(contains(graph_logger.errors, "another pose graph result"))
  assert: CHECK(contains(graph_logger.errors, "--from-snapshot"))
  assert: CHECK(other_runs.report.outcome == "fine_time_curves_unavailable")
  assert: CHECK(same_bits(other_runs.windows, capture.windows))
  assert: CHECK(contains(sigma_logger.errors, "other eligible runs"))
  assert: CHECK(without.report.outcome == "applied")
  assert: CHECK(switched_off.report.outcome == "applied")
  assert: CHECK(!switched_off.report.fine_time.ran)
  assert: CHECK(same_bits(without.windows, switched_off.windows))
  assert: CHECK(!same_bits(own.windows, switched_off.windows))
  value: const auto refused_with = [&](const std::function<void(LoopFineTimeCurves &)> &damage, const std::string &cause) {...}
  assert: CHECK_MESSAGE(r.report.outcome == "fine_time_curves_unavailable", cause)
  assert: CHECK(same_bits(r.windows, capture.windows))
  assert: CHECK_MESSAGE(contains(bad_logger.errors, cause), cause)
  assert: CHECK(replay_loop_closure(older, c.config, older_logger).report.outcome == "fine_time_curves_unavailable")
  assert: CHECK(contains(older_logger.errors, "holds no fine-time score curves"))
  assert: CHECK(refused.report.outcome == "fine_time_without_readings")
  assert: CHECK(refused.loops == 0)
  assert: CHECK(same_bits(refused.windows, capture.windows))

[case] tests/loop_fine_time_test.cpp :: loop fine time capture file: format 4 keeps the curves bit for bit; format 3 loads without them
  markers: -
  call: build_corridor(c, {3.0, 6.5, 9.0, 13.0, 17.0}, nullptr, bump)
  assert: REQUIRE(write_loop_closure_capture(file, capture, c.config, why))
  assert: REQUIRE(read_loop_closure_capture(file, back, settings, why))
  assert: REQUIRE(back.fine_time.has_value())
  assert: REQUIRE(g.segment_poses.size() == f.segment_poses.size())
  assert: CHECK(g.segment_poses[k].matrix() == f.segment_poses[k].matrix())
  assert: REQUIRE(g.eligible.size() == 1)
  assert: CHECK(g.eligible[0].run == 1)
  assert: CHECK(g.eligible[0].support_last == 33)
  assert: CHECK(g.eligible[0].overlap)
  assert: CHECK(g.eligible[0].sigma_m == run.sigma_m)
  assert: CHECK(g.eligible[0].pin_end_s == run.pin_end_s)
  assert: CHECK(g.eligible[0].axis == run.axis)
  assert: CHECK(g.eligible[0].axis_odometry == run.axis_odometry)
  assert: REQUIRE(g.curves.size() == 1)
  assert: CHECK(g.curves[0].bound_m == 4.7)
  assert: CHECK(g.curves[0].grid == curves.grid)
  assert: CHECK(g.curves[0].reference_patches == 17)
  assert: REQUIRE(g.curves[0].windows.size() == 2)
  assert: CHECK(g.curves[0].windows[0].training == a.training)
  assert: CHECK(g.curves[0].windows[0].training_matched == a.training_matched)
  assert: CHECK(g.curves[0].windows[0].held_out.empty())
  assert: CHECK(g.curves[0].windows[1].held_out == b.held_out)
  assert: CHECK(g.curves[0].windows[1].held_out_matched == b.held_out_matched)
  assert: CHECK(g.curves[0].windows[1].training_patches == 2)
  assert: REQUIRE(write_loop_closure_capture(file, without, c.config, why))
  assert: REQUIRE(short_bytes.size() + 1 < bytes.size())
  value: const std::uint32_t three = 3
  assert: REQUIRE(read_loop_closure_capture(file, back, settings, why))
  assert: CHECK(!back.fine_time.has_value())
  assert: CHECK(back.windows.size() == capture.windows.size())
  value: const size_t grid_count = flag + 1 + (8 + S * 128) + (8 + 93) + 8 + 4 + 4 + 8
  value: const size_t windows_count = grid_count + 8 + 3 * 8 + 4
  value: const size_t try_blocks = flag - 6 * 72 - 8
  assert: CHECK_NOTHROW(read = read_loop_closure_capture(file, r, settings, why))
  assert: CHECK_MESSAGE(!read, what)
  assert: REQUIRE(stored == 2)
  assert: REQUIRE(stored == 3)
  assert: REQUIRE(stored == 6)

