  assert: CHECK(noise.origin[3] == doctest::Approx(1e12).epsilon(1e-9))
  assert: CHECK(noise.origin[4] == doctest::Approx(1e12).epsilon(1e-9))
  assert: CHECK(noise.origin[5] == doctest::Approx(1e12).epsilon(1e-9))
