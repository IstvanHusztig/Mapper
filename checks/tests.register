[case] tests/unit_cases_ndt_test.cpp :: unit case K7: the fractional projection's own step along the weak axis
  markers: -
  number: w.timestamps.push_back({0.0, 0.0})
  value: const double k = 50.0
  value: const double g = 0.2
  number: noise.projection_ratio = 0.1
  number: noise.projection_ratio_full = 0.2
  value: double step_at_half = 0.0
  loop: for (double s : {1.0, 0.75, 0.5, 0.25})
  value: Eigen::Matrix<double, 6, 6, Eigen::RowMajor> block = Eigen::Matrix<double, 6, 6>::Zero()
  number: block.diagonal() << 100.0 * k, 100.0 * k, k, 10.0 * k, 10.0 * k, 10.0 * k
  value: Eigen::Matrix<double, 6, 1> force = Eigen::Matrix<double, 6, 1>::Zero()
  number: force(2) = g
  number: sums.normal_information.push_back(Eigen::Vector3d(1.0, 1.0, ratio).asDiagonal())
  value: const double step = e.rhs(2, 0) / e.matrix(2, 2)
  assert: CHECK(e.matrix(0, 0) == doctest::Approx(100.0 * k).epsilon(1e-12))
  assert: CHECK(e.matrix(3, 3) == doctest::Approx(10.0 * k).epsilon(1e-12))
  assert: CHECK(e.matrix(2, 2) == doctest::Approx(s * s * k).epsilon(1e-9))
  assert: CHECK(e.rhs(2, 0) == doctest::Approx(s * g).epsilon(1e-9))
  assert: CHECK(step == doctest::Approx(unprojected / s).epsilon(1e-9))
  number: if (s == 0.5)
  assert: CHECK(step_at_half / (g / k) == doctest::Approx(2.0).epsilon(1e-9))

[case] tests/unit_cases_ndt_test.cpp :: unit case K7 marker: the fractional projection's own step at s = 0.5 is at most g / k
  markers: should_fail
  number: w.timestamps.push_back({0.0, 0.0})
  value: const double k = 50.0, g = 0.2, s = 0.5
  number: noise.projection_ratio = 0.1
  number: noise.projection_ratio_full = 0.2
  value: Eigen::Matrix<double, 6, 6, Eigen::RowMajor> block = Eigen::Matrix<double, 6, 6>::Zero()
  number: block.diagonal() << 100.0 * k, 100.0 * k, k, 10.0 * k, 10.0 * k, 10.0 * k
  value: Eigen::Matrix<double, 6, 1> force = Eigen::Matrix<double, 6, 1>::Zero()
  number: force(2) = g
  number: sums.normal_information.push_back(Eigen::Vector3d(1.0, 1.0, noise.projection_ratio + s * (noise.projection_ratio_full - noise.projection_ratio)).asDiagonal())
  value: const double step_in_g_over_k = (e.rhs(2, 0) / e.matrix(2, 2)) / (g / k)
  assert: CHECK(step_in_g_over_k <= 1.0 + 1e-9)

[case] tests/unit_cases_ndt_test.cpp :: unit case K9: the cell test on the same plane, axis-aligned and turned 45 degrees
  markers: -
  value: const double sigma_n = 0.003
  value: const NdtBucket aligned = plane_cell(sigma_n, 0.0)
  value: const NdtBucket turned = plane_cell(sigma_n, 45.0)
  assert: CHECK(ea.eigenvalues().maxCoeff() == doctest::Approx(1.0 / (sigma_n * sigma_n)).epsilon(1e-9))
  assert: CHECK(et.eigenvalues().maxCoeff() == doctest::Approx(ea.eigenvalues().maxCoeff()).epsilon(1e-9))
  assert: CHECK(aligned.inverse_computed)
  assert: CHECK(turned.inverse_computed)
  loop: for (double phi : {0.0, 15.0, 30.0, 45.0})
  number: thresholds << phi << " deg: " << std::fixed << std::setprecision(3) << thinnest_usable_mm(phi) << " mm; "
  assert: CHECK_FALSE(aligned.inverse_usable)
  assert: CHECK(turned.inverse_usable)
  assert: CHECK(thinnest_usable_mm(0.0) == doctest::Approx(3.16).epsilon(0.01))
  assert: CHECK(thinnest_usable_mm(45.0) == doctest::Approx(2.24).epsilon(0.01))

[case] tests/unit_cases_ndt_test.cpp :: unit case K10: the origin fix's rotation weight against 1 / sigma^2 in radians
  markers: -
  loop: for (int k = 0; k < 5; k++)
  number: w.timestamps.push_back({k * 0.002, k * 0.002})
  value: const double oracle = 1.0 / ((sigma_deg * DEG_TO_RAD) * (sigma_deg * DEG_TO_RAD))
  number: MESSAGE("K10 origin weights: position ", noise.origin[0], " (1 / (1e-6 m)^2), rotation ", noise.origin[3], " ", noise.origin[4], " ", noise.origin[5], "; oracle 1 / (", sigma_deg, " deg in rad)^2 = ", oracle, " (hypothesis: 1e12 where 3.3e15 was meant)")
  number: MESSAGE("K10 the equations' diagonal at the first node: ", e.matrix(0, 0), " ", e.matrix(1, 1), " ", e.matrix(2, 2), " | ", e.matrix(3, 3), " ", e.matrix(4, 4), " ", e.matrix(5, 5))
  assert: CHECK(noise.origin[0] == doctest::Approx(1e12).epsilon(1e-9))
  assert: CHECK(noise.origin[3] == doctest::Approx(1e12).epsilon(1e-9))
  assert: CHECK(noise.origin[4] == doctest::Approx(1e12).epsilon(1e-9))
  assert: CHECK(noise.origin[5] == doctest::Approx(1e12).epsilon(1e-9))
  assert: CHECK(e.matrix(3, 3) == doctest::Approx(noise.origin[3]).epsilon(1e-9))
  assert: CHECK(oracle == doctest::Approx(3.283e15).epsilon(1e-3))
  assert: CHECK(oracle / noise.origin[3] == doctest::Approx(3283.0).epsilon(1e-3))

[case] tests/unit_cases_ndt_test.cpp :: unit case K9 marker: the cell test gives the same usability for the plane axis-aligned and turned 45 degrees
