[case] tests/terms_at_truth_test.cpp :: terms at the truth: D4, the gap covariance's algebra, apart from its mean
  markers: -
  value: const double gap = 0.002, density = 0.0013, floor = 0.1
  value: const Eigen::Matrix3d C = Eigen::Matrix3d::Identity() * 0.3
  assert: CHECK((velocity_prior_cov_over_gap(C, density, floor, gap) - (C + (density * density * gap + floor * floor * gap * gap) * Eigen::Matrix3d::Identity())).cwiseAbs().maxCoeff() < 1e-18)
  value: constexpr double D = 0.01056
  value: const double noise = rec.acc_g[k](axis) * standard_gravity - (axis == 2 ? standard_gravity : 0.0)
  value: const double claimed = velocity_prior_cov_over_gap(Eigen::Matrix3d::Zero(), D, 0.0, rec.dt_s())(0, 0)
  value: const auto interval = truth_stats::chi2_interval(n, 0.01)
  assert: CHECK(inside_interval(sum2 / claimed, static_cast<double>(n)))

