  number: run_chain() :: loop.carry.velocity_mean = Eigen::Vector3d(s.motion.v(node_tau(1, T - 1)), 0.0, 0.0)
  number: run_chain() :: loop.carry.velocity_time_s = node_time(1, T - 1)
  value: run_chain() :: const double sb = 0.05 * DEG_TO_RAD
  value: run_chain() :: const size_t last = world.windows.size() - 1
  number: run_chain() :: if (inj.after >= 2)
  number: run_chain() :: run.ok = process_windows(loop, world.windows, 2, inj.after, c, world.state, ts_failure, false, world.store, preview, logger, progress, range)
  number: run_chain() :: p.translation() += p.linear() * Eigen::Vector3d(inj.along_m, 0.0, 0.0)
  number: run_chain() :: seed_grids(world.state, s, c, *inj.map_shift, s.seed + 1000)
  number: run_chain() :: run.ok = process_windows(loop, world.windows, inj.after + 1, last, c, world.state, ts_failure, false, world.store, preview, logger, progress, range)
  number: run_chain() :: run.ok = run.ok && run.records.size() == last - 1
  loop: run_chain() :: for (size_t w = 2; w <= last; w++)
  value: run_chain() :: int matches = 0
  number: run_chain() :: if (designated_face >= 0)
  number: run_chain() :: if (std::abs(g[f.axis] - f.value) > 0.05)
  value: Reading :: double first_x_error = 0.0
  value: Reading :: double first_pitch_deg = 0.0
  value: Reading :: double prior_mean_error = 0.0
  value: Reading :: double prior_sigma = 0.0
  value: Reading :: double start_error = 0.0
  value: Reading :: double start_move = 0.0
  value: Reading :: double end_error = 0.0
  value: Reading :: double end_sigma = 0.0
  value: Reading :: double ndt_along = 0.0, ndt_sideways = 0.0
  value: Reading :: double raw_along_share = 0.0
  value: Reading :: int iterations = 0
  value: Reading :: double delta = 0.0
  value: read() :: const int w = r.window - 1
  number: read() :: m.first_x_error = r.prepared.first_pose->translation().x() - s.motion.x(node_tau(w, 0))
  number: read() :: m.prior_mean_error = r.prepared.velocity_prior_mean->x() - s.motion.v(node_tau(w, 0))
  number: read() :: m.prior_sigma = std::sqrt((*r.prepared.velocity_prior_cov)(0, 0))
  number: read() :: m.start_error = r.velocity_start.x() - s.motion.v(node_tau(w, 0))
  number: read() :: m.end_error = r.handed_on.velocity_end->x() - s.motion.v(node_tau(w, T - 1))
  number: read() :: m.end_sigma = std::sqrt((*r.handed_on.velocity_end_cov)(0, 0))
  number: read() :: m.bias_sigma_deg_s = r.handed_on.bias_cov->diagonal().cwiseMax(0.0).cwiseSqrt() * RAD_TO_DEG
  number: read() :: m.ndt_along += row.weight[0][0]
  number: read() :: m.ndt_sideways += row.weight[0][1]
  number: read() :: if (I.trace() > 0.0)
  number: read() :: m.raw_along_share = r.result.directions[0].dot(I * r.result.directions[0]) / I.trace()
  default: f() :: defaults of (double v, int precision = 2)
  value: constexpr int corridor_end_face = 1
  value: constexpr double corridor_back = -3.0, corridor_end = 14.5
  number: corridor_spec() :: s.scene = synthetic::shifted(synthetic::box_scene({corridor_back, -1.0, 0.0}, {corridor_end, 1.0, 2.5}, false), synthetic::grid_offset)
  number: corridor_spec() :: s.motion.v0 = 1.5
  number: corridor_spec() :: s.motion.surge = 1.0
  number: corridor_spec() :: s.motion.omega = 2.0 * 3.14159265358979323846 * 1.5
  number: corridor_spec() :: s.z = 1.2 + synthetic::grid_offset.z()
  number: corridor_spec() :: s.range = 6.0
  number: corridor_spec() :: s.n_windows = 22
  value: blind_by_position() :: const double back = s.scene.faces[0].value, end = s.scene.faces[corridor_end_face].value, margin = s.range + 5.0 * s.jitter_m
  loop: blind_by_position() :: for (int k = 0; k < T; k++)
  number: room_spec() :: s.scene = synthetic::shifted(synthetic::box_scene({-3.0, -3.0, 0.0}, {9.0, 3.0, 3.0}, false), synthetic::grid_offset)
  number: room_spec() :: s.y = synthetic::grid_offset.y() + 0.4
  number: room_spec() :: s.z = 1.2 + synthetic::grid_offset.z()
  number: room_spec() :: s.range = 10.0
  number: surge_motion() :: m.surge = 1.0
  number: surge_motion() :: m.omega = 2.0 * 3.14159265358979323846 * 1.5
  value: constexpr double model_accel_noise = 0.01056 / 0.044721359549995794

[case] tests/loop_chains_test.cpp :: loop chain smoke: the corridor's fixture is valid (blindness, injected error retained, no rebuild)
  markers: -
  value: ChainSpec s = corridor_spec(1, model_accel_noise)
  number: s.n_windows = 9
  call: candidate_config()
  number: control.after = 6
  number: injected.along_m = 0.10
  assert: REQUIRE(a.ok)
  assert: REQUIRE(b.ok)
  assert: CHECK(a.map_rebuilds == 0)
  assert: CHECK(b.map_rebuilds == 0)
  assert: CHECK(blind_by_position(s, 7))
  assert: CHECK(blind_by_position(s, 8))
  assert: CHECK_FALSE(blind_by_position(s, 6))
  value: const double retained = read(b.records[7 - 2], s).first_x_error - read(a.records[7 - 2], s).first_x_error
  assert: CHECK(retained == doctest::Approx(0.10).epsilon(1e-6).scale(1.0))
  loop: for (const ChainRun *r : {&a, &b})
  loop: for (int w : {7, 8})
  value: const Reading m = read(r->records[w - 2], s)
  assert: CHECK(m.ndt_along / m.ndt_sideways < 1e-3)
  assert: CHECK(m.ndt_sideways > 0.0)
  assert: CHECK(m.raw_along_share < 0.02)
  assert: CHECK_FALSE(m.at_rest)
  number: MESSAGE("loop chain smoke: retained ", f(retained * 1e3, 3), " mm of 100 mm; ", f(a.seconds + b.seconds, 1), " s")

[case] tests/loop_chains_test.cpp :: loop chain: the blind stretch and its exit (K2), switches off and on, boundary error 0 / 0.10 / 0.24 m
  markers: skip
  value: const ChainSpec s = corridor_spec(1, model_accel_noise)
  value: const int inject_after = 6
  loop: for (int w = 2; w < s.n_windows; w++)
  assert: REQUIRE(!blind.empty())
  assert: CHECK(blind.front() == inject_after + 1)
  value: int exit_window = -1
  loop: for (int w = last_blind + 1; w < s.n_windows && exit_window < 0; w++)
  number: if (s.scene.faces[corridor_end_face].value - s.motion.x(node_tau(w, 0)) <= s.range - 1.0)
  assert: REQUIRE(exit_window > 0)
  number: MESSAGE("corridor: blind windows ", blind.front(), "..", last_blind, " (by position), designated exit window ", exit_window, ", last window ", s.n_windows - 1, "; window duration T = ", f((T - 1) * dt, 3), " s")
  value: double total_seconds = 0.0
  loop: for (const bool switches : {false, true})
  call: candidate_config()
  value: const std::vector<double> errors{0.0, 0.10, 0.24}
  assert: REQUIRE(runs.back().ok)
  assert: CHECK(runs.back().map_rebuilds == 0)
  value: double worst_along_ratio = 0.0, least_sideways = 1e300, worst_raw_share = 0.0
  value: const Reading m = read(r.records[w - 2], s)
  assert: CHECK_FALSE(m.at_rest)
  assert: CHECK(worst_along_ratio < 1e-3)
  assert: CHECK(least_sideways > 0.0)
  assert: CHECK(worst_raw_share < 0.02)
  loop: for (int w = 2; w < s.n_windows; w++)
  value: const Reading m = read(runs[0].records[w - 2], s)
  number: t << " " << w << " | " << (blind_by_position(s, w) ? "blind" : "seen ") << " | " << f(m.end_error * 1e3) << " | " << f(m.end_sigma * 1e3) << " | " << f(m.end_error / m.end_sigma) << " | " << f(m.start_move * 1e3) << " | " << std::setprecision(3) << std::scientific << m.ndt_along / m.ndt_sideways << std::fixed << "\n"
  loop: for (size_t j = 0; j < runs.size(); j++)
  value: const double at_first = read(runs[j].records[inject_after + 1 - 2], s).first_x_error - read(runs[0].records[inject_after + 1 - 2], s).first_x_error
  value: const double at_exit_entry = read(runs[j].records[last_blind + 1 - 2], s).first_x_error - read(runs[0].records[last_blind + 1 - 2], s).first_x_error
  assert: CHECK(at_first == doctest::Approx(e).epsilon(1e-6).scale(1.0))
  value: const bool retained = std::abs(at_exit_entry - e) <= 0.05 * e
  value: const bool matched = runs[j].end_matches[exit_window - 2] >= 20
  number: validity << "e = " << e << ": in window " << inject_after + 1 << " " << f(at_first * 1e3, 3) << " mm, in window " << last_blind + 1 << " " << f(at_exit_entry * 1e3, 3) << " mm" << (retained ? "" : " (NOT retained within 5 %)") << ", exit matches " << runs[j].end_matches[exit_window - 2] << (matched ? "" : " (< 20)") << " -> " << (valid[j] ? "VALID" : "EXCLUDED") << "; "
  value: const Reading c0 = read(runs[0].records[w - 2], s)
  number: t << " " << w << (w == exit_window ? "*" : " ") << " | " << runs[0].end_matches[w - 2] << " / " << runs[1].end_matches[w - 2] << " / " << runs[2].end_matches[w - 2] << " | " << std::scientific << std::setprecision(2) << c0.ndt_along / c0.ndt_sideways << std::fixed
  loop: for (size_t j = 0; j < runs.size(); j++)
  value: const Reading m = read(runs[j].records[w - 2], s)
  number: t << " | e=" << errors[j] << (valid[j] ? "" : " (excl.)") << ": x0 " << f(m.first_x_error * 1e3, 1) << " mm, " << f(m.start_error * 1e3, 1) << ", " << f(m.end_error * 1e3, 1) << ", " << f(m.end_sigma * 1e3, 2) << ", " << f(m.end_error / m.end_sigma, 1)
  number: if (j > 0)
  number: t << " (d " << f((m.start_error - c0.start_error) * 1e3, 1) << " / " << f((m.end_error - c0.end_error) * 1e3, 1) << ")"
  number: t << " (* the designated exit window; hypothesis: a jump near e / T = " << f(0.10 / ((T - 1) * dt) * 1e3, 0) << " / " << f(0.24 / ((T - 1) * dt) * 1e3, 0) << " mm/s, then ringing)"
  number: MESSAGE("blind stretch / K2: 6 chains of 20 windows in ", f(total_seconds, 1), " s")

[case] tests/loop_chains_test.cpp :: loop chain: the blind stretch over seeds, the last blind window's normalised velocity error
  markers: skip
  value: const int M = 20
  value: const truth_stats::PowerPlan plan = truth_stats::runs_for_power(1, 1.5, 0.01, 2)
  loop: for (const bool switches : {false, true})
  call: candidate_config()
  value: double sum = 0.0, seconds = 0.0
  value: int used = 0, last_blind = 0
  loop: for (int seed = 1; seed <= M; seed++)
  value: ChainSpec s = corridor_spec(100 + seed, model_accel_noise)
  number: s.n_windows = 17
  number: last_blind = 0
  loop: for (int w = 2; w < s.n_windows; w++)
  value: const Reading m = read(r.records[last_blind - 2], s)
  value: const auto interval = truth_stats::chi2_interval(used, 0.01 / 2)
  number: MESSAGE(std::string(switches ? "switches ON" : "switches OFF"), ": window ", last_blind, ", M = ", used, " valid runs: sum of normalised errors ", f(sum), " (", f(sum / used), " per run); the 1 % interval (2 comparisons) [", f(interval.first), ", ", f(interval.second), "]; ratios: ", each.str(), "; ", f(seconds, 1), " s")

[case] tests/loop_chains_test.cpp :: loop chain: K1, the velocity response to a map displaced along travel
  markers: skip
  value: const ChainSpec s = room_spec(surge_motion(1.0), 7)
  value: const double Tw = (T - 1) * dt
  value: double seconds = 0.0
  number: t << "K1, seen room, window 5 (T = " << f(Tw, 3) << " s): setting | shift | v_start, v_end response [mm/s per mm] | " "x T [per T] | claimed sigma: prior / handed-on end [mm/s] | iterations | window 6 v_start response\n"
  loop: for (const bool switches : {false, true})
  call: candidate_config()
  number: base.after = 4
  assert: REQUIRE(control.ok)
  assert: CHECK(control.map_rebuilds == 0)
  value: const Reading c5 = read(control.records[5 - 2], s), c6 = read(control.records[6 - 2], s)
  assert: CHECK(c5.ndt_along > 0.1 * c5.ndt_sideways)
  assert: CHECK_FALSE(c5.at_rest)
  number: t << " " << (switches ? "switches on " : "switches off") << " | 0 (control) | v_start err " << f(c5.start_error * 1e3, 3) << ", v_end err " << f(c5.end_error * 1e3, 3) << " mm/s | | " << f(c5.prior_sigma * 1e3) << " / " << f(c5.end_sigma * 1e3) << " | " << c5.iterations << "\n"
  loop: for (double d_mm : {0.001, 0.1, 1.0, 3.0, 10.0})
  number: inj.map_shift = Eigen::Vector3d(d_mm * 1e-3, 0.0, 0.0)
  assert: REQUIRE(r.ok)
  value: const Reading m5 = read(r.records[5 - 2], s), m6 = read(r.records[6 - 2], s)
  assert: CHECK(m5.first_x_error == c5.first_x_error)
  value: const double ds = (m5.start_error - c5.start_error) / d_mm * 1e3, de = (m5.end_error - c5.end_error) / d_mm * 1e3
  number: t << " " << (switches ? "switches on " : "switches off") << " | " << d_mm << " mm | " << f(ds, 3) << ", " << f(de, 3) << " | " << f(ds * Tw, 2) << ", " << f(de * Tw, 2) << " | " << f(m5.prior_sigma * 1e3) << " / " << f(m5.end_sigma * 1e3) << " | " << m5.iterations << " (last delta " << std::scientific << std::setprecision(2) << m5.delta << std::fixed << ") | " << f((m6.start_error - c6.start_error) / d_mm * 1e3, 3) << " | total dv_start, dv_end " << f((m5.start_error - c5.start_error) * 1e3, 3) << ", " << f((m5.end_error - c5.end_error) * 1e3, 3) << " mm/s\n"
  number: MESSAGE("K1: 6 chains of 5 windows in ", f(seconds, 1), " s")

[case] tests/loop_chains_test.cpp :: loop chain: K11, the gyro bias after a boundary attitude turned by 0.05 deg
  markers: skip
  value: const ChainSpec s = room_spec(surge_motion(1.0), 11)
  call: candidate_config()
  number: base.after = 4
  number: turned.pitch_deg = 0.05
  assert: REQUIRE(control.ok)
  assert: REQUIRE(run.ok)
  assert: CHECK(control.map_rebuilds == 0)
  assert: CHECK(run.map_rebuilds == 0)
  value: const double retained = read(run.records[5 - 2], s).first_pitch_deg - read(control.records[5 - 2], s).first_pitch_deg
  number: MESSAGE("K11: the turn in window 5's prepared first pose ", f(retained, 5), " deg (injected 0.05 deg about body y)")
  assert: CHECK(retained == doctest::Approx(0.05).epsilon(1e-3))
  loop: for (int w = 2; w < s.n_windows; w++)
  value: const Reading a = read(run.records[w - 2], s), b = read(control.records[w - 2], s)
  number: t << " " << w << " | " << f(a.bias_deg_s.y(), 5) << ", " << f(b.bias_deg_s.y(), 5) << " | " << f(a.bias_sigma_deg_s.y(), 5) << " | " << f(d.y() / a.bias_sigma_deg_s.y()) << " | " << f(std::abs(d.x()) / a.bias_sigma_deg_s.x()) << ", " << f(std::abs(d.z()) / a.bias_sigma_deg_s.z()) << " | " << f(a.first_pitch_deg, 5) << "\n"
  number: t << " (hypothesis: leaves zero by 3-5 claimed sigmas; " << f(control.seconds + run.seconds, 1) << " s)"

[case] tests/loop_chains_test.cpp :: loop chain: F2, the start velocity's move under constant acceleration, tail 15 and tail 0
  markers: skip
  number: motion.v0 = 0.3
  number: motion.accel = 2.0
  value: const ChainSpec s = room_spec(motion, 7)
  loop: for (int tail : {15, 0})
  call: candidate_config()
  assert: REQUIRE(runs.back().ok)
  assert: CHECK(runs.back().map_rebuilds == 0)
  loop: for (int w = 2; w < s.n_windows; w++)
  number: t << " " << w << " | " << f(s.motion.v(node_tau(w, 0)), 3)
  value: const Reading m = read(r.records[w - 2], s)
  assert: CHECK_FALSE(m.at_rest)
  number: t << " | " << f(m.start_move * 1e3, 2) << ", " << f(m.prior_mean_error * 1e3, 2) << ", " << f(m.start_error * 1e3, 2) << ", " << f(m.end_error * 1e3, 2) << ", " << f(m.first_x_error * 1e3, 3)
  number: t << " (hypothesis: +17-19 mm/s start move, a fitted hypothesis; " << f(runs[0].seconds + runs[1].seconds, 1) << " s)"

