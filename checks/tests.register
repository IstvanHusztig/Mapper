[case] tests/loop_fine_time_test.cpp :: loop fine time corridor: an error inside the blind stretch is taken out where jambs are seen, nothing moves outside
  markers: -
  call: build_corridor(c, {3.0, 6.5, 9.0, 13.0, 17.0}, nullptr, bump)
  call: step(c, windows)
  assert: REQUIRE(report.runs.size() == 1)
  value: const LoopFineTimeRunReport &r = report.runs[0]
  assert: CHECK(r.run.first_window == 13)
  assert: CHECK(r.run.last_window == 27)
  assert: CHECK(r.run.support_first == 7)
  assert: CHECK(r.run.support_last == 33)
  assert: CHECK(r.status == "applied")
  assert: CHECK(r.curves.grid.size() == 93)
  assert: CHECK(r.curves.reference_patches == 1186)
  assert: CHECK(std::all_of(r.supported.begin(), r.supported.end(), [](char s) { return s != 0; }))
  assert: CHECK(steps_of(r) == std::vector<int>{0, 0, 0, 0, 0, 0, 0, -2, -4, -5, -7, -8, -10, -11, -11, -9, -8, -6, -4, -3, -1, 0, 0, 0, 0, 0, 0})
  assert: CHECK(r.held_out_before == 0.1024737731481481)
  assert: CHECK(r.held_out_after == 0.0038317068923227854)
  assert: CHECK(r.held_out_after < r.held_out_before)
  assert: CHECK(before > 1.0)
  assert: CHECK(after <= 0.1 + 1e-9)
  assert: CHECK(a.matrix() == b.matrix())
  assert: CHECK(a.linear() == b.linear())
  assert: CHECK(a.translation().y() == b.translation().y())
  assert: CHECK(a.translation().z() == b.translation().z())
  assert: CHECK(windows[w].motion_model_poses.back().matrix() == windows[w].poses.back().matrix())

[case] tests/loop_fine_time_test.cpp :: loop fine time corridor: a right trajectory stays, bit for bit
  markers: -
