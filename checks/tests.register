[case] tests/window_terms_test.cpp :: window terms: the layout of the unknowns
  markers: -
  value: const Window w = straight_window(20, 0.002)
  assert: [poses only] CHECK(u.n_nodes == 20)
  assert: [poses only] CHECK(u.n_pose_params == 120)
  assert: [poses only] CHECK(u.n_params == 120)
  assert: [poses only] CHECK(u.pose_band_offset == 17)
  assert: [poses only] CHECK(u.anchors.empty())
  value: [gyro bias and the accelerometer term] std::vector<Eigen::Vector3d> acc(20, Eigen::Vector3d(0.0, 0.0, 1.0))
  number: imu.span_s = 0.005
  assert: [gyro bias and the accelerometer term] CHECK(u.n_params == 120 + 3 + 9)
  assert: [gyro bias and the accelerometer term] CHECK(u.ib == 120)
  assert: [gyro bias and the accelerometer term] CHECK(u.io == 123)
  assert: [gyro bias and the accelerometer term] CHECK(u.iv == 126)
  assert: [gyro bias and the accelerometer term] CHECK(u.ie == 129)
  assert: [gyro bias and the accelerometer term] REQUIRE(u.anchors.size() >= 3)
  assert: [gyro bias and the accelerometer term] CHECK(u.anchors[0] == 0)
  assert: [gyro bias and the accelerometer term] CHECK(u.anchors[1] == 3)
  assert: [gyro bias and the accelerometer term] CHECK(u.pose_band_offset == 6 * 6 + 5)
  value: [without timestamps there is no bias and no accelerometer term] std::vector<Eigen::Vector3d> acc(20, Eigen::Vector3d(0.0, 0.0, 1.0))
  assert: [without timestamps there is no bias and no accelerometer term] CHECK_FALSE(u.estimate_bias)
  assert: [without timestamps there is no bias and no accelerometer term] CHECK_FALSE(u.acc_term)
  assert: [without timestamps there is no bias and no accelerometer term] CHECK(u.n_params == 120)

