[case] tests/ndt_map_test.cpp :: ndt_cell_index: every cell has the same width, also the cells through 0
  markers: -
  value: const Eigen::Vector3d b(0.15, 0.15, 0.15)
  assert: CHECK(cell(-0.01, 0.05, 0.05) != cell(0.01, 0.05, 0.05))
  assert: CHECK(cell(0.05, -0.01, 0.05) != cell(0.05, 0.01, 0.05))
  assert: CHECK(cell(0.05, 0.05, -0.01) != cell(0.05, 0.05, 0.01))
  assert: CHECK(cell(-0.01, 0.05, 0.05) == cell(-0.14, 0.05, 0.05))
  assert: CHECK(cell(-0.16, 0.05, 0.05) != cell(-0.14, 0.05, 0.05))
  assert: CHECK(cell(0.01, 0.05, 0.05) == cell(0.14, 0.05, 0.05))

