  assert: CHECK(loop_try_name(tries[1]) == "12-40")
  assert: CHECK(!parse_loop_try_names("3-17,x", tries, why))
  assert: CHECK(why.find("'x'") != std::string::npos)
  assert: CHECK(!parse_loop_try_names("3:17", tries, why))
  assert: CHECK(!parse_loop_try_names("3-17-2", tries, why))
  assert: CHECK(!parse_loop_try_names("", tries, why))

[case] tests/loop_closure_test.cpp :: loop closure time support: an edge whose information lies late in its segment is read where its information is
  markers: -
  value: const LoopEdgeTimeSupport s = loop_edge_time_support(blocks({0, 0, 0, 0, 0, 300}), x, x, I, I, late.first_before, late.first_after, late.before, late.after)
  assert: CHECK(s.first_pose_residual_m == doctest::Approx(1.0).epsilon(1e-12))
  assert: REQUIRE(s.along_axis)
  assert: CHECK(std::abs(s.residual_m) < 1e-12)
  assert: REQUIRE(s.shares.size() == 6)
  assert: CHECK(s.shares[5] == 1.0)
  value: const LoopEdgeTimeSupport half = loop_edge_time_support(blocks({150, 0, 0, 0, 0, 150}), x, x, I, I, late.first_before, late.first_after, late.before, late.after)
  assert: CHECK(half.residual_m == doctest::Approx(0.5).epsilon(1e-12))
  assert: CHECK(half.shares[0] == doctest::Approx(0.5))
  assert: CHECK(half.shares[1] == 0.0)
  number: K.translate(Eigen::Vector3d(0.3, 0.0, 0.0))
  number: C.translate(Eigen::Vector3d(-0.1, 0.0, 0.0))
  value: const LoopEdgeTimeSupport moved = loop_edge_time_support(blocks({150, 0, 0, 0, 0, 150}), x, x, K, C, late.first_before, late.first_after, late.before, late.after)
  assert: CHECK(moved.first_pose_residual_m == doctest::Approx(0.8))
  assert: CHECK(moved.residual_m == doctest::Approx(0.3))
  value: const LoopEdgeTimeSupport turned = loop_edge_time_support(blocks({150, 0, 0, 0, 0, 150}), x, y, I, I, late.first_before, late.first_after, late.before, late.after)
  assert: CHECK(turned.shares[0] == doctest::Approx(0.5))
  assert: CHECK(turned.first_pose_residual_m == 0.0)
  assert: CHECK(turned.residual_m == 0.0)
  value: const LoopEdgeTimeSupport none = loop_edge_time_support(blocks({0, 0, 0, 0, 0, 0}), x, x, I, I, late.first_before, late.first_after, late.before, late.after)
  assert: CHECK(!none.along_axis)
  assert: CHECK(std::isnan(none.residual_m))
  assert: CHECK(none.shares.empty())
  assert: CHECK(none.first_pose_residual_m == doctest::Approx(1.0))
  assert: CHECK(!loop_edge_time_support({}, x, x, I, I, late.first_before, late.first_after, {}, {}).along_axis)

[case] tests/loop_closure_test.cpp :: loop closure time support: every kept edge with a source window in a weak run is read along the run's axis; a report only
  markers: -
