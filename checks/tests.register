  assert: CHECK_FALSE(mean_rotation_rate(poses, std::vector<std::pair<double, double>>(poses.size(), {5.0, 0.0})))

[case] tests/window_noise_model_test.cpp :: window term table: world-frame acceleration at the window's start
  markers: -
  value: const Eigen::Vector3d gravity(0.0, 0.0, 1.02)
  value: const double to_mps2 = 9.80665 / 1.02
  number: turned.linear() = Eigen::AngleAxisd(0.5 * M_PI, Eigen::Vector3d::UnitZ()).toRotationMatrix()
  value: std::vector<Eigen::Affine3d> poses(8, turned)
  loop: for (int k = 0; k < 8; k++)
  number: timestamps.push_back({50.0 + 0.01 * k, 0.0})
  number: acc.push_back(k <= 2 ? Eigen::Vector3d(0.1, 0.0, 1.02) : Eigen::Vector3d(-5.0, 3.0, 0.0))
  value: const std::optional<Eigen::Vector3d> a = start_world_acceleration(poses, timestamps, acc, gravity, 0.025)
  assert: REQUIRE(a)
  assert: CHECK(a->x() == doctest::Approx(0.0).epsilon(1e-12))
  assert: CHECK(a->y() == doctest::Approx(0.1 * to_mps2).epsilon(1e-12))
  assert: CHECK(a->z() == doctest::Approx(0.0).epsilon(1e-12))
  value: const std::optional<Eigen::Vector3d> first = start_world_acceleration(poses, timestamps, acc, gravity, 0.0)
  assert: REQUIRE(first)
  assert: CHECK(first->y() == doctest::Approx(0.1 * to_mps2).epsilon(1e-12))
  number: exact[3].first = exact[0].first + 0.029
  assert: REQUIRE(wider)
  assert: CHECK(wider->y() != doctest::Approx(0.1 * to_mps2))
  assert: CHECK_FALSE(start_world_acceleration(poses, timestamps, {}, gravity))
  assert: CHECK_FALSE(start_world_acceleration(poses, timestamps, acc, Eigen::Vector3d::Zero()))
  assert: CHECK_FALSE(start_world_acceleration({}, {}, {}, gravity))

[file] tests/window_steps_test.cpp
  value: constexpr double dt = 0.01
  default: moving_window() :: defaults of (int n, double speed_mps, double rate_rad_s, const Eigen::Affine3d &origin_pose = Eigen::Affine3d::Identity())
  loop: moving_window() :: for (int k = 0; k < n; k++)
  number: moving_window() :: w.poses.push_back(origin_pose * pose(speed_mps * k * dt, 0.0, 0.0, rate_rad_s * k * dt))
  number: moving_window() :: w.timestamps.push_back({k * dt, 0.0})
  number: add_imu() :: w.imu_acc.assign(w.poses.size(), Eigen::Vector3d::UnitZ() + a_mps2 / 9.80665)
  loop: turning_window() :: for (int k = 0; k < n; k++)
  number: turning_window() :: p.linear() = (Eigen::AngleAxisd(0.01 * k, Eigen::Vector3d::UnitZ()) * Eigen::AngleAxisd(0.003 * k, Eigen::Vector3d::UnitX())).toRotationMatrix()
  number: turning_window() :: p.translation() = Eigen::Vector3d(0.002 * k, 0.0005 * k, 0.0)
  number: turning_window() :: w.timestamps.push_back({1.0 + 0.002 * k, 1.0 + 0.002 * k})
  number: turning_window() :: w.imu_motion_from_previous.linear() = Eigen::AngleAxisd(0.002, Eigen::Vector3d::UnitZ()).toRotationMatrix()

[case] tests/window_steps_test.cpp :: place_window_after starts the window at the given pose and keeps its relative poses
  markers: -
  value: const Window original = moving_window(30, 1.5, 0.3, pose(5.0, -2.0, 1.0, 0.7))
  value: const Eigen::Affine3d start = pose(-1.0, 4.0, 0.5, -0.2)
  assert: REQUIRE(w.poses.size() == original.poses.size())
  assert: CHECK(w.poses[0].isApprox(start, 1e-12))
  loop: for (size_t k = 1; k < w.poses.size(); k++)
  value: const Eigen::Affine3d rel_new = w.poses[k - 1].inverse() * w.poses[k]
  value: const Eigen::Affine3d rel_old = original.poses[k - 1].inverse() * original.poses[k]
  assert: CHECK(rel_new.isApprox(rel_old, 1e-12))

[case] tests/window_steps_test.cpp :: place_windows_after chains the windows from first on, each after its predecessor's end
  markers: -
  loop: for (int i = 0; i < 6; i++)
  number: original.push_back(moving_window(25, 1.0 + 0.2 * i, 0.1 * i, pose(10.0 * i, -3.0 * i, 0.5 * i, 0.4 * i)))
  number: place_windows_after(windows, 2)
  loop: for (size_t i = 0; i < 2; i++)
  loop: for (size_t k = 0; k < windows[i].poses.size(); k++)
  assert: CHECK(windows[i].poses[k].isApprox(original[i].poses[k], 0.0))
  loop: for (size_t i = 2; i < windows.size(); i++)
  assert: CHECK(windows[i].poses[0].isApprox(windows[i - 1].poses.back(), 1e-12))
  loop: for (size_t k = 1; k < windows[i].poses.size(); k++)
  value: const Eigen::Affine3d rel_new = windows[i].poses[k - 1].inverse() * windows[i].poses[k]
  value: const Eigen::Affine3d rel_old = original[i].poses[k - 1].inverse() * original[i].poses[k]
  assert: CHECK(rel_new.isApprox(rel_old, 1e-12))
  loop: [one call matches the old placement of all later windows after every window] for (size_t i = 0; i < repeated.size(); i++)
  loop: [one call matches the old placement of all later windows after every window] for (size_t j = i + 1; j < repeated.size(); j++)
  number: place_window_after(repeated[j], repeated[j - 1].poses.back())
  number: place_windows_after(once, 1)
  loop: [one call matches the old placement of all later windows after every window] for (size_t i = 0; i < once.size(); i++)
  loop: [one call matches the old placement of all later windows after every window] for (size_t k = 0; k < once[i].poses.size(); k++)
  assert: [one call matches the old placement of all later windows after every window] CHECK((once[i].poses[k].matrix() - repeated[i].poses[k].matrix()).cwiseAbs().maxCoeff() < 1e-9)
  loop: [first = 0 and first = size change nothing] for (size_t first : {size_t(0), windows.size()})
  loop: [first = 0 and first = size change nothing] for (size_t i = 0; i < w.size(); i++)
  loop: [first = 0 and first = size change nothing] for (size_t k = 0; k < w[i].poses.size(); k++)
  assert: [first = 0 and first = size change nothing] CHECK(w[i].poses[k].isApprox(original[i].poses[k], 0.0))

[case] tests/window_steps_test.cpp :: estimate_previous_velocity measures the previous window's final velocity
  markers: -
