  loop: for (const int half_width : {17, 113})
  value: const int n_nodes = 40
  value: const int n_pose = n_nodes * 6
  value: std::mt19937 rng(5)
  value: std::uniform_real_distribution<double> value(-1e3, 1e3)
  value: std::uniform_int_distribution<int> any_node(0, n_nodes - 1)
  value: std::uniform_int_distribution<int> any_extra(0, std::max(0, n_extra - 1))
  loop: for (int round = 0; round < 3; round++)
  loop: for (int i = 0; i < 400; i++)
  number: Eigen::Matrix<double, 6, 6, Eigen::RowMajor> block
  loop: for (int r = 0; r < 6; r++)
  loop: for (int c = 0; c < 6; c++)
  loop: for (int r = 0; r < 6; r++)
  loop: for (int c = 0; c < 6; c++)
  number: x.dense(k * 6 + r, k * 6 + c) += block(r, c)
  number: x.written(k * 6 + r, k * 6 + c) = 1
  number: x.band.add_diagonal_block6(k * 6, block)
  loop: for (int k = 1; k < n_nodes; k++)
  loop: for (int r = 0; r < 6; r++)
  loop: for (int c = 0; c < 6; c++)
  number: x.add((k - 1) * 6 + r, (k - 1) * 6 + c, value(rng))
  number: x.add((k - 1) * 6 + r, k * 6 + c, value(rng))
  number: x.add(k * 6 + r, (k - 1) * 6 + c, value(rng))
  number: x.add(k * 6 + r, k * 6 + c, value(rng))
  loop: for (int j = 0; j < n_extra; j++)
  loop: for (int i = 0; i < 100; i++)
  value: const int row = any_node(rng) * 6 + (i % 6)
  loop: for (int k = 0; k < n_extra; k++)
  loop: for (int i = 0; i < 300; i++)
  value: const int a = any_node(rng) * 6 + (i % 3)
  value: const int b = std::clamp(a + (i % 2 ? 1 : -1) * (i % (half_width + 1)), 0, n_pose - 1)
  assert: CHECK(x.band.dropped_writes() == 0)
  call: check_same_as_dense(x, half_width)
  loop: for (int r = 0; r < x.band.size(); r += 7)
  loop: for (int c = 0; c < x.band.size(); c += 5)
  assert: CHECK(reads_equal)

