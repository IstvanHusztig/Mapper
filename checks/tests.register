  assert: CHECK(steps_of(report.runs[0]) == std::vector<int>(27, 0))
  assert: CHECK(report.runs[0].held_out_before == 0.0033834374999999993)
  assert: CHECK(same_bits(windows, c.corrected))

[case] tests/loop_fine_time_test.cpp :: loop fine time corridor: nothing across the passage: not timed, bit for bit unchanged
  markers: -
  call: build_corridor(c, {}, nullptr, bump)
  call: step(c, windows)
